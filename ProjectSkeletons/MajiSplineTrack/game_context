eshes: [mL, mR], tStart: 0, tEnd: 0.9999, midPos: trackCurve.getPointAt(0.5) });\n            } else {\n                // ── Phase 1: Build per-segment rail geometry + metadata ────\n                const segData = []; // [{colorIndex, tStart, tEnd, midPos, lGeo, rGeo, segIdx}]\n                const sharedMats = {};\n                for (let ci = 0; ci < colorPalette.length; ci++) {\n                    sharedMats[ci] = new THREE.MeshStandardMaterial({\n                        color: new THREE.Color(colorPalette[ci]), metalness: 0.3, roughness: 0.3\n                    });\n                }\n\n                for (let si = 0; si < trackSegments.length; si++) {\n                    const seg = trackSegments[si];\n                    if (seg.start >= seg.end || seg.start < 0 || seg.end >= trackRawPositions.length) continue;\n\n                    // Reuse tStart/tEnd already computed in createTrack() — avoid expensive re-lookup\n                    let tStart = seg.tStart;\n                    let tEnd   = seg.tEnd;\n                    if (tStart == null || tEnd == null) {\n                        const posStart = trackRawPositions[seg.start];\n                        const posEnd   = trackRawPositions[Math.min(seg.end, trackRawPositions.length - 1)];\n                        tStart = findClosestTOnTrack(posStart);\n                        tEnd   = findClosestTOnTrack(posEnd);\n                    }\n                    if (tEnd <= tStart) tEnd = Math.min(1, tStart + 0.002);\n                    tStart = Math.max(0, tStart - 0.0005);\n                    tEnd = Math.min(0.9999, tEnd + 0.0005);\n\n                    const segLen = tEnd - tStart;\n                    const segSamples = Math.max(16, Math.round(700 * segLen));\n                    const lPts = [], rPts = [];\n                    for (let i = 0; i <= segSamples; i++) {\n                        const t = tStart + segLen * (i / segSamples);\n                        const {pt, right} = getGameFrame(Math.