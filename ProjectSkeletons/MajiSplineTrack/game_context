apCamera();\n            playSound('background_music',0.25,true);\n            playSound('track_rumble_sound',0.12,true);\n\n            // Show tutorial on first play\n            if (!tutorialShown) {\n                tutorialShown = true;\n                // Find the GO button and highlight it\n                const goBtn = document.querySelector('.btn-accelerate');\n                if (goBtn) goBtn.classList.add('tutorial-highlight');\n\n                const tut = document.createElement('div');\n                tut.className = 'tutorial-overlay';\n                uiOverlay.appendChild(tut);\n\n                // Position hand and text relative to the GO button (added to uiOverlay, not tut, for z-index)\n                const hand = document.createElement('div');\n                hand.className = 'tutorial-hand';\n                hand.textContent = '👆';\n                const txt = document.createElement('div');\n                txt.className = 'tutorial-text';\n                txt.textContent = 'TAP TO GO!';\n\n                uiOverlay.appendChild(hand);\n                uiOverlay.appendChild(txt);\n\n                // Use the GO button's position to place hand and text\n                const positionTutorial = () => {\n                    if (!goBtn) return;\n                    const r = goBtn.getBoundingClientRect();\n                    hand.style.left = (r.left + r.width / 2 - 64) + 'px';\n                    hand.style.top = (r.top + 80) + 'px';\n                    txt.style.left = (r.left + r.width / 2 - 150) + 'px';\n                    txt.style.top = (r.top - 110) + 'px';\n                };\n                positionTutorial();\n\n                // Pause game until player taps\n                gameState = 'tutorial';\n                const dismissTutorial = () => {\n                    tut.classList.add('hidden');\n                    if (goBtn) goBtn.classList.remove('tutorial-highlight');\n                    if (hand.parentNode) hand.parentNode.removeChild(hand);\n                    if (txt.parentNode) txt.parentNode.removeChild(txt);\n                    setTimeout(() => { if (tut.parentNode) tut.parentNode.removeChild(tut); }, 300);\n                    gameState = 'playing';\n                };\n                tut.addEventListener('pointerdown', () => { ensureAudio(); dismissTutorial(); });\n                // Also dismiss if GO button is pressed directly\n                if (goBtn) goBtn.addEventListener('pointerdown', () => { dismissTutorial(); }, { once: true });\n            }\n        }\n\n        async function newGame() {\n            await clearProgress();\n            updateStartScreen();\n            startGame(true);\n        }\n\n        async function finishGame() {\n            gameState='finished'; stopAllSounds(); playSound('completion_fanfare',0.85);\n            const time = elapsedTime;\n            const score = Math.round(100000 / Math.max(0.1, time));\n            let isNewBest = false;\n\n            // Update best time\n            if (savedBestTime === null || time < savedBestTime) {\n                isNewBest = true;\n                savedBestTime = time;\n            }\n            // Save completed state with best time (clear accumulatedTime since run is done)\n            try {\n                await lib.saveUserGameState({\n                    completedStages,\n                    accumulatedTime: 0,\n                    bestTime: savedBestTime\n                });\n            } catch(e) {}\n\n            let lb=null; try { lb=await lib.addPlayerScoreToLeaderboard(score,5); } catch(e) {}\n            showFinishUI(time,isNewBest,lb);\n        }\n\n        function restartGame() {\n            finishScreenEl.classList.add('hidden');\n            startScreenEl.classList.remove('hidden');\n            updateStartScreen();\n            gameState='start'; stopAllSounds();\n        }\n\n        // ── PHYSICS ──────────────────────────────────────────────────────\n        // Mirrors PlayCoasterScript.Update() + adjustSpeed():\n        //   - Look up RCT2 target speed from trackSpeedList at current progress\n        //   - Smoothly adjust toward target (RCT2 physics feel)\n        //   - Player accelerate/brake overrides target by ±ACCEL\n        //   - Gravity still acts on slope (tan.y component)\n        function getRCT2TargetSpeed() {\n            if (!trackSpeedList || trackSpeedList.length < 2) return MAX_SPEED * 0.5;\n            // Map trackProgress [0,1] → speedList index\n            const idx = Math.min(\n                Math.floor(trackProgress * (trackSpeedList.length - 1)),\n                trackSpeedList.length - 1\n            );\n            const next = Math.min(idx + 1, trackSpeedList.length - 1);\n            const frac = (trackProgress * (trackSpeedList.length - 1)) - idx;\n            const rawSpeed = trackSpeedList[idx] * (1 - frac) + trackSpeedList[next] * frac;\n            return Math.max(MIN_SPEED, Math.min(MAX_SPEED, rawSpeed * RCT2_SPEED_SCALE));\n        }\n\n        function updatePhysics(dt) {\n            if (isDerailed) { updateDerailPhysics(dt); return; }\n\n            const t   = Math.max(0, Math.min(trackProgress, 0.9999));\n            const tan = trackCurve.getTangentAt(t);\n\n            // Gravity on slope\n            speed -= tan.y * GRAVITY_SC * (config.gravityStrength || 1.0) * dt;\n\n            // Player controls override (accel capped at ACCEL_MAX_SPEED ~130 km/h)\n            if (isAccel && speed < ACCEL_MAX_SPEED) speed += ACCEL * dt;\n            if (isBrake) speed -= BRAKE_F * dt;\n\n            // Proportional friction (frame-rate independent)\n            speed *= Math.pow(1 - FRICTION, dt * 60);\n\n            // Idle drag: constant deceleration when player is not accelerating\n            if (!isAccel) {\n                const drag = IDLE_DRAG * dt;\n                if (speed > drag) speed -= drag;\n                else if (speed > 0) speed = 0;\n                else if (speed < -drag) speed += drag;\n                else if (speed < 0) speed = 0;\n            }\n\n            // ── Station braking: smooth deceleration for 1.5s when entering a stage ──\n            const STATION_BRAKE_DURATION = 1.0;\n            const STATION_BRAKE_RATE = 1.8;\n            const STATION_TARGET_SPEED = 8;\n            let inStation = false;\n            for (let si = 0; si < trackStages.length; si++) {\n                const st = trackStages[si];\n                if (trackProgress >= st.tStart && trackProgress <= st.tEnd) {\n                    inStation = true;\n                    if (!stationBrakedFlags[si]) {\n                        stationBrakedFlags[si] = true;\n                        stationBrakeTimer = 0;\n                    }\n                    // Only brake during the first 1.5 seconds\n                    if (stationBrakeTimer < STATION_BRAKE_DURATION) {\n                        stationBrakeTimer += dt;\n                        if (Math.abs(speed) > STATION_TARGET_SPEED) {\n                            const target = speed > 0 ? STATION_TARGET_SPEED : -STATION_TARGET_SPEED;\n                            speed += (target - speed) * Math.min(1, STATION_BRAKE_RATE * dt);\n                        }\n                    }\n                    // After 1.5s: player has full control again\n                    break;\n                }\n            }\n            if (!inStation) {\n                for (let si = 0; si < trackStages.length; si++) {\n                    stationBrakedFlags[si] = false;\n                }\n                stationBrakeTimer = 0;\n            }\n\n            speed  = Math.max(-MAX_SPEED, Math.min(MAX_SPEED, speed));\n\n            // Segment derail check\n            updateSegmentDerail(dt);\n\n            trackProgress += (speed / trackLength) * dt;\n\n            // Overspeed UI update\n            updateOverspeedUI();\n            updateSpeedZoneUI();\n            updateSpeedHint();\n            checkStageCheckpoints();\n\n            // Finish detection: last stage center point (if stages exist), otherwise track end\n            const finishT = (trackStages.length > 0)\n                ? trackStages[trackStages.length - 1].t\n                : (trackIsClosed ? null : 1.0);\n\n            if (trackIsClosed) {\n                if (finishT !== null && trackProgress >= finishT && !stageReachedFlags[trackStages.length - 1]) {\n                    // First time reaching last stage on closed loop\n                } else if (trackProgress >= 1.0) {\n                    trackProgress -= 1.0;\n                    lapCount++;\n                    if (lapCount >= LAPS_TO_FINISH) { finishGame(); }\n                }\n                if (trackProgress < 0) trackProgress += 1.0;\n            } else {\n                // Open track: finish at last stage center, or track end if no stages\n                if (finishT !== null && trackProgress >= finishT) { trackProgress = finishT; finishGame(); }\n                else if (finishT === null && trackProgress >= 1.0) { trackProgress = 1.0; finishGame(); }\n                if (trackProgress < 0) { trackProgress = 0; speed = 0; }\n            }\n        }\n\n        // ── Segment derail: per-segment overspeed detection ────────────────────\n        // Shared current-segment lookup (used by derail, speed zone UI, overspeed UI)\n        let _cachedSeg = null;\n        let _cachedSegIdx = -1;\n        let _cachedSegT = -1;\n\n        function getCurrentSegment() {\n            const t = trackProgress;\n\n            // Fast path: still in the same segment as last frame (most common case)\n            if (_cachedSeg) {\n                const a = _cachedSeg.tStart || 0;\n                const b = _cachedSeg.tEnd || 1;\n                if (t >= a && t < b) return { seg: _cachedSeg, idx: _cachedSegIdx };\n            }\n\n            // Check nearby segments first (usually just moved to next one)\n            const lo = Math.max(0, _cachedSegIdx - 1);\n            const hi = Math.min(trackSegments.length - 1, _cachedSegIdx + 3);\n            for (let i = lo; i <= hi; i++) {\n                const s = trackSegments[i];\n                if (t >= (s.tStart || 0) && t < (s.tEnd || 1)) {\n                    _cachedSeg = s; _cachedSegIdx = i;\n                    return { seg: s, idx: i };\n                }\n            }\n\n            // Fallback: full scan\n            for (let i = 0; i < trackSegments.length; i++) {\n                const s = trackSegments[i];\n                if (t >= (s.tStart || 0) && t < (s.tEnd || 1)) {\n                    _cachedSeg = s; _cachedSegIdx = i;\n                    return { seg: s, idx: i };\n                }\n            }\n            _cachedSeg = null; _cachedSegIdx = -1;\n            return { seg: null, idx: -1 };\n        }\n\n        function updateSegmentDerail(dt) {\n            if (trackSegments.length === 0) { segmentOverspeedTime = 0; prevSegmentIdx = -1; return; }\n            const { seg, idx: segIdx } = getCurrentSegment();\n\n            if (segIdx !== prevSegmentIdx) {\n                segmentOverspeedTime = 0;\n                prevSegmentIdx = segIdx;\n            }\n\n            if (!seg || seg.derailSpeed <= 0) { segmentOverspeedTime = 0; return; }\n\n            const speedKmh = speed * 3.6;\n            if (speedKmh > seg.derailSpeed) {\n                segmentOverspeedTime += dt;\n                if (segmentOverspeedTime >= seg.derailDuration) triggerDerail();\n            } else {\n                segmentOverspeedTime = 0;\n            }\n        }\n\n        // ── Overspeed UI (screen glow + warning text) ─────────────────────────\n        let speedZoneActive = false;\n        let speedZoneLastSpeed = 0;\n        let szExitTimer = null;\n        let _szWarnEl = null;\n        let _szNumEl = null;\n\n        function updateSpeedZoneUI() {\n            if (!_szWarnEl) _szWarnEl = document.getElementById('speed-zone-warn');\n            if (!_szWarnEl) return;\n       