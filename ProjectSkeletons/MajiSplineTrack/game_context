        }\n\n        // ── CHARACTER ANIMATION STATE ────────────────────────────────────\n        let prevTangent = null;          // previous frame's tangent for turn detection\n        let smoothTurnRate = 0;          // smoothed turn rate (positive = right turn)\n        let smoothSlopePitch = 0;        // smoothed slope (tangent.y)\n        let armSwingPhaseL = 0;          // accumulated phase for left arm (radians)\n        let armSwingPhaseR = Math.PI * 0.6; // right arm starts offset\n\n        function updateCharacterAnimation(dt) {\n            if (!charRoot || !charArmL || !charArmR || !charHead || !trackCurve) return;\n            const t = Math.max(0, Math.min(trackProgress, 0.9999));\n            const tan = trackCurve.getTangentAt(t).normalize();\n            const speedRatio = Math.abs(speed) / MAX_SPEED;\n\n            // ── Turn detection: cross product of consecutive tangents ──\n            let rawTurn = 0;\n            if (prevTangent) {\n                // cross(prev, cur).y > 0 means turning right\n                rawTurn = (prevTangent.x * tan.z - prevTangent.z * tan.x) * Math.abs(speed) * 2.0;\n            }\n            prevTangent = tan.clone();\n            smoothTurnRate += (rawTurn - smoothTurnRate) * Math.min(1, 4.0 * dt);\n\n            // ── Slope detection ──\n            smoothSlopePitch += (tan.y - smoothSlopePitch) * Math.min(1, 2.0 * dt);\n\n            // ── 1. Body lean into turns (root Z rotation) ──\n            // Lean away from turn direction (centrifugal force feel)\n            const maxLean = 0.26; // ~15 degrees\n            const leanTarget = -THREE.MathUtils.clamp(smoothTurnRate * 0.8, -1, 1) * maxLean;\n            charRoot.rotation.z = THREE.MathUtils.lerp(charRoot.rotation.z, leanTarget, Math.min(1, 4.0 * dt));\n\n            // ── 2. Head looks into the turn ──\n            // Head rotates toward turn direction (curiosity/anticipation)\n            const maxHeadYaw = 0.35; // ~20 degrees\n            const headYa