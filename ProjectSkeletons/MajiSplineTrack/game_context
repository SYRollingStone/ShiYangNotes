ht ? Number(baseRight.dot(prevRight).toFixed(4)) : 1,\n                    railSideDotPrev: prevRailSide ? Number(railSide.dot(prevRailSide).toFixed(4)) : 1,\n                    curvatureDotPrev: Number(curvatureDotPrev.toFixed(4)),\n                    worldDotLoop: Number(worldFrame.up.dot(loopFrame.up).toFixed(4))\n                };\n                trackDebugSamples.push(debugRow);\n\n                // ── DIAG: Detect flips in the loop region during build ──\n                if (DIAG_ENABLED && t >= diagLoopTMin && t <= diagLoopTMax) {\n                    // Log every sample in the loop region\n                    const isFlip = debugRow.upDotPrev < 0.5 || debugRow.rightDotPrev < 0.5 || debugRow.railSideDotPrev < 0.5;\n                    if (isFlip || i % 20 === 0) {\n                        diagLog('FRAME_BUILD', `i=${i} t=${t.toFixed(5)} knotF=${knotF.toFixed(3)} mode=${debugRow.mode} loopW=${loopWeight.toFixed(4)}` +\n                            ` | tan=${diagVec(tan)} up=${diagVec(baseUp)} right=${diagVec(baseRight)}` +\n                            ` | loopUp=${diagVec(loopFrame.up)} worldUp=${diagVec(worldFrame.up)}` +\n                            ` | upDotPrev=${debugRow.upDotPrev} rightDotPrev=${debugRow.rightDotPrev}` +\n                            ` | curvDotPrev=${debugRow.curvatureDotPrev} worldDotLoop=${debugRow.worldDotLoop}` +\n                            (isFlip ? ' *** FLIP DETECTED ***' : ''));\n                    }\n                }\n\n                if (DEBUG_TRACK_FRAMES && (debugRow.upDotPrev < 0.25 || debugRow.rightDotPrev < 0.25 || debugRow.railSideDotPrev < 0.25)) {\n                    console.log('[TrackFrameDebug] possible 180 flip/discontinuity', debugRow);\n                    debugScreenLog('[TrackFrameDebug] possible flip i=' + debugRow.i + ' t=' + debugRow.t + ' mode=' + debugRow.mode + ' upDot=' + debugRow.upDotPrev + ' rightDot=' + debugRow.rightDotPrev);\n                }\n\n                prevRight = baseRight.clone(