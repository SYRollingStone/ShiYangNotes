         const targetDir = targetCamPos.clone().sub(pt);\n                const totalDist = targetDir.length();\n                if (totalDist > 1e-6) targetDir.divideScalar(totalDist);\n\n                // Smooth the direction only (not the distance)\n                if (!smoothCamDir) {\n                    smoothCamDir = targetDir.clone();\n                } else {\n                    smoothCamDir.lerp(targetDir, sm * 1.0);\n                    if (smoothCamDir.lengthSq() > 1e-8) smoothCamDir.normalize();\n                    else smoothCamDir.copy(targetDir);\n                }\n\n                // Place camera at fixed distance along smoothed direction\n                camera.position.copy(pt).addScaledVector(smoothCamDir, totalDist);\n\n                // ── DIAG: Camera position analysis ──\n                if (DIAG_ENABLED && t >= diagLoopTMin && t <= diagLoopTMax) {\n                    const now = performance.now() / 1000;\n                    if (now - diagLastLogTime > DIAG_LOG_INTERVAL) {\n                        diagLastLogTime = now;\n                        // Check if camera is in front of cart (dot of cam-cart with tangent)\n                        const camToCart = pt.clone().sub(camera.position);\n                        const camDotTan = camToCart.dot(tan);\n                        // camDotTan > 0 means cart is in front of camera (correct: camera behind)\n                        // camDotTan < 0 means cart is behind camera (wrong: camera in front)\n                        const camBehind = camDotTan > 0;\n\n                        // Also check smoothCamDir vs -tangent consistency\n                        const idealBehindDir = tan.clone().negate();\n                        const smoothDirDotIdeal = smoothCamDir.dot(idealBehindDir);\n\n                        // Horizontal tangent used for loop mode\n                        const hTan = tan.clone(); hTan.y = 0;\n                        const hTanLen = hTan.length();\n\n                        if (!camBehind) {\n                            diagCamBehindFailCount++;\n                            diagLog('CAM_FRONT', `*** CAMERA IN FRONT OF CART #${diagCamBehindFailCount} *** t=${t.toFixed(5)}` +\n                                ` camDotTan=${camDotTan.toFixed(3)}` +\n                                ` | smoothCamDir=${diagVec(smoothCamDir)} targetDir=${diagVec(targetDir)}` +\n                                ` | smoothDirDotIdeal=${smoothDirDotIdeal.toFixed(4)}` +\n                                ` | loopW=${smoothCamLoopWeight.toFixed(3)} targetLoopW=${targetLoopW.toFixed(3)}` +\n                                ` | hTanLen=${hTanLen.toFixed(4)}` +\n                                ` | tan=${diagVec(tan)} up=${diagVec(up)}` +\n                                ` | camPos=${diagVec(camera.position)} cartPos=${diagVec(pt)}`);\n                        } else {\n                            diagLog('CAM_OK', `t=${t.toFixed(5)} camDotTan=${camDotTan.toFixed(3)}` +\n                                ` loopW=${smoothCamLoopWeight.toFixed(3)}` +\n                                ` smoothDir=${diagVec(smoothCamDir)}` +\n                                ` hTanLen=${hTanLen.toFixed(4)}` +\n                                ` tan=${diagVec(tan)}`);\n                        }\n                    }\n                }\n            } else {\n                if (charHead) charHead.getWorldPosition(camera.position);\n                else { camera.position.copy(pt); camera.position.y+=1.3; }\n                // First person: look forward along track direction\n                const fpLookTarget = camera.position.clone().addScaledVector(tan, 10);\n                cameraLookTarget.lerp(fpLookTarget, sm * 1.5);\n            }\n\n            if (cameraMode === 'third') {\n                // Smooth look-at targeting ahead of cart\n                const lookAhead = 3.0 * (1.0 - smoothCamLoopWeight);\n                const lookTarget = pt.clone().addScaledVector(tan, lookAhead).add(new THREE.Vector3(0, 2.0, 0));\n                cameraLookTarget.lerp(lookTarget, sm * 1.2);\n            }\n            // Subtle pitch-only tilt from slope, no roll\n            const pitch = Math.asin(Math.max(-1, Math.min(1, -tan.y))) * 0.15;\n            camera.up.set(0, 1, 0).applyAxisAngle(new THREE.Vector3(1, 0, 0), pitch);\n            camera.lookAt(cameraLookTarget);\n            if (config.cameraShake && sr>0.48) {\n                const amp=(sr-0.48)*0.14;\n                camera.position.x+=(Math.random()-0.5)*amp;\n                camera.position.y+=(Math.random()-0.5)*amp;\n                camera.position.z+=(Math.random()-0.5)*amp*0.4;\n            }\n        }\n\n        // ── AUDIO UPDATE ─────────────────────────────────────────────────\n        function updateAudio() {\n            const r=speed/MAX_SPEED;\n            const tan=trackCurve.getTangentAt(Math.max(0,Math.min(trackProgress,0.9999)));\n\n            // Whoosh: fade volume instead of stop/start to avoid thrashing\n            const wv=Math.max(0,(r-0.45)*1.8);\n            if (wv>0.01) {\n                if (!activeSounds['coaster_whoosh_sound']) playSound('coaster_whoosh_sound',wv,true);\n                else setVolume('coaster_whoosh_sound',wv);\n            } else {\n                // Fade to 0 instead of stopping — stop only when truly silent\n                if (activeSounds['coaster_whoosh_sound']) {\n                    setVolume('coaster_whoosh_sound', 0);\n                }\n            }\n\n            // Climb sound\n            if (tan.y>0.12&&speed<MAX_SPEED*0.55) {\n                if (!activeSounds['coaster_climb_sound']) playSound('coaster_climb_sound',0.35,true);\n            } else {\n                if (activeSounds['coaster_climb_sound']) {\n                    setVolume('coaster_climb_sound', 0);\n                }\n            }\n\n            setVolume('track_rumble_sound',0.08+r*0.18);\n        }\n\n        // ── STATS OVERLAY (FPS + Draw Calls) ─────────────────────────────\n        let statsEl = null;\n        let statsFps = 0, statsFrames = 0, statsLastTime = performance.now();\n        function initStats() {\n            statsEl = document.createElement('div');\n            statsEl.style.cssText = 'position:absolute;right:8px;bottom:8px;z-index:9999;background:rgba(0,0,0,0.6);color:#0f0;font:12px monospace;padding:4px 8px;border-radius:4px;pointer-events:none;';\n            document.body.appendChild(statsEl);\n        }\n        function updateStats() {\n            statsFrames++;\n            const now = performance.now();\n            if (now - statsLastTime >= 500) {\n                statsFps = Math.round(statsFrames * 1000 / (now - statsLastTime));\n                statsFrames = 0;\n                statsLastTime = now;\n            }\n            if (statsEl) {\n                const info = renderer.info.render;\n                statsEl.textContent = `FPS: ${statsFps}  DC: ${info.calls}  Tri: ${info.triangles}`;\n            }\n        }\n\n        // ── MAIN LOOP ────────────────────────────────────────────────────\n        let lastTs=0, lastDt=0;\n        function animate(ts) {\n            requestAnimationFrame(animate);\n            const dt=Math.min((ts-lastTs)/1000,0.05); lastTs=ts; lastDt=dt; gameTime+=dt;\n            if (gameState==='playing') {\n                updatePhysics(dt); updateCartTransform(); updateTrackConflictVisibility(); updateCamera(dt);\n                updateAudio(); elapsedTime+=dt;\n                drawSpeedLines(speed/MAX_SPEED,gameTime); updateUI();\n            }\n            updatePlanetRotations(dt);\n            updateDistanceCulling();\n            renderer.render(scene,camera);\n            updateStats();\n        }\n\n        // ── INIT ─────────────────────────────────────────────────────────\n        const _loadT0 = performance.now();\n        window._loadLog = [];\n        const _logLoad = (label) => {\n            const msg = `[LOAD] ${label}: ${(performance.now() - _loadT0).toFixed(0)}ms`;\n            console.log(msg);\n            window._loadLog.push(msg);\n            const el = document.querySelector('.loading-text');\n            if (el) el.textContent = label + '...';\n        };\n\n        setLoadingText('Loading...');\n        await nextFrame();\n\n        // Start audio loading in background (no need to wait before rendering)\n        const audioPromise = preloadAssets();\n        _logLoad('Audio started (async)');\n\n        initThreeJS();\n        _logLoad('Three.js init');\n        initStats();\n        createEnvironment();\n        _logLoad('Environment');\n\n        setLoadingText('Building track...');\n        await nextFrame();\n        await createTrack();\n        _logLoad('Track created');\n\n        slCtx=slCanvas.getContext('2d');\n        resizeSpeedCanvas();\n        await loadProgress();\n        _logLoad('Progress loaded');\n\n        if (mode==='edit') {\n            const loadingEl = document.getElementById('loading-screen');\n            if (loadingEl) loadingEl.classList.add('hidden');\n            // ════════════════════════════════════════════════════════════════\n            // TRACK EDITOR — drag-and-drop control points, live preview\n            // ════════════════════════════════════════════════════════════════\n            //\n            // Control points are stored in config.editorPts: [{x,y,z,bank}]\n            // bank: 0=none, 45=left, -45=right  (degrees, same as RCT2 BANK)\n            //\n            // On save: points are serialised to ELEM_FLAT / ELEM_25_DEG_UP / etc.\n            // text and written to config.rct2Track via lib.commitState().\n            //\n            // Camera: left-drag = orbit, right-drag = pan, wheel = zoom.\n            // Click sphere = select.  Del = delete selected.\n            // Double-click ground = add point.\n\n            // ── Init editor control-point list ───────────────────────────\n            if (!Array.isArray(config.editorPts) || config.editorPts.length < 2) {\n                // Default: small oval track in the XZ plane\n                config.editorPts = [\n                    {x:  0,  y: 0,  z:  60, bank: 0},\n                    {x: 40,  y: 0,  z:  40, bank: 0},\n                    {x: 60,  y: 0,  z:   0, bank: 0},\n                    {x: 40,  y: 20, z: -40, bank: 0},\n                    {x:  0,  y: 20, z: -60, bank: 0},\n                    {x:-40,  y: 20, z: -40, bank: 0},\n                    {x:-60,  y: 0,  z:   0, bank: 0},\n                    {x:-40,  y: 0,  z:  40, bank: 0},\n                ];\n                config.editorClosed = true;\n            }\n            if (typeof config.editorClosed !== 'boolean') config.editorClosed = true;\n\n            // ── Scene objects for editor ─────────────────────────────────\n            const ptSpheres = [];   // [{mesh, idx}]\n            const trackGroup = new THREE.Group(); scene.add(trackGroup);\n            let editorCurve = null;\n\n            const MAT_NORMAL = new THREE.MeshStandardMaterial({color:0x00cfff, roughness:0.4, metalness:0.1});\n            const MAT_SEL    = new THREE.MeshStandardMaterial({color:0xffd740, roughness:0.4, metalness:0.1});\n            const MAT_RAIL   = new THREE.MeshStandardMaterial({color:0xdddddd, metalness:0.3, roughness:0.3});\n            const MAT_TIE    = new THREE.MeshStandardMaterial({color:0x8B5E3C, roughness:0.9});\n            const GEO_SPH    = new THREE.SphereGeometry(1.8, 12, 8);\n\n            let selectedIdx = -1;\n\n            // ── Ground grid ──────────────────────────────────────────────\n            const grid = new THREE.GridHelper(400, 40, 0x333333, 0x222222);\n            scene.add(grid);\n\n            // ── Rebuild curve + rail mesh from current editorPts ─────────\n            function rebuildTrack() {\n                trackGroup.clear();\n                ptSpheres.forEach(s => scene.remove(s.mesh));\n                ptSpheres.length = 0;\n\n                const pts = config.editorPts;\n                if (pts.length < 2) return;\n\n                const v3pts = pts.map(p => new THREE.Vector3(p.x, p.y, p.z));\n                editorCurve = createSafeCatmullRomCurve(v3pts, config.editorClosed, 'editorCurve');\n                const len = editorCurve.getLength();\n\n                // Rail preview (simplified: just the curve line)\n                const SEG = 300;\n                const RAIL_OFF = 0.65, RAIL_S = 0.10;\n                const worldUp = new THREE.Vector3(0,1,0);\n                const lPts = [], rPts = [];\n                for (let i = 0; i <= SEG; i++) {\n                    const t   = i / SEG;\n                    const pt  = editorCurve.getPointAt(t);\n                    const tan = editorCurve.getTangentAt(t).normalize();\n                    let up = worldUp.clone().addScaledVector(tan, -worldUp.dot(tan));\n                    if (up.lengthSq() < 1e-6) up.set(1,0,0); else up.normalize();\n                    const right = new THREE.Vector3().crossVectors(up, tan).normalize();\n                    lPts.push(pt.clone().addScaledVector(right,  RAIL_OFF));\n                    rPts.push(pt.clone().addScaledVector(right, -RAIL_OFF));\n                }\n                const LC = createSafeCatmullRomCurve(lPts, config.editorClosed, 'editorLeftRailCurve');\n                const RC = createSafeCatmullRomCurve(rPts, config.editorClosed, 'editorRightRailCurve');\n                const railShape = new THREE.Shape();\n                railShape.moveTo(-RAIL_S,-RAIL_S); railShape.lineTo(RAIL_S,-RAIL_S);\n                railShape.lineTo(RAIL_S,RAIL_S);   railShape.lineTo(-RAIL_S,RAIL_S);\n                railShape.closePath();\n                const mkRail = c => new THREE.Mesh(\n                    new THREE.ExtrudeGeometry(railShape,{steps:300,bevelEnabled:false,extrudePath:c}), MAT_RAIL);\n                trackGroup.add(mkRail(LC)); trackGroup.add(mkRail(RC));\n\n                // Cross-ties\n                const nTies = Math.floor(len / 2.5);\n                for (let i = 0; i < nTies; i++) {\n                    const t   = i / nTies;\n                    const pt  = editorCurve.getPointAt(t);\n                    const tan = editorCurve.getTangentAt(t).normalize();\n                    let up = worldUp.clone().addScaledVector(tan, -worldUp.dot(tan));\n                    if (up.lengthSq() < 1e-6) up.set(1,0,0); else up.normalize();\n                    const right = new THREE.Vector3().crossVectors(up, tan).normalize();\n                    const sz    = new THREE.Vector3().crossVectors(right, up);\n                    const tie   = new THREE.Mesh(new THREE.BoxGeometry(RAIL_OFF*2+0.8,0.18,0.55), MAT_TIE);\n                    tie.position.copy(pt).addScaledVector(up,-(RAIL_S+0.09));\n                    tie.quaternion.setFromRotationMatrix(new THREE.Matrix4().makeBasis(right,up,sz));\n                    trackGroup.add(tie);\n                }\n\n                // Control-point spheres\n                pts.forEach((p, idx) => {\n                    const mesh = new THREE.Mesh(GEO_SPH, idx===selectedIdx ? MAT_SEL.clone() : MAT_NORMAL.clone());\n                    mesh.position.set(p.x, p.y, p.z);\n                    scene.add(mesh);\n                    ptSpheres.push({mesh, idx});\n                });\n\n                // Vertical lines from each point down to ground\n                const lineMat = new THREE.LineBasicMaterial({color:0x446688, transparent:true, opacity:0.5});\n                pts.forEach(p => {\n                    if (p.y <= 0.5) return;\n                    const geo = new THREE.BufferGeometry().setFromPoints([\n                        new THREE.Vector3(p.x, p.y, p.z),\n                        new THREE.Vector3(p.x, 0,   p.z)\n                    ]);\n                    trackGroup.add(new THREE.Line(geo, lineMat));\n                });\n            }\n\n            rebuildTrack();\n\n            // ── Editor UI panel ──────────────────────────────────────────\n            function updateSelUI() {\n                const panel = document.getElementById('editor-panel');\n                if (!panel) return;\n                const pts = config.editorPts;\n                const ptCount = document.getElementById('pt-count');\n                if (ptCount) ptCount.textContent = `${pts.length} POINTS`;\n                const selTitle = document.getElementById('sel-title');\n                const rows = panel.querySelectorAll('.sel-row');\n                const bankSel = panel.querySelector('#bank-sel');\n                if (selectedIdx < 0 || selectedIdx >= pts.length) {\n                    if (selTitle) selTitle.textContent = 'No point selected';\n                    rows.forEach(r=>r.style.opacity='0.3');\n                    return;\n                }\n                rows.forEach(r=>r.style.opacity='1');\n                const p = pts[selectedIdx];\n                if (selTitle) selTitle.textContent = `Point ${selectedIdx}`;\n                const inputs = panel.querySelectorAll('.sel-row input[type=number]');\n                if (inputs[0]) inputs[0].value = p.x;\n                if (inputs[1]) inputs[1].value = p.y;\n                if (inputs[2]) inputs[2].value = p.z;\n                if (bankSel) bankSel.value = p.bank || 0;\n            }\n            function buildEditorUI() {\n                const panel = document.createElement('div');\n                panel.id = 'editor-panel';\n                panel.style.cssText = `\n                    position:absolute; top:12px; right:12px; width:220px;\n                    background:rgba(0,0,0,0.82); border:1px solid rgba(0,220,255,0.3);\n                    border-radius:12px; padding:14px; color:#fff;\n                    font-family:'Orbitron',monospace; font-size:11px;\n                    pointer-events:auto; user-select:none; z-index:300;\n                `;\n\n                function row(label, el) {\n                    const r = document.createElement('div');\n                    r.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;';\n                    const l = document.createElement('span');\n                    l.style.color = 'rgba(255,255,255,0.6)';\n                    l.textContent = label;\n                    r.append(l, el); return r;\n                }\n                function numInput(val, onchange) {\n                    const el = document.createElement('input');\n                    el.type = 'number'; el.value = val;\n                    el.style.cssText = 'width:70px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:4px;color:#fff;padding:2px 4px;font-size:11px;';\n                    el.addEventListener('change', () => onchange(parseFloat(el.value)||0));\n                    return el;\n                }\n\n                // Title\n                const title = document.createElement('div');\n                title.textContent = 'TRACK EDITOR';\n                title.style.cssText = 'font-size:13px;font-weight:700;color:#00dcff;margin-bottom:12px;letter-spacing:2px;text-align:center;';\n                panel.appendChild(title);\n\n                // Track name\n                const nameEl = document.createElement('input');\n                nameEl.type = 'text';\n                nameEl.placeholder = 'Track name...';\n                nameEl.value = config.rct2Name || '';\n                nameEl.style.cssText = 'width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:6px;color:#fff;padding:4px 8px;font-size:11px;margin-bottom:8px;box-sizing:border-box;';\n                nameEl.addEventListener('change', () => { config.rct2Name = nameEl.value; });\n                panel.appendChild(nameEl);\n\n                // Closed toggle\n                const closedWrap = document.createElement('div');\n                closedWrap.style.cssText = 'display:flex;align-items:center;gap:8px;margin-bottom:10px;';\n                const closedChk = document.createElement('input');\n                closedChk.type = 'checkbox'; closedChk.checked = config.editorClosed;\n                closedChk.addEventListener('change', () => {\n                    config.editorClosed = closedChk.checked;\n                    rebuildTrack();\n                });\n                const closedLbl = document.createElement('span');\n                closedLbl.textContent = 'Closed loop';\n                closedLbl.style.color = 'rgba(255,255,255,0.7)';\n                closedWrap.append(closedChk, closedLbl);\n                panel.appendChild(closedWrap);\n\n                // Separator\n                const sep1 = document.createElement('div');\n                sep1.style.cssText = 'border-top:1px solid rgba(255,255,255,0.1);margin:8px 0;';\n                panel.appendChild(sep1);\n\n                // Selected point controls\n                const selTitle = document.createElement('div');\n                selTitle.id = 'sel-title';\n                selTitle.textContent = 'No point selected';\n                selTitle.style.cssText = 'color:rgba(255,255,255,0.5);margin-bottom:8px;';\n                panel.appendChild(selTitle);\n\n                const xRow = row('X', numInput(0, v => { if(selectedIdx<0)return; config.editorPts[selectedIdx].x=v; rebuildTrack(); updateSelUI(); }));\n                const yRow = row('Y (height)', numInput(0, v => { if(selectedIdx<0)return; config.editorPts[selectedIdx].y=v; rebuildTrack(); updateSelUI(); }));\n                const zRow = row('Z', numInput(0, v => { if(selectedIdx<0)return; config.editorPts[selectedIdx].z=v; rebuildTrack(); updateSelUI(); }));\n\n                // Bank selector\n                const bankSel = document.createElement('select');\n                bankSel.style.cssText = 'background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:4px;color:#fff;padding:2px 4px;font-size:11px;';\n                [{v:0,l:'None'},{v:45,l:'Left (+45°)'},{v:-45,l:'Right (-45°)'}].forEach(opt => {\n                    const o = document.createElement('option');\n                    o.value = opt.v; o.textContent = opt.l;\n                    bankSel.appendChild(o);\n                });\n                bankSel.addEventListener('change', () => {\n                    if(selectedIdx<0)return;\n                    config.editorPts[selectedIdx].bank = parseInt(bankSel.value);\n                    rebuildTrack();\n                });\n                const bankRow = row('Bank', bankSel);\n\n                [xRow, yRow, zRow, bankRow].forEach(r => panel.appendChild(r));\n\n                // Delete button\n                const delBtn = document.createElement('button');\n                delBtn.textContent = 'DELETE POINT';\n                delBtn.style.cssText = 'width:100%;margin-top:4px;padding:6px;background:rgba(200,40,40,0.5);border:1px solid rgba(255,80,80,0.4);border-radius:6px;color:#fff;cursor:pointer;font-family:\"Orbitron\",monospace;font-size:10px;letter-spacing:1px;';\n                delBtn.addEventListener('pointerdown', () => {\n                    if(selectedIdx<0 || config.editorPts.length<=2) return;\n                    config.editorPts.splice(selectedIdx,1);\n                    selectedIdx = -1;\n                    rebuildTrack(); updateSelUI();\n                });\n                panel.appendChild(delBtn);\n\n                // Separator\n                const sep2 = document.createElement('div');\n                sep2.style.cssText = 'border-top:1px solid rgba(255,255,255,0.1);margin:10px 0 8px;';\n                panel.appendChild(sep2);\n\n                // Hint\n                const hint = document.createElement('div');\n                hint.style.cssText = 'color:rgba(255,255,255,0.35);font-size:9px;line-height:1.6;margin-bottom:10px;';\n                hint.innerHTML = 'DBL-CLICK ground → add point<br>CLICK sphere → select<br>DRAG sphere → move<br>L-DRAG canvas → orbit<br>R-DRAG → pan  &nbsp; WHEEL → zoom';\n                panel.appendChild(hint);\n\n                // ── Load existing level ────────────────────────────────────\n                const loadWrap = document.createElement('div');\n                loadWrap.style.cssText = 'margin-bottom:10px;';\n                const loadSelect = document.createElement('select');\n                loadSelect.style.cssText = 'width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:6px;color:#fff;padding:4px 8px;font-size:10px;box-sizing:border-box;margin-bottom:4px;';\n                const loadBtn = document.createElement('button');\n                loadBtn.textContent = 'LOAD';\n                loadBtn.style.cssText = 'width:100%;padding:6px;background:rgba(0,180,255,0.3);border:1px solid rgba(0,180,255,0.5);border-radius:6px;color:#fff;cursor:pointer;font-family:\"Orbitron\",monospace;font-size:10px;letter-spacing:1px;';\n\n                // Populate dropdown with available levels\n                Object.keys(TRACK_CATALOG).forEach(name => {\n                    const opt = document.createElement('option');\n                    opt.value = name; opt.textContent = name;\n                    loadSelect.appendChild(opt);\n                });\n\n                loadBtn.addEventListener('pointerdown', async () => {\n                    const name = loadSelect.value;\n                    if (!name) return;\n                    const filename = TRACK_CATALOG[name];\n                    if (!filename) return;\n                    try {\n                        const res = await fetch('Levels/' + filename);\n                        if (!res.ok) return;\n                        const levelData = await res.json();\n                        // Parse RCT2 text back to control points\n                        const { pts, bankAngles } = parseRCT2TrackData(levelData.track);\n                        if (pts.length < 2) return;\n                        config.editorPts = pts.map((v, i) => ({\n                            x: v.x, y: v.y, z: v.z,\n                            bank: bankAngles[i] || 0\n                        }));\n                        config.editorClosed = levelData.closed === true;\n                        nameEl.value = levelData.name || name;\n                        config.rct2Name = levelData.name || name;\n                        closedChk.checked = config.editorClosed;\n                        selectedIdx = -1;\n                        rebuildTrack();\n                        updateSelUI();\n                        loadBtn.textContent = 'LOADED: ' + name;\n                        setTimeout(() => { loadBtn.textContent = 'LOAD'; }, 1500);\n                    } catch(e) { console.warn('Load level failed:', e); }\n                });\n                loadWrap.appendChild(loadSelect);\n                loadWrap.appendChild(loadBtn);\n                panel.appendChild(loadWrap);\n\n                // Separator\n                const sepLoad = document.createElement('div');\n                sepLoad.style.cssText = 'border-top:1px solid rgba(255,255,255,0.1);margin:10px 0 8px;';\n                panel.appendChild(sepLoad);\n\n                // Save button\n                const saveBtn = document.createElement('button');\n                saveBtn.textContent = 'SAVE & PLAY';\n                saveBtn.style.cssText = 'width:100%;padding:10px;background:linear-gradient(160deg,#00c853,#1b5e20);border:none;border-radius:8px;color:#fff;cursor:pointer;font-family:\"Orbitron\",monospace;font-size:12px;font-weight:700;letter-spacing:1px;';\n                saveBtn.onclick = () => { saveTrack(); return false; };\n                saveBtn.setAttribute('data-test', 'save-play-btn');\n                panel.appendChild(saveBtn);\n\n                uiOverlay.appendChild(panel);\n\n                // point-count indicator\n                const ptCountEl = document.createElement('div');\n                ptCountEl.id = 'pt-count';\n                ptCountEl.style.cssText = 'position:absolute;bottom:16px;left:50%;transform:translateX(-50%);font-family:\"Orbitron\",monospace;font-size:11px;color:rgba(0,220,255,0.7);pointer-events:none;';\n                uiOverlay.appendChild(ptCountEl);\n            }\n\n            buildEditorUI();\n            updateSelUI();\n\n            // ── Save: convert control points → ELEM_ text ────────────────\n            // We use a simple approach: each control point becomes an ELEM_FLAT\n            // with slope/bank derived from the point's bank value and the slope\n            // to the next point.  Coordinates are stored in RCT2 grid units\n            // (x/20, y/5, z/20) and the format is the V2 .txt format.\n            async function saveTrack() {\n                const btn = document.querySelector('#editor-panel button:last-child');\n                if (btn) btn.textContent = 'SAVING...';\n                console.log('[saveTrack] Starting...');\n\n                const pts = config.editorPts;\n                if (!Array.isArray(pts) || pts.length < 2) {\n                    console.warn('[saveTrack] No valid control points');\n                    return;\n                }\n\n                try {\n                const lines = [];\n\n                pts.forEach((p, i) => {\n                    const cx = p.x;\n                    const cy = p.y;\n                    const cz = p.z;\n\n                    // Determine slope type from Y difference to next point\n                    const next = pts[(i+1) % pts.length];\n                    const dy = next.y - p.y;\n                    let slopeStart = 'TRACK_SLOPE_NONE';\n                    if (dy > 1.5)  slopeStart = 'TRACK_SLOPE_UP_25';\n                    if (dy < -1.5) slopeStart = 'TRACK_SLOPE_DOWN_25';\n\n                    // Bank\n                    const bank = p.bank || 0;\n                    const bankStr = bank > 0 ? 'TRACK_BANK_LEFT' : bank < 0 ? 'TRACK_BANK_RIGHT' : 'TRACK_BANK_NONE';\n\n                    // Element type\n                    let elemType = 'ELEM_FLAT';\n                    if (i === 0)              elemType = 'ELEM_BEGIN_STATION';\n                    else if (i === pts.length-1 && !config.editorClosed) elemType = 'ELEM_END_STATION';\n                    else if (slopeStart === 'TRACK_SLOPE_UP_25')   elemType = 'ELEM_25_DEG_UP';\n                    else if (slopeStart === 'TRACK_SLOPE_DOWN_25') elemType = 'ELEM_25_DEG_DOWN';\n\n                    // file format: TYPE <x, z, y>  CLASS, slopeS, slopeE, bankS, bankE  speed lat vert\n                    lines.push(`${elemType} <${cx}, ${cz}, ${cy}> TRACK_FLAT, ${slopeStart}, ${slopeStart}, ${bankStr}, ${bankStr} 10 0 99`);\n                });\n\n                const trackText = lines.join('\\n');\n                config.rct2Track  = trackText;\n                config.rct2Closed = config.editorClosed;\n                config.rct2Name   = document.getElementById('editor-panel').querySelector('input[type=text]').value || 'Custom Track';\n\n                // Build level data for Levels/ folder\n                const levelData = {\n                    name: config.rct2Name,\n                    closed: config.editorClosed,\n                    track: trackText,\n                    createdAt: new Date().toISOString()\n                };\n                const safeName = config.rct2Name.replace(/[^a-zA-Z0-9_-]/g, '_');\n\n                // Flash save button color\n                if (btn) btn.style.background = 'rgba(0,180,255,0.6)';\n\n                // Helper: trigger browser download (must append to DOM first)\n                function downloadFile(filename, content) {\n                    const blob = new Blob([content], { type: 'application/json' });\n                    const url = URL.createObjectURL(blob);\n                    const a = document.createElement('a');\n                    a.href = url;\n                    a.download = filename;\n                    a.style.display = 'none';\n                    document.body.appendChild(a);\n                    a.click();\n                    document.body.removeChild(a);\n                    URL.revokeObjectURL(url);\n                }\n\n                // Try server save; if unavailable, download file directly\n                let savedToServer = false;\n                try {\n                    const res = await fetch('/save_level', {\n                        method: 'POST',\n                        headers: { 'Content-Type': 'application/json' },\n                        body: JSON.stringify({ path: 'Levels/' + safeName + '.json', data: levelData })\n                    });\n                    savedToServer = res.ok;\n                } catch(e) { /* network error, will download */ }\n                if (!savedToServer) {\n                    downloadFile(safeName + '.json', JSON.stringify(levelData, null, 2));\n                }\n\n                let configSaved = false;\n                try {\n                    const res = await fetch('/save_config', {\n                        method: 'POST',\n                        headers: { 'Content-Type': 'application/json' },\n                        body: JSON.stringify({ path: 'CoasterRush/game_config.json', config: config })\n                    });\n                    configSaved = res.ok;\n                } catch(e) { /* network error, will download */ }\n                if (!configSaved) {\n                    downloadFile('game_config.json', JSON.stringify(config, null, 2));\n                }\n\n                // Done\n                if (btn) { btn.textContent = 'SAVED!'; btn.style.background = 'rgba(0,200,80,0.8)'; }\n                setTimeout(() => { if (btn) { btn.textContent = 'SAVE & PLAY'; btn.style.background = ''; } }, 1500);\n                } catch(e) {\n                    console.error('[saveTrack] Error:', e);\n                    if (btn) { btn.textContent = 'ERROR'; btn.style.background = 'rgba(200,40,40,0.8)'; }\n                }\n            }\n\n            // ── Camera orbit/pan/zoom ────────────────────────────────────\n            const target = new THREE.Vector3(0, 0, 0);\n            camera.position.set(80, 60, 120);\n            const offset = camera.position.clone().sub(target);\n            let distance  = offset.length();\n            let azimuth   = Math.atan2(offset.x, offset.z);\n            let elevation = Math.asin(THREE.MathUtils.clamp(offset.y/distance,-0.99,0.99));\n            const SENS_ROT=0.005, SENS_PAN=0.08, SENS_ZOOM=1.5;\n            let btnL=false, btnR=false;\n            let mouseDownX=0, mouseDownY=0, didDrag=false;\n            let lastX=0, lastY=0;\n            let lastClickTime=0;\n\n            canvas.addEventListener('contextmenu', e=>e.preventDefault());\n            // Block long-press context menu globally (mobile browsers)\n            document.addEventListener('contextmenu', e=>e.preventDefault());\n\n            canvas.addEventListener('pointerdown', e=>{\n                if (e.button===0) btnL=true;\n                if (e.button===2) btnR=true;\n                mouseDownX=e.clientX; mouseDownY=e.clientY; didDrag=false;\n                lastX=e.clientX; lastY=e.clientY;\n            });\n\n            // ── Drag sphere ──────────────────────────────────────────────\n            let draggingSphereIdx = -1;\n            let dragPlane = null;   // THREE.Plane for dragging\n\n            function screenToRay(e) {\n                const rect = canvas.getBoundingClientRect();\n                const mx = ((e.clientX-rect.left)/rect.width)*2-1;\n                const my = -((e.clientY-rect.top)/rect.height)*2+1;\n                const raycaster = new THREE.Raycaster();\n                raycaster.setFromCamera(new THREE.Vector2(mx,my), camera);\n                return raycaster;\n            }\n\n            canvas.addEventListener('pointermove', e=>{\n                const dx = e.clientX-lastX, dy = e.clientY-lastY;\n                lastX=e.clientX; lastY=e.clientY;\n                const moved = Math.abs(e.clientX-mouseDownX)>3||Math.abs(e.clientY-mouseDownY)>3;\n                if (moved) didDrag=true;\n\n                // Drag selected sphere\n                if (btnL && draggingSphereIdx >= 0 && dragPlane) {\n                    const ray = screenToRay(e);\n                    const hit = new THREE.Vector3();\n                    if (ray.ray.intersectPlane(dragPlane, hit)) {\n                        const p = config.editorPts[draggingSphereIdx];\n                        // Horizontal drag: XZ plane\n                        if (dragPlane.normal.y > 0.5) {\n                            p.x = Math.round(hit.x);\n                            p.z = Math.round(hit.z);\n                        } else {\n                            // Vertical drag: Y axis\n                            p.y = Math.max(0, Math.round(hit.y));\n                        }\n                        rebuildTrack();\n                    }\n                    return;\n                }\n\n                if (btnL && didDrag && draggingSphereIdx<0) {\n                    azimuth   -= dx*SENS_ROT;\n                    elevation += dy*SENS_ROT;\n                    elevation  = THREE.MathUtils.clamp(elevation,-1.4,1.4);\n                }\n                if (btnR && didDrag) {\n                    const fwd   = target.clone().sub(camera.position).normalize();\n                    const right = new THREE.Vector3().crossVectors(fwd,camera.up).normalize();\n                    const up2   = new THREE.Vector3().crossVectors(right,fwd).normalize();\n                    target.addScaledVector(right,-dx*SENS_PAN).addScaledVector(up2,dy*SENS_PAN);\n                }\n            });\n\n            canvas.addEventListener('pointerup', e=>{\n                if (e.button===0) btnL=false;\n                if (e.button===2) btnR=false;\n                draggingSphereIdx=-1; dragPlane=null;\n\n                if (!didDrag) {\n                    const now = performance.now();\n                    const ray = screenToRay(e);\n\n                    // Check sphere hit\n                    const meshes = ptSpheres.map(s=>s.mesh);\n                    const hits   = ray.intersectObjects(meshes, false);\n                    if (hits.length>0) {\n                        const info = ptSpheres.find(s=>s.mesh===hits[0].object);\n                        if (info) {\n                            selectedIdx = info.idx;\n                            rebuildTrack();\n                            return;\n                        }\n                    }\n\n                    // Double-click ground → add point\n                    const isDbl = (now-lastClickTime)<350;\n                    lastClickTime=now;\n                    if (isDbl) {\n                        const gndPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);\n                        const hit = new THREE.Vector3();\n                        if (ray.ray.intersectPlane(gndPlane, hit)) {\n                            config.editorPts.push({x:Math.round(hit.x), y:0, z:Math.round(hit.z), bank:0});\n                            selectedIdx = config.editorPts.length-1;\n                            rebuildTrack();\n                        }\n                        return;\n                    }\n\n                    // Single click empty space → deselect\n                    selectedIdx=-1;\n                    rebuildTrack();\n                }\n            });\n\n            // Start drag on sphere pointerdown\n            canvas.addEventListener('pointerdown', e=>{\n                if (e.button!==0) return;\n                const ray = screenToRay(e);\n                const meshes = ptSpheres.map(s=>s.mesh);\n                const hits   = ray.intersectObjects(meshes, false);\n                if (hits.length>0) {\n                    const info = ptSpheres.find(s=>s.mesh===hits[0].object);\n                    if (info) {\n                        draggingSphereIdx = info.idx;\n                        selectedIdx       = info.idx;\n                        // Drag on XZ plane at point's height\n                        const p = config.editorPts[info.idx];\n                        dragPlane = new THREE.Plane(new THREE.Vector3(0,1,0), -p.y);\n                        rebuildTrack();\n                    }\n                }\n            });\n\n            canvas.addEventListener('wheel', e=>{\n                distance += e.deltaY*0.02*SENS_ZOOM;\n                distance  = Math.max(10, Math.min(600, distance));\n            });\n\n            // Keyboard: Del = delete selected, Y = toggle height-drag mode\n            let heightDragMode = false;\n            window.addEventListener('keydown', e=>{\n                if (e.code==='Delete'||e.code==='Backspace') {\n                    if (selectedIdx>=0 && config.editorPts.length>2) {\n                        config.editorPts.splice(selectedIdx,1);\n                        selectedIdx=-1; rebuildTrack();\n                    }\n                    e.preventDefault();\n                }\n                if (e.code==='KeyY' && selectedIdx>=0) {\n                    heightDragMode=!heightDragMode;\n                    // Switch drag plane to vertical (YZ through the point)\n                    if (heightDragMode && selectedIdx>=0) {\n                        const p = config.editorPts[selectedIdx];\n                        const camDir = camera.position.clone().sub(target).normalize();\n                        camDir.y=0; camDir.normalize();\n                        dragPlane = new THREE.Plane(camDir, -(camDir.x*p.x+camDir.z*p.z));\n                    }\n                }\n            });\n\n            // ── Edit loop ────────────────────────────────────────────────\n            (function editLoop(ts) {\n                requestAnimationFrame(editLoop);\n                camera.position.set(\n                    target.x + distance*Math.cos(elevation)*Math.sin(azi