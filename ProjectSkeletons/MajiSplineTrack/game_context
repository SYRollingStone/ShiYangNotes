n                        labelEl.classList.remove('level-up');\n                    }, { once: true });\n                }\n            }\n            requestAnimationFrame(animateFly);\n        }\n\n        function showFinishUI(timeVal, isNewBest, leaderboard) {\n            finishTimeEl.textContent=formatTime(timeVal);\n            newBestEl.textContent=isNewBest?'★ NEW BEST TIME! ★':'';\n            if (isNewBest) {\n                newBestEl.style.fontSize = '22px';\n                newBestEl.style.color = '#ffd740';\n                newBestEl.style.textShadow = '0 0 20px rgba(255,215,64,0.8)';\n            } else {\n                newBestEl.style.fontSize = '';\n                newBestEl.style.color = '';\n                newBestEl.style.textShadow = '';\n            }\n            lbEl.innerHTML='';\n            if (leaderboard?.entries) {\n                leaderboard.entries.slice(0,5).forEach((e,i)=>{\n                    const row=document.createElement('div');\n                    row.className='lb-row'+(leaderboard.userRank===i+1?' highlight':'');\n                    const t=e.score>0?formatTime(100000/e.score):'--';\n                    row.innerHTML=`<span class=\"lb-rank\">#${i+1}</span><span class=\"lb-name\">${e.username}</span><span class=\"lb-score\">${t}</span>`;\n                    lbEl.appendChild(row);\n                });\n            }\n            finishScreenEl.classList.remove('hidden');\n\n            // Celebration confetti — multiple bursts\n            spawnConfetti(40);\n            setTimeout(() => spawnConfetti(25), 500);\n        }\n\n        // ── INPUT ────────────────────────────────────────────────────────\n        function setupKeyboard() {\n            window.addEventListener('keydown',e=>{\n                if (e.code==='KeyW'||e.code==='ArrowUp')   {ensureAudio();isAccel=true;}\n                if (e.code==='KeyS'||e.code==='ArrowDown') {ensureAudio();isBrake=true;}\n                if (e.code==='KeyC') {ensureAudio();toggleCamera();}\n            });\n            window.addEventListener('keyup',e=>{\n                if (e.code==='KeyW'||e.code==='ArrowUp')   isAccel=false;\n                if (e.code==='KeyS'||e.code==='ArrowDown') isBrake=false;\n            });\n            // Reset keys when window loses focus to prevent stuck keys\n            window.addEventListener('blur',()=>{\n                isAccel=false; isBrake=false;\n            });\n        }\n        function toggleCamera() {\n            cameraMode=cameraMode==='third'?'first':'third';\n            const lbl=document.getElementById('cam-label');\n            if (lbl) lbl.innerHTML=cameraMode==='third'?'🎥<br>3rd':'🎥<br>1st';\n        }\n\n        // ── GAME FLOW ────────────────────────────────────────────────────\n        // RCT2 tracks are closed loops — no checkpoints, just lap counting.\n        let lapCount = 0;\n        const LAPS_TO_FINISH = config.lapsToFinish || 1;\n\n        let tutorialShown = false;\n\n        function startGame(fromBeginning) {\n            stageReachedFlags = trackStages.map(() => false);\n            stationBrakedFlags = trackStages.map(() => false);\n            clearCrowns();\n            if (fromBeginning) {\n                completedStages = 0;\n                accumulatedTime = 0;\n                // Start at first stage position, or track start if no stages\n                trackProgress = (trackStages.length > 0) ? trackStages[0].t : 0;\n            } else {\n                // Load checkpoint: find t of last reached stage\n                trackProgress = (trackStages.length > 0) ? trackStages[0].t : 0;\n                for (let i = 0; i < trackStages.length; i++) {\n                    if (trackStages[i].stageId <= completedStages) {\n                        stageReachedFlags[i] = true;\n                        trackProgress = Math.max(trackProgress, trackStages[i].t);\n                    }\n                }\n                // Restore crowns for previously completed stages