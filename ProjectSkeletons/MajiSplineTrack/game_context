  "game_code": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Coaster Rush</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body, html { width:100%; height:100%; overflow:hidden; touch-action:none; font-family:'Inter',sans-serif; background:#000; user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; }\n        #game-world { position:relative; width:100%; height:100%; }\n        #game-canvas { display:block; width:100%; height:100%; }\n        #speed-lines { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:50; }\n        .ui-overlay { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:100; }\n\n        .timer { position:absolute; top:20px; left:50%; transform:translateX(-50%); font-family:'Orbitron',monospace; font-size:32px; font-weight:700; color:#fff; text-shadow:0 0 12px rgba(0,200,255,0.8); pointer-events:none; letter-spacing:2px; }\n        .speed-display { position:absolute; top:20px; left:20px; background:rgba(0,0,0,0.55); border:2px solid rgba(0,220,255,0.4); border-radius:18px; padding:15px 24px; pointer-events:none; }\n        .speed-value { font-family:'Orbitron',monospace; font-size:42px; font-weight:700; color:#00dcff; display:block; line-height:1; }\n        .speed-unit { font-size:16px; color:rgba(255,255,255,0.6); text-transform:uppercase; letter-spacing:1px; }\n\n        .stage-indicator { position:absolute; top:80px; left:20px; font-family:'Orbitron',monospace; font-size:14px; font-weight:700; color:rgba(255,255,255,0.7); pointer-events:none; letter-spacing:1px; }\n\n        .stage-progress {\n            position:absolute; left:16px; top:42%; transform:translateY(-50%);\n            width:36px; height:40%; pointer-events:none; z-index:100;\n            display:flex; flex-direction:column; align-items:center;\n        }\n        .stage-progress-label {\n            font-family:'Orbitron',monospace; font-size:16px; font-weight:900;\n            color:#00dcff; letter-spacing:2px; text-align:center;\n            margin-bottom:6px; white-space:nowrap;\n            text-shadow:0 0 10px rgba(0,220,255,0.6);\n        }\n        .stage-progress-label.level-up {\n            animation: labelLevelUp 0.8s cubic-bezier(0.17,0.89,0.32,1.2) forwards;\n        }\n        @keyframes labelLevelUp {\n            0%   { transform:scale(1); color:#00dcff; text-shadow:0 0 10px rgba(0,220,255,0.6); }\n            15%  { transform:scale(2.2); color:#ffd740; text-shadow:0 0 30px rgba(255,215,64,1), 0 0 60px rgba(255,180,0,0.6); }\n            40%  { transform:scale(1.8); color:#00ff88; text-shadow:0 0 25px rgba(0,255,136,0.9), 0 0 50px rgba(0,255,136,0.4); }\n            70%  { transform:scale(1.1); color:#00dcff; text-shadow:0 0 15px rgba(0,220,255,0.8); }\n            100% { transform:scale(1); color:#00dcff; text-shadow:0 0 10px rgba(0,220,255,0.6); }\n        }\n        .stage-progress-flag {\n            font-size:22px; margin-bottom:4px;\n            filter:drop-shadow(0 0 4px rgba(255,255,255,0.5));\n        }\n        .stage-progress-track {\n            flex:1; width:8px; background:rgba(255,255,255,0.12);\n            border-radius:4px; position:relative; overflow:visible;\n            border:1px solid rgba(255,255,255,0.08);\n        }\n        .stage-progress-fill {\n            position:absolute; bottom:0; left:0; width:100%;\n            background:linear-gradient(0deg,#00dcff,#00ff88);\n            border-radius:4px; transition:height 0.15s linear;\n        }\n        .stage-progress-car {\n            position:absolute; left:50%; transform:translateX(-50%);\n            font-size:18px; transition:bottom 0.15s linear;\n            filter:drop-shadow(0 0 6px rgba(255,50,50,0.8));\n        }\n\n        .btn-camera { position:absolute; top:20px; right:20px; width:108px; height:108px; background:linear-gradient(160deg,rgba(0,120,255,0.6),rgba(0,60,180,0.7)); border:3px solid rgba(255,255,255,0.5); border-radius:24px; display:flex; align-items:center; justify-content:center; cursor:pointer; pointer-events:auto; transition:background 0.15s, transform 0.1s; box-shadow:0 4px 16px rgba(0,100,255,0.4), inset 0 1px 0 rgba(255,255,255,0.2); }\n        .btn-camera:active { transform:scale(0.9); background:linear-gradient(160deg,rgba(0,180,255,0.7),rgba(0,100,220,0.8)); }\n        .cam-label { font-family:'Orbitron',monospace; font-size:16px; font-weight:700; color:#fff; text-align:center; line-height:1.2; }\n\n        .controls { position:absolute; bottom:40px; left:0; right:0; display:flex; justify-content:space-between; padding:0 28px; pointer-events:none; }\n        .btn-action { width:216px; height:202px; border:none; border-radius:32px; cursor:pointer; pointer-events:auto; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; font-family:'Orbitron',monospace; font-size:17px; font-weight:700; letter-spacing:1px; transition:transform 0.08s, filter 0.08s; user-select:none; -webkit-user-select:none; }\n        .btn-action:active, .btn-action.pressed { transform:scale(0.93); filter:brightness(1.3); }\n        .btn-icon { font-size:48px; line-height:1; }\n        .btn-label { font-size:13px; letter-spacing:2px; opacity:0.85; }\n        .btn-accelerate { background:linear-gradient(160deg,#00c853,#1b5e20); color:#fff; box-shadow:0 4px 24px rgba(0,200,83,0.5), inset 0 1px 0 rgba(255,255,255,0.2); }\n        .btn-brake { background:linear-gradient(160deg,#f44336,#7f0000); color:#fff; box-shadow:0 4px 24px rgba(244,67,54,0.5), inset 0 1px 0 rgba(255,255,255,0.2); }\n\n        /* Toast notification */\n        .stage-toast {\n            position:absolute; top:45%; left:50%;\n            transform:translate(-50%,-50%) scale(0.5);\n            font-family:'Orbitron',monospace; font-weight:900;\n            color:#ffd740; letter-spacing:3px; text-align:center;\n            pointer-events:none; opacity:0; z-index:160;\n            background:radial-gradient(ellipse at center, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 70%);\n            padding:30px 50px; border-radius:20px;\n        }\n        .stage-toast.show {\n            opacity:1;\n            animation: toastPopIn 0.5s cubic-bezier(0.17,0.89,0.32,1.3) forwards;\n        }\n        @keyframes toastPopIn {\n            0%   { transform:translate(-50%,-50%) scale(0.3); opacity:0; filter:blur(8px); }\n            50%  { transform:translate(-50%,-50%) scale(1.1); opacity:1; filter:blur(0); }\n            100% { transform:translate(-50%,-50%) scale(1); opacity:1; filter:blur(0); }\n        }\n        .stage-toast .toast-stage {\n            font-size:48px; display:block; line-height:1.1; white-space:nowrap;\n            text-shadow: 0 0 30px rgba(255,215,64,0.9), 0 0 60px rgba(255,180,0,0.4), 0 4px 0 rgba(180,120,0,0.6);\n        }\n        .stage-toast .toast-progress {\n            font-size:22px; color:rgba(255,255,255,0.7); letter-spacing:3px;\n            margin-top:8px; display:block;\n            text-shadow: 0 0 10px rgba(255,255,255,0.3);\n        }\n        .stage-toast .toast-time {\n            font-size:18px; color:rgba(0,220,255,0.85); letter-spacing:2px;\n            margin-top:6px; display:block;\n            text-shadow: 0 0 12px rgba(0,220,255,0.5);\n        }\n        .stage-toast.final-stage .toast-stage {\n            font-size:64px; color:#00ff88;\n            text-shadow: 0 0 40px rgba(0,255,136,0.9), 0 0 80px rgba(0,255,136,0.4), 0 4px 0 rgba(0,140,60,0.6);\n        }\n        .stage-toast.final-stage .toast-progress { color:rgba(0,255,136,0.8); }\n\n        .start-screen { position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(180deg,rgba(0,0,0,0.65) 0%,rgba(0,0,0,0.92) 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:200; pointer-events:auto; }\n        .start-screen.hidden { display:none; }\n        .game-title { font-family:'Orbitron',monospace; font-size:54px; font-weight:900; color:#00dcff; text-shadow:0 0 24px rgba(0,220,255,0.8),0 0 48px rgba(0,220,255,0.4); letter-spacing:3px; margin-bottom:8px; text-align:center; }\n        .game-subtitle { font-size:18px; color:rgba(255,255,255,0.65); margin-bottom:12px; }\n        .checkpoint-display { font-family:'Orbitron',monospace; font-size:14px; color:#ffd740; margin-bottom:36px; min-height:20px; }\n        .start-buttons { display:flex; flex-direction:column; gap:16px; align-items:center; }\n        .btn-start { padding:22px 72px; font-family:'Orbitron',monospace; font-size:24px; font-weight:700; color:#000; background:linear-gradient(180deg,#00dcff,#0088aa); border:none; border-radius:40px; cursor:pointer; box-shadow:0 0 24px rgba(0,220,255,0.6); transition:transform 0.1s; letter-spacing:2px; }\n        .btn-start:active { transform:scale(0.95); }\n        .btn-new-game { padding:22px 72px; font-family:'Orbitron',monospace; font-size:24px; font-weight:700; color:#000; background:linear-gradient(180deg,#ff6b6b,#c0392b); border:none; border-radius:40px; cursor:pointer; box-shadow:0 0 24px rgba(255,107,107,0.6); transition:transform 0.1s; letter-spacing:2px; }\n        .btn-new-game:active { transform:scale(0.95); }\n        .controls-hint { margin-top:30px; font-size:15px; color:rgba(255,255,255,0.45); text-align:center; line-height:1.8; }\n\n        .finish-screen { position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(180deg,rgba(0,0,0,0.6) 0%,rgba(0,0,0,0.92) 100%); display:flex; flex-direction:column; align-items:center; justify-content:flex-start; padding-top:120px; z-index:200; pointer-events:auto; }\n        .finish-screen.hidden { display:none; }\n        .finish-title { font-family:'Orbitron',monospace; font-size:38px; font-weight:900; color:#00ff88; text-shadow:0 0 20px rgba(0,255,136,0.7); letter-spacing:2px; margin-bottom:12px; }\n        .finish-time-big { font-family:'Orbitron',monospace; font-size:64px; font-weight:700; color:#fff; margin-bottom:4px; }\n        .finish-label { font-size:13px; color:rgba(255,255,255,0.5); letter-spacing:3px; text-transform:uppercase; margin-bottom:8px; }\n        .new-best { font-family:'Orbitron',monospace; font-size:15px; color:#ffd740; margin-bottom:28px; min-height:22px; }\n        .leaderboard { width:90%; max-width:380px; background:rgba(255,255,255,0.06); border-radius:16px; padding:16px; margin-bottom:28px; }\n        .lb-title { font-family:'Orbitron',monospace; font-size:13px; color:rgba(255,255,255,0.5); letter-spacing:2px; text-align:center; margin-bottom:12px; text-transform:uppercase; }\n        .lb-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.07); font-size:15px; color:rgba(255,255,255,0.85); }\n        .lb-row:last-child { border-bottom:none; }\n        .lb-rank { font-family:'Orbitron',monospace; font-size:13px; color:rgba(255,255,255,0.4); width:24px; }\n        .lb-name { flex:1; }\n        .lb-score { font-family:'Orbitron',monospace; font-size:13px; color:#00dcff; }\n        .lb-row.highlight .lb-name, .lb-row.highlight .lb-score { color:#ffd740; }\n        .finish-actions { display:flex; gap:16px; }\n        .btn-play-again { padding:18px 48px; font-family:'Orbitron',monospace; font-size:20px; font-weight:700; color:#000; background:linear-gradient(180deg,#00ff88,#00aa55); border:none; border-radius:32px; cursor:pointer; box-shadow:0 0 20px rgba(0,255,136,0.5); transition:transform 0.1s; }\n        .btn-play-again:active { transform:scale(0.95); }\n\n\n        /* ── Speed Zone Warning ── */\n        .speed-zone-warn {\n            position:absolute; top:18%; left:50%;\n            transform:translate(-50%,-50%) scale(0.3);\n            pointer-events:none; z-index:160;\n            opacity:0;\n            display:flex; flex-direction:column; align-items:center; gap:0;\n            transition: none;\n            will-change: transform, opacity;\n        }\n        .speed-zone-warn.enter {\n            animation: szEnter 0.6s cubic-bezier(0.16,1,0.3,1) forwards;\n        }\n        .speed-zone-warn.idle {\n            opacity:1;\n            transform:translate(-50%,-50%) scale(1);\n            animation: szIdle 2.4s ease-in-out infinite;\n        }\n        .speed-zone-warn.exit {\n            animation: szExit 0.4s ease-in forwards;\n        }\n        @keyframes szEnter {\n            0%   { opacity:0; transform:translate(-50%,-50%) scale(1.8); }\n            60%  { opacity:1; transform:translate(-50%,-50%) scale(0.92); }\n            100% { opacity:1; transform:translate(-50%,-50%) scale(1); }\n        }\n        @keyframes szIdle {\n            0%, 100% { transform:translate(-50%,-50%) scale(1); }\n            50%      { transform:translate(-50%,-50%) scale(1.04); }\n        }\n        @keyframes szExit {\n            0%   { opacity:1; transform:translate(-50%,-50%) scale(1); }\n            100% { opacity:0; transform:translate(-50%,-50%) scale(0.6) translateY(-30px); }\n        }\n        .sz-line-top {\n            font-family:'Orbitron',monospace; font-size:14px; font-weight:700;\n            color:rgba(255,220,180,0.85); letter-spacing:6px; text-transform:uppercase;\n            margin-bottom:2px;\n        }\n        .sz-line-main {\n            font-family:'Orbitron',monospace; font-size:42px; font-weight:900;\n            color:#ffcc80; letter-spacing:3px; line-height:1.1;\n            text-shadow: 0 0 12px rgba(255,80,20,0.7);\n        }\n        .sz-num {\n            font-size:56px;\n            color:#ffd740;\n        }\n        .sz-line-unit {\n            font-family:'Orbitron',monospace; font-size:13px; font-weight:700;\n            color:rgba(255,200,150,0.7); letter-spacing:4px; margin-top:2px;\n        }\n\n        /* ── Overspeed warning UI ── */\n        .overspeed-overlay {\n            position:absolute; top:0; left:0; width:100%; height:100%;\n            pointer-events:none; z-index:150;\n            border:6px solid transparent; border-radius:0;\n            opacity:0; transition: opacity 0.15s;\n            will-change: opacity;\n        }\n        .overspeed-overlay.warn {\n            opacity:1;\n            border-color:rgba(255,200,0,0.5);\n        }\n        .overspeed-text {\n            position:absolute; top:42%; left:50%;\n            transform:translate(-50%,-50%) scale(0.6);\n            font-family:'Orbitron',monospace; font-size:44px; font-weight:900;\n            color:#ff2222;\n            letter-spacing:5px; pointer-events:none;\n            opacity:0; transition:opacity 0.12s, transform 0.12s;\n        }\n        .overspeed-text.show { opacity:1; transform:translate(-50%,-50%) scale(1); }\n\n        /* ── Speed zone tutorial ── */\n        .speed-tutorial {\n            position:absolute; top:40%; left:50%;\n            transform:translate(-50%,-50%) scale(0.5);\n            pointer-events:auto; z-index:260; opacity:0;\n            text-align:center; cursor:pointer;\n            background:radial-gradient(ellipse at center, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 70%);\n            padding:30px 50px; border-radius:20px;\n        }\n        .speed-tutorial.show {\n            animation: toastPopIn 0.5s cubic-bezier(0.17,0.89,0.32,1.3) forwards;\n        }\n        .speed-tutorial-msg {\n            font-family:'Orbitron',monospace; font-size:32px; font-weight:900;\n            color:#ff4444; letter-spacing:2px; line-height:1.4;\n            text-shadow:0 0 20px rgba(255,60,60,0.7), 0 4px 0 rgba(120,0,0,0.5);\n            margin-bottom:20px; white-space:nowrap;\n        }\n        .speed-tutorial-msg strong {\n            color:#ffd740;\n            text-shadow:0 0 20px rgba(255,215,64,0.7), 0 4px 0 rgba(180,120,0,0.5);\n        }\n        .speed-tutorial-tap {\n            font-family:'Orbitron',monospace; font-size:20px; font-weight:700;\n            color:#00dcff; letter-spacing:3px;\n            text-shadow:0 0 15px rgba(0,220,255,0.6);\n            animation: speedTapPulse 1.2s ease-in-out infinite;\n        }\n        @keyframes speedTapPulse {\n            0%, 100% { opacity:0.5; transform:scale(1); }\n            50%      { opacity:1; transform:scale(1.05); }\n        }\n\n        /* ── Loading screen ── */\n        .loading-screen {\n            position:absolute; top:0; left:0; width:100%; height:100%;\n            background:#000; z-index:9999;\n            display:flex; flex-direction:column; align-items:center; justify-content:center;\n        }\n        .loading-screen.hidden { display:none; }\n        .loading-title {\n            font-family:'Orbitron',monospace; font-size:42px; font-weight:900;\n            color:#00dcff; text-shadow:0 0 20px rgba(0,220,255,0.7);\n            letter-spacing:3px; margin-bottom:30px;\n        }\n        .loading-spinner {\n            width:48px; height:48px;\n            border:4px solid rgba(255,255,255,0.15);\n            border-top:4px solid #00dcff;\n            border-radius:50%;\n            animation: spin 0.8s linear infinite;\n            margin-bottom:20px;\n        }\n        @keyframes spin { to { transform:rotate(360deg); } }\n        .loading-text {\n            font-family:'Inter',sans-serif; font-size:14px;\n            color:rgba(255,255,255,0.5); letter-spacing:2px;\n        }\n\n        /* ── Tutorial overlay ── */\n        .tutorial-overlay {\n            position:absolute; top:0; left:0; width:100%; height:100%;\n            background:rgba(0,0,0,0.65); z-index:250;\n            pointer-events:auto;\n        }\n        .tutorial-overlay.hidden { display:none; }\n        .tutorial-hand {\n            position:absolute;\n            font-size:128px;\n            animation: tutorialBounce 1.0s ease-in-out infinite;\n            filter: drop-shadow(0 0 12px rgba(255,255,255,0.6));\n            pointer-events:none;\n            z-index:270;\n        }\n        @keyframes tutorialBounce {\n            0%, 100% { transform:translateY(0); }\n            50% { transform:translateY(-18px); }\n        }\n        .tutorial-text {\n            position:absolute;\n            font-family:'Orbitron',monospace; font-size:40px; font-weight:700;\n            color:#fff; text-align:center; white-space:nowrap;\n            text-shadow:0 0 12px rgba(0,220,255,0.8);\n            letter-spacing:2px;\n            pointer-events:none;\n            z-index:270;\n        }\n        .btn-action.tutorial-highlight {\n            position:relative; z-index:260;\n            animation: tutorialPulse 1.2s ease-in-out infinite;\n        }\n        @keyframes tutorialPulse {\n            0%, 100% { box-shadow:0 0 24px rgba(0,200,83,0.5), inset 0 1px 0 rgba(255,255,255,0.2); }\n            50% { box-shadow:0 0 48px rgba(0,255,100,0.9), 0 0 80px rgba(0,255,100,0.4), inset 0 1px 0 rgba(255,255,255,0.3); }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"loading-screen\" class=\"loading-screen\">\n        <div class=\"loading-title\">COASTER RUSH</div>\n        <div class=\"loading-spinner\"></div>\n        <div class=\"loading-text\">LOADING...</div>\n    </div>\n    <div id=\"game-world\">\n        <canvas id=\"game-canvas\"></canvas>\n        <canvas id=\"speed-lines\"></canvas>\n        <canvas id=\"confetti-canvas\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:140;\"></canvas>\n        <div id=\"ui-overlay\" class=\"ui-overlay\"></div>\n    </div>\n\n    <script type=\"importmap\">\n    {\n        \"imports\": {\n            \"three\": \"https://cdn.jsdelivr.net/npm/three@0.184.0/build/three.module.js\",\n            \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.184.0/examples/jsm/\"\n        }\n    }\n    </script>\n    <script>\n    // Synchronous placeholder: ensures window.run exists before module loads.\n    // The module script below will replace this with the real async run().\n    window.run = function(mode) {\n        // Module not loaded yet — wait and retry\n        var checkInterval = setInterval(function() {\n            if (window._realRun) {\n                clearInterval(checkInterval);\n                window.run = window._realRun;\n                window._realRun(mode);\n            }\n        }, 50);\n    };\n    </script>\n    <script type=\"module\">\n    import * as THREE from 'three';\n\n    const CURRENT_GAME_VERSION = \"20260511155910\";\n    function outputVersion() {\n        console.log(`Game - Version ${CURRENT_GAME_VERSION}`);\n        if (typeof lib !== 'undefined' && lib.log) lib.log(`Game - Version ${CURRENT_GAME_VERSION}`);\n    }\n    outputVersion();\n\n    // ── Loading screen helper ────────────────────────────────────────\n    // Updates the loading text and yields a frame so the browser repaints.\n    function setLoadingText(msg) {\n        const el = document.querySelector('.loading-text');\n        if (el) el.textContent = msg;\n    }\n    function nextFrame() {\n        return new Promise(r => requestAnimationFrame(r));\n    }\n\n    // ══════════════════════════════════════════════════════════════════\n    // DIAGNOSTIC LOGGING for Circle2 loop investigation\n    // All diag logs use [DIAG] prefix for easy filtering in console\n    // ══════════════════════════════════════════════════════════════════\n    const DIAG_ENABLED = false;\n    const DIAG_LOOP_T_MIN = 0.75;   // approximate t-range for Circle2 area (will be refined)\n    const DIAG_LOOP_T_MAX = 0.98;\n    let diagLoopTMin = DIAG_LOOP_T_MIN;  // will be overwritten once actual loop range is known\n    let diagLoopTMax = DIAG_LOOP_T_MAX;\n    let diagFrameCounter = 0;\n    let diagLastLogTime = 0;\n    const DIAG_LOG_INTERVAL = 0.15;  // seconds between runtime logs (avoid spam)\n    let diagPrevCartTan = null;\n    let diagPrevCartUp = null;\n    let diagPrevCartRight = null;\n    let diagPrevCamPos = null;\n    let diagFlipCount = 0;\n    let diagCamBehindFailCount = 0;\n\n    function diagLog(category, msg, data) {\n        if (!DIAG_ENABLED) return;\n        const prefix = `[DIAG][${category}]`;\n        if (data !== undefined) {\n            console.log(prefix, msg, JSON.stringify(data));\n        } else {\n            console.log(prefix, msg);\n        }\n    }\n\n    function diagVec(v, decimals = 4) {\n        if (!v) return 'null';\n        return `(${v.x.toFixed(decimals)}, ${v.y.toFixed(decimals)}, ${v.z.toFixed(decimals)})`;\n    }\n\n    const DEBUG_TRACK_FRAMES = false;\n    const DEBUG_FRAME_TABLE = false;\n    const DEBUG_FRAME_INDEX = -1;\n    const DEBUG_FRAME_EVERY = 10;\n    const DEBUG_FRAME_SCALE = 2.6;\n    const DEBUG_RAIL_OFFSET = 0.65;\n    console.log('[TrackFrameDebug] DIRECT PRINT ENABLED');\n    function debugScreenLog(message) {\n        // Screen overlay disabled — log to console only\n        console.log('[debugScreenLog]', message);\n    }\n\n    async function run(mode) {\n        const canvas    = document.getElementById('game-canvas');\n        const slCanvas  = document.getElementById('speed-lines');\n        const uiOverlay = document.getElementById('ui-overlay');\n        const config    = window.gameConfig || {};\n\n        // ── AUDIO ────────────────────────────────────────────────────────\n        let audioCtx = null;\n        const audioBuffers = {}, activeSounds = {};\n\n        function ensureAudio() {\n            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n            if (audioCtx.state === 'suspended') audioCtx.resume();\n            return audioCtx;\n        }\n        async function loadAudio(id) {\n            const info = lib.getAsset(id);\n            if (!info || info.type !== 'audio') return;\n            try {\n                const res = await fetch(info.url);\n                const ab  = await res.arrayBuffer();\n                // Don't create AudioContext during preload — just store raw arraybuffer\n                // Decode later on first play when AudioContext is guaranteed to be active\n                audioBuffers[id] = { raw: ab, buffer: null, loop: info.loop==='true' };\n            } catch(e) { console.warn('Audio load fail:', id); }\n        }\n        async function decodeIfNeeded(id) {\n            const entry = audioBuffers[id];\n            if (!entry || entry.buffer) return;\n            if (!audioCtx) return;\n            try {\n                entry.buffer = await audioCtx.decodeAudioData(entry.raw.slice(0));\n                entry.raw = null; // free raw data\n            } catch(e) { console.warn('Audio decode fail:', id); }\n        }\n        function playSound(id, vol=1, loop=false) {\n            if (!audioCtx) return;\n            const entry = audioBuffers[id];\n            if (!entry) return;\n            // Lazy decode on first play (AudioContext is now active from user gesture)\n            if (!entry.buffer) {\n                decodeIfNeeded(id).then(() => playSound(id, vol, loop));\n                return;\n            }\n            stopSound(id);\n            const src = audioCtx.createBufferSource();\n            src.buffer = entry.buffer;\n            src.loop   = loop || entry.loop;\n            const gain = audioCtx.createGain();\n            gain.gain.value = Math.max(0, Math.min(1, vol));\n            src.connect(gain); gain.connect(audioCtx.destination);\n            src.start(0);\n            const s = { src, gain };\n            activeSounds[id] = s;\n            src.onended = () => { if (activeSounds[id]===s) delete activeSounds[id]; };\n        }\n        function stopSound(id) {\n            if (!activeSounds[id]) return;\n            try { activeSounds[id].src.stop(); } catch(e) {}\n            delete activeSounds[id];\n        }\n        function setVolume(id, vol) {\n            if (activeSounds[id]) activeSounds[id].gain.gain.value = Math.max(0, Math.min(1, vol));\n        }\n        function stopAllSounds() { Object.keys(activeSounds).forEach(stopSound); }\n        async function preloadAssets() {\n            await Promise.all(['background_music','coaster_whoosh_sound',\n                'coaster_climb_sound','track_rumble_sound','completion_fanfare'].map(loadAudio));\n        }\n\n        // ── THREE.JS ─────────────────────────────────────────────────────\n        let scene, camera, renderer;\n\n        function initThreeJS() {\n            scene    = new THREE.Scene();\n            camera   = new THREE.PerspectiveCamera(65, canvas.clientWidth/canvas.clientHeight, 0.1, 2000);\n            renderer = new THREE.WebGLRenderer({ canvas, antialias:false });\n            renderer.setSize(canvas.clientWidth, canvas.clientHeight);\n            // Auto quality: mobile uses lower resolution for performance\n            const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);\n            const maxPixelRatio = isMobile ? 0.8 : 1.5;\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, maxPixelRatio));\n            renderer.shadowMap.enabled = false;\n            renderer.outputColorSpace   = THREE.SRGBColorSpace;\n            renderer.toneMapping        = THREE.ACESFilmicToneMapping;\n            renderer.toneMappingExposure = 1.35;\n            window.addEventListener('resize', () => {\n                camera.aspect = canvas.clientWidth/canvas.clientHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(canvas.clientWidth, canvas.clientHeight);\n                resizeSpeedCanvas();\n            });\n        }\n\n        // ── ENVIRONMENT ──────────────────────────────────────────────────\n        function createEnvironment() {\n            const skyColor = 0x64B5F6, fogColor = 0x90CAF9, fogNear = 300, fogFar = 850;\n            renderer.setClearColor(skyColor);\n            if (config.fogEnabled!==false) scene.fog = new THREE.Fog(fogColor, fogNear, fogFar);\n            scene.add(new THREE.AmbientLight(0xffffff, 1.1));\n            const sun = new THREE.DirectionalLight(0xffffff, 1.85);\n            sun.position.set(60,120,80);\n            scene.add(sun);\n\n            // ── Gradient sky dome + procedural clouds ──────────\n            {\n                // Gradient sky sphere — bright sky top, white-ish horizon, deeper blue at bottom\n                const skyGeo = new THREE.SphereGeometry(900, 32, 32);\n                const skyMat = new THREE.ShaderMaterial({\n                    side: THREE.BackSide,\n                    depthWrite: false,\n                    fog: false,\n                    uniforms: {\n                        colorTop:     { value: new THREE.Color(0x87CEEB) }, // sky blue (天蓝)\n                        colorMid:     { value: new THREE.Color(0xB0D8F0) }, // light blue horizon\n                        colorBottom:  { value: new THREE.Color(0x0D47A1) }, // deep ocean blue below\n                        midPoint:     { value: 0.45 },\n                    },\n                    vertexShader: `\n                        varying vec3 vWorldPos;\n                        void main() {\n                            vec4 wp = modelMatrix * vec4(position, 1.0);\n                            vWorldPos = wp.xyz;\n                            gl_Position = projectionMatrix * viewMatrix * wp;\n                        }\n                    `,\n                    fragmentShader: `\n                        uniform vec3 colorTop;\n                        uniform vec3 colorMid;\n                        uniform vec3 colorBottom;\n                        uniform float midPoint;\n                        varying vec3 vWorldPos;\n                        void main() {\n                            float h = normalize(vWorldPos).y * 0.5 + 0.5;\n                            vec3 col;\n                            if (h > midPoint) {\n                                col = mix(colorMid, colorTop, smoothstep(midPoint, 1.0, h));\n                            } else {\n                                col = mix(colorBottom, colorMid, smoothstep(0.0, midPoint, h));\n                            }\n                            gl_FragColor = vec4(col, 1.0);\n                        }\n                    `\n                });\n                const skyMesh = new THREE.Mesh(skyGeo, skyMat);\n                skyMesh.renderOrder = -1;\n                scene.add(skyMesh);\n\n                // Procedural cloud puff texture — higher resolution, softer edges\n                function makeCloudPuffTexture() {\n                    const SIZE = 256;\n                    const c = document.createElement('canvas');\n                    c.width = c.height = SIZE;\n                    const ctx = c.getContext('2d');\n                    ctx.clearRect(0, 0, SIZE, SIZE);\n                    const cx = SIZE / 2, cy = SIZE / 2, r = SIZE * 0.46;\n                    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n                    grad.addColorStop(0,    'rgba(255,255,255,1.0)');\n                    grad.addColorStop(0.15, 'rgba(255,255,255,0.95)');\n                    grad.addColorStop(0.4,  'rgba(255,255,255,0.7)');\n                    grad.addColorStop(0.65, 'rgba(255,255,255,0.3)');\n                    grad.addColorStop(0.85, 'rgba(255,255,255,0.08)');\n                    grad.addColorStop(1,    'rgba(255,255,255,0)');\n                    ctx.fillStyle = grad;\n                    ctx.fillRect(0, 0, SIZE, SIZE);\n                    const tex = new THREE.CanvasTexture(c);\n                    tex.premultiplyAlpha = false;\n                    return tex;\n                }\n\n                const puffTex = makeCloudPuffTexture();\n\n                // Cloud system: more clouds, larger, lower in the sky, more puffs per cloud.\n                // 8 opacity levels shared across all sprites to keep DC low.\n                const CLOUD_COUNT = 30;\n                const SKY_R = 840;\n                const cloudOpacityLevels = [0.45, 0.55, 0.65, 0.78, 0.88];\n                const cloudMats = cloudOpacityLevels.map(op => new THREE.SpriteMaterial({\n                    map: puffTex,\n                    transparent: true,\n                    opacity: op,\n                    depthWrite: false,\n                    depthTest: true,\n                    fog: false,\n                }));\n                const cloudGroup = new THREE.Group();\n                cloudGroup.name = 'clouds';\n\n                for (let i = 0; i < CLOUD_COUNT; i++) {\n                    const cloud = new THREE.Group();\n\n                    // Position on sky sphere — elevation 1°~18° (lower, closer to horizon)\n                    const azimuth   = Math.random() * Math.PI * 2;\n                    const elevation = (0.01 + Math.random() * 0.20) * Math.PI * 0.5;\n                    cloud.position.set(\n                        SKY_R * Math.cos(elevation) * Math.cos(azimuth),\n                        SKY_R * Math.sin(elevation),\n                        SKY_R * Math.cos(elevation) * Math.sin(azimuth)\n                    );\n\n                    // Vary cloud types: small wispy (3-5 puffs) vs large fluffy (5-8 puffs)\n                    const isLarge    = Math.random() < 0.4;\n                    const puffCount  = isLarge ? (5 + Math.floor(Math.random() * 4)) : (3 + Math.floor(Math.random() * 3));\n                    const baseSize   = isLarge ? (80 + Math.random() * 100) : (40 + Math.random() * 50);\n                    const spreadX    = isLarge ? 1.2 : 0.9;\n                    const spreadY    = isLarge ? 0.25 : 0.18;\n\n                    for (let p = 0; p < puffCount; p++) {\n                        const mat = cloudMats[Math.floor(Math.random() * cloudMats.length)];\n                        const sprite = new THREE.Sprite(mat);\n                        const s = baseSize * (0.4 + Math.random() * 0.8);\n                        // Flatter aspect ratio for more natural cloud shape\n                        sprite.scale.set(s, s * (0.35 + Math.random() * 0.25), 1);\n                        // Spread horizontally wide, vertically thin\n                        sprite.position.set(\n                            (Math.random() - 0.5) * baseSize * spreadX,\n                            (Math.random() - 0.5) * baseSize * spreadY,\n                            (Math.random() - 0.5) * baseSize * 0.3\n                        );\n                        sprite.renderOrder = 0;\n                        cloud.add(sprite);\n                    }\n\n                    cloudGroup.add(cloud);\n                }\n                scene.add(cloudGroup);\n            }\n        }\n\n        // ════════════════════════════════════════════════════════════════════\n        // RCT2 PROCEDURAL TRACK GENERATION\n        // Ported 1-to-1 from Unity project:\n        //   D:\\GitResps\\RollerCoaster-Simulator\\Assets\\Scripts\\\n        //     FileReaderSpline.cs   → parseRCT2Line(), TRACK_CATALOG\n        //     SplineCreator.cs      → handleTrackUnit(), adjustCoords(), buildSpline(), fixBanks()\n        //     GenerateCoasterExternalities.cs → buildSupports()\n        //     PlayCoasterScript.cs  → cart position/rotation via t∈[0,1] on CatmullRom\n        //\n        // Input format (V2, same as newtest_tracks/*.txt):\n        //   TYPE <x, z, y>  CLASS, SLOPE_START, SLOPE_END, BANK_START, BANK_END  speed latG vertG\n        //   Coordinate scale: ax = cx*20, ay = cy*5, az = cz*20\n        // ════════════════════════════════════════════════════════════════════\n\n        // ── TRACK CATALOG: maps track names → Levels/ JSON files ──────────\n        // Track data is stored in Levels/*.json, loaded on demand.\n        const TRACK_CATALOG = {\n            \"UnityTrack1\": \"UnityTrack1.json\"\n        };\n        let activeTrackName = Object.keys(TRACK_CATALOG)[0];\n\n        // ── parseRCT2Line() ─────────────────────────────────────────────────\n        // Mirrors FileReaderSpline.createTrackV2() exactly.\n        function parseRCT2Line(line) {\n            const parts = line.trim().split(/[\\s,<>]+/).filter(s => s.length > 0);\n            if (parts.length < 12) return null;\n            const fx = parseFloat(parts[1]);\n            const fz = parseFloat(parts[2]);\n            const fy = parseFloat(parts[3]);\n            if (isNaN(fx) || isNaN(fy) || isNaN(fz)) return null;\n            let bank = 'NONE';\n            if (parts[7].includes('LEFT'))  bank = 'LEFT';\n            else if (parts[7].includes('RIGHT')) bank = 'RIGHT';\n            return {\n                trackType: parts[0],\n                cx: fx, cy: fy, cz: fz, bank,\n                speed: parseInt(parts[9]) || 0,\n            };\n        }\n\n        // ── parseRCT2TrackData() ────────────────────────────────────────────\n        // Mirrors SplineCreator.handleTrackUnitObject() + adjustCoordinateValuesV2()\n        //         + createTrackV2() + fixBanks()\n        function parseRCT2TrackData(text) {\n            const rawUnits = [];\n            for (const line of text.split('\\n')) {\n                if (!line.trim()) continue;\n                const u = parseRCT2Line(line);\n                if (u) rawUnits.push(u);\n            }\n            // handleTrackUnitObject(): TURN and LOOP de-duplication\n            const filtered = [];\n            let turnParser = 0, loopParser = 0, pastHeight = null;\n            for (const u of rawUnits) {\n                const isTurn = u.trackType.includes('TURN');\n                const isLoop = u.trackType.includes('LOOP');\n                if (isTurn) {\n                    if (turnParser === 0) {\n                        filtered.push(u);\n                        if      (u.trackType.includes('5')) turnParser = 7;\n                        else if (u.trackType.includes('3')) turnParser = 4;\n                        else                                turnParser = 0;\n                    } else if (turnParser === 1) { filtered.push(u); turnParser--; }\n                    else { turnParser--; }\n                } else if (isLoop) {\n                    if (pastHeight !== null && pastHeight === u.cy) {\n                        if (loopParser % 2 === 0) { if (filtered.length > 0) filtered.pop(); }\n                        else { filtered.push(u); }\n                        loopParser++;\n                    } else { filtered.push(u); }\n                    pastHeight = u.cy; turnParser = 0;\n                } else {\n                    loopParser = 0; turnParser = 0; pastHeight = null;\n                    filtered.push(u);\n                }\n            }\n            // de-dup by exact (cx,cy,cz) — no scaling, coords are world units\n            const kept = [];\n            let lastCx = null, lastCy = null, lastCz = null;\n            for (const u of filtered) {\n                if (u.cx === lastCx && u.cy === lastCy && u.cz === lastCz) continue;\n                lastCx = u.cx; lastCy = u.cy; lastCz = u.cz;\n                kept.push({ ...u, ax: u.cx, ay: u.cy, az: u.cz });\n            }\n            // createTrackV2() + fixBanks()\n            const pts = [], bankAngles = [], speedList = [], loopFlags = [];\n            for (const u of kept) {\n                pts.push(new THREE.Vector3(-u.ax, u.ay, u.az));\n                bankAngles.push(u.bank === 'LEFT' ? 45 : u.bank === 'RIGHT' ? -45 : 0);\n                speedList.push(u.speed);\n                loopFlags.push(u.trackType.includes('LOOP'));\n            }\n            return { pts, bankAngles, speedList, loopFlags };\n        }\n\n        // ── TRACK STATE ─────────────────────────────────────────────────────\n        let trackCurve, trackLength;\n        let trackUpSamples = [];\n        let trackFrameSamples = [];\n        let trackDebugSamples = [];\n        let trackLoopFlags = [];\n        let trackSpeedList = [];\n        let trackKnotPts   = [];\n        let rawSegCount    = 0;    // raw point count (before de-dup), used for segment index lookup\n        let trackRawPositions = [];  // raw world positions (before de-dup), for segment color mapping\n        let trackIsClosed  = true;   // false = open (start→finish), true = closed loop\n        let trackSegments = [];     // [{start, end, colorIndex, derailSpeed, derailDuration}]\n        let trackSegMeshes = [];    // [{meshes:[Mesh,...], tStart, tEnd, midPos:Vector3}] per segment\n        let trackConflicts = [];    // [{segA, segB}] — pairs of segments that spatially cross\n        let trackStages   = [];     // [{stageId, t, ...}] — stage platforms along track\n        let trackDecorations = [];  // [{type, position, rotationY, speedValue}] — raw from JSON\n        let trackLoopRanges = [];   // merged loop ranges for camera logic\n        let trackKnotCount  = 0;    // number of control points, for loopWeight lookup\n\n        // ── V11 SAFE CENTERLINE ─────────────────────────────────────────────\n        // The frame system can make rails look flat, but it cannot fix a centerline\n        // spline that folds back on itself.  V11 changes the root spline from uniform\n        // CatmullRom to centripetal CatmullRom, which is specifically safer for\n        // unevenly spaced control points and avoids many cusps / local loops.\n        // We also validate the resulting curve and use the same safe mode for rail\n        // visual splines so the rendered rail geometry follows the cart path.\n        const TRACK_SPLINE_TYPE = 'centripetal';\n        const TRACK_SPLINE_TENSION = 0.5;\n\n        function createSafeCatmullRomCurve(points, closed = false, label = 'curve') {\n            const curve = new THREE.CatmullRomCurve3(\n                points,\n                closed,\n                TRACK_SPLINE_TYPE,\n                TRACK_SPLINE_TENSION\n            );\n            curve.arcLengthDivisions = Math.max(2000, points.length * 100);\n            curve.updateArcLengths();\n            return curve;\n        }\n\n        function validateCenterlineCurve(curve, label = 'trackCurve', samples = 900) {\n            if (!curve) return;\n            let tangentFlips = 0;\n            let localBacktracks = 0;\n            let prevTan = curve.getTangentAt(0).normalize();\n            let prevPt = curve.getPointAt(0);\n            const worst = [];\n\n            for (let i = 1; i <= samples; i++) {\n                const t = i / samples;\n                const pt = curve.getPointAt(t);\n                const tan = curve.getTangentAt(t).normalize();\n                const tanDot = tan.dot(prevTan);\n                if (tanDot < 0) {\n                    tangentFlips++;\n                    if (worst.length < 8) worst.push({ i, t: Number(t.toFixed(5)), tanDot: Number(tanDot.toFixed(4)) });\n                }\n\n                const delta = pt.clone().sub(prevPt);\n                if (delta.lengthSq() > 1e-10) {\n                    const deltaDir = delta.clone().normalize();\n                    const motionDot = deltaDir.dot(prevTan);\n                    if (motionDot < -0.15) {\n                        localBacktracks++;\n                        if (worst.length < 8) worst.push({ i, t: Number(t.toFixed(5)), motionDot: Number(motionDot.toFixed(4)) });\n                    }\n                }\n\n                prevTan = tan;\n                prevPt = pt;\n            }\n\n            const msg = `[TrackCurveDebug] ${label} validation: tangentFlips=${tangentFlips}, localBacktracks=${localBacktracks}, spline=${TRACK_SPLINE_TYPE}`;\n            if (tangentFlips || localBacktracks) console.log(msg, JSON.stringify(worst));\n            else console.log(msg);\n            debugScreenLog(msg);\n        }\n\n        // ── createTrack() ────────────────────────────────────────────────────\n        // Priority:\n        //   1. config.rct2Track (from game_config.json) — user's custom track\n        //   2. URL param ?level=... or window.startLevelId → load from Levels/\n        //   3. TRACK_CATALOG[name] → load from Levels/{filename}.json\n        //\n        // config.rct2Closed controls open vs closed loop.\n        // Built-in TRACK_CATALOG tracks are always closed loops (they loop back to station).\n        async function createTrack() {\n            trackUpSamples = []; trackFrameSamples = []; trackDebugSamples = []; trackSpeedList = []; trackKnotPts = []; trackLoopFlags = [];\n\n            let txt, closed, stageData = null;\n\n            // Priority 1: levelData object embedded in game_config.json\n            if (config.levelData && typeof config.levelData === 'object' && config.levelData.track) {\n                const ld = config.levelData;\n                txt    = ld.track;\n                closed = ld.closed === true;\n                trackSegments = ld.segments || [];\n                activeTrackName = ld.name || activeTrackName;\n                stageData = ld.stages || null;\n                trackDecorations = ld.decorations || [];\n            } else {\n                // Priority 2: Levels/ folder (fallback for local dev / legacy)\n                const urlParams = new URLSearchParams(window.location.search);\n                const levelName = urlParams.get('level') || window.startLevelId;\n                const loadJson = async (name) => {\n                    const res = await fetch('Levels/' + name);\n                    return res.ok ? await res.json() : null;\n                };\n                let levelData = levelName ? await loadJson(levelName + '.json') : null;\n                if (!levelData) {\n                    const filename = TRACK_CATALOG[activeTrackName]\n                                  || TRACK_CATALOG[Object.keys(TRACK_CATALOG)[0]];\n                    if (filename) levelData = await loadJson(filename);\n                }\n                if (levelData) {\n                    txt    = levelData.track;\n                    closed = levelData.closed === true;\n                    trackSegments = levelData.segments || [];\n                    activeTrackName = levelData.name || activeTrackName;\n                    stageData = levelData.stages || null;\n                    trackDecorations = levelData.decorations || [];\n                }\n            }\n\n            if (!txt) { console.error('[createTrack] No track data loaded'); return; }\n\n            rawSegCount = txt.split('\\n').filter(l => l.trim()).length;\n\n            // Build raw position array for segment color mapping\n            trackRawPositions = [];\n            for (const line of txt.split('\\n')) {\n                if (!line.trim()) continue;\n                const u = parseRCT2Line(line);\n                if (u) trackRawPositions.push(new THREE.Vector3(-u.cx, u.cy, u.cz));\n            }\n\n            const { pts, bankAngles, speedList, loopFlags } = parseRCT2TrackData(txt);\n            trackSpeedList = speedList;\n            trackLoopFlags = loopFlags;\n            trackKnotPts   = pts;\n            trackIsClosed  = closed;\n\n            trackCurve  = createSafeCatmullRomCurve(pts, closed, 'trackCurve');\n            validateCenterlineCurve(trackCurve, 'trackCurve');\n            trackLength = trackCurve.getLength();\n\n            // Convert segment raw indices to t-values (arc-length based)\n            for (const seg of trackSegments) {\n                if (seg.start < 0 || seg.end >= trackRawPositions.length) continue;\n                const posStart = trackRawPositions[seg.start];\n                const posEnd   = trackRawPositions[Math.min(seg.end, trackRawPositions.length - 1)];\n                seg.tStart = findClosestTOnTrack(posStart);\n                seg.tEnd   = findClosestTOnTrack(posEnd);\n            }\n\n            buildUpSamples(800, bankAngles, pts.length, trackLoopFlags);\n\n            // Compute stage t-values from JSON stage data\n            trackStages = [];\n            const rawStages = stageData || config.stages || [];\n            if (rawStages.length > 0) {\n                rawStages.sort((a,b) => a.stageId - b.stageId);\n                for (const st of rawStages) {\n                    const sp = st.position || [0,0,0];\n                    const target = new THREE.Vector3(sp[0], sp[1], sp[2]);\n                    let bestT = 0, bestD = Infinity;\n                    for (let j = 0; j <= 500; j++) {\n                        const tj = j / 500;\n                        const d = trackCurve.getPointAt(tj).distanceTo(target);\n                        if (d < bestD) { bestD = d; bestT = tj; }\n                    }\n                    trackStages.push({ ...st, t: bestT });\n                }\n                // Pre-compute t-range for each stage based on platformLength\n                for (const st of trackStages) {\n                    const halfLen = ((st.platformLength || 50) * 0.5) / trackLength;\n                    st.tStart = Math.max(0, st.t - halfLen);\n                    st.tEnd   = Math.min(0.9999, st.t + halfLen);\n                }\n            }\n        }\n\n\n        // ── buildUpSamples() ─────────────────────────────────────────────────\n        // Pure parallel transport: up is carried forward sample-by-sample,\n        // rotated only by the tangent change between samples.  No per-sample\n        // world-Y projection — avoids 180° flips when tangent crosses vertical.\n        // Bank overlay (smoothstep) is applied on top of the transported up.\n        function smoothstep01(x) {\n            x = THREE.MathUtils.clamp(x, 0, 1);\n            return x * x * (3 - 2 * x);\n        }\n\n        function projectOnPlane(v, normal) {\n            return v.clone().addScaledVector(normal, -v.dot(normal));\n        }\n\n        function safeNormalizeOrNull(v) {\n            if (!v || v.lengthSq() < 1e-10) return null;\n            return v.normalize();\n        }\n\n        function getBankAt(t, knotBanks, knotCount) {\n            if (!knotBanks || knotBanks.length < 2 || knotCount < 2) return 0;\n\n            const knotF = t * (knotCount - 1);\n            const kA = Math.min(Math.floor(knotF), knotBanks.length - 1);\n            const kB = Math.min(kA + 1, knotBanks.length - 1);\n            const frac = smoothstep01(knotF - kA);\n\n            return THREE.MathUtils.lerp(knotBanks[kA], knotBanks[kB], frac);\n        }\n\n        function makeWorldUpFrame(tan, previousUp) {\n            const worldUp = new THREE.Vector3(0, 1, 0);\n            const worldForward = new THREE.Vector3(0, 0, 1);\n            const worldRight = new THREE.Vector3(1, 0, 0);\n\n            let up = safeNormalizeOrNull(projectOnPlane(worldUp, tan));\n\n            // If tangent is vertical, world-up projection is undefined.\n            // Use the last valid up only as a short fallback, not as the main loop solution.\n            if (!up && previousUp) up = safeNormalizeOrNull(projectOnPlane(previousUp, tan));\n            if (!up) up = safeNormalizeOrNull(projectOnPlane(worldForward, tan));\n            if (!up) up = safeNormalizeOrNull(projectOnPlane(worldRight, tan));\n            if (!up) up = new THREE.Vector3(0, 1, 0);\n\n            let right = new THREE.Vector3().crossVectors(up, tan);\n            right = safeNormalizeOrNull(right) || new THREE.Vector3(1, 0, 0);\n            up = new THREE.Vector3().crossVectors(tan, right).normalize();\n\n            return { up, right };\n        }\n\n        function makeLoopInsideFrame(i, tangents, previousLoopUp, fallbackUp) {\n            const tan = tangents[i];\n            const prev = tangents[Math.max(0, i - 1)];\n            const next = tangents[Math.min(tangents.length - 1, i + 1)];\n\n            // Curvature normal: direction toward the local center of curvature.\n            // For a vertical loop this is exactly the \"inside of the loop\" direction.\n            let loopUp = next.clone().sub(prev);\n            loopUp.addScaledVector(tan, -loopUp.dot(tan));\n            loopUp = safeNormalizeOrNull(loopUp);\n\n            if (!loopUp && previousLoopUp) loopUp = safeNormalizeOrNull(projectOnPlane(previousLoopUp, tan));\n            if (!loopUp) loopUp = safeNormalizeOrNull(projectOnPlane(fallbackUp, tan));\n            if (!loopUp) return makeWorldUpFrame(tan, previousLoopUp || fallbackUp);\n\n            // Keep the curvature normal continuous. Do NOT compare with worldUp here:\n            // at the top of a loop the correct inside direction is downward.\n            if (previousLoopUp && loopUp.dot(previousLoopUp) < 0) loopUp.negate();\n\n            let right = new THREE.Vector3().crossVectors(loopUp, tan);\n            right = safeNormalizeOrNull(right) || makeWorldUpFrame(tan, fallbackUp).right;\n            loopUp = new THREE.Vector3().crossVectors(tan, right).normalize();\n\n            return { up: loopUp, right };\n        }\n\n        function buildLoopRanges(loopFlags, knotCount) {\n            const ranges = [];\n            if (!loopFlags || loopFlags.length === 0 || knotCount < 2) return ranges;\n\n            let i = 0;\n            while (i < loopFlags.length) {\n                while (i < loopFlags.length && !loopFlags[i]) i++;\n                if (i >= loopFlags.length) break;\n\n                let a = i;\n                while (i < loopFlags.length && loopFlags[i]) i++;\n                let b = i - 1;\n\n                // RCT/OpenRCT2 loop exports may lose several intermediate points during de-dup/filtering.\n                // Expand the semantic LOOP span so the whole vertical loop uses the inside-of-loop frame,\n                // not just a few knots around the flagged control points.\n                const expand = 5;\n                a = Math.max(0, a - expand);\n                b = Math.min(knotCount - 1, b + expand);\n\n                if (ranges.length > 0 && a <= ranges[ranges.length - 1].b + 1) {\n                    ranges[ranges.length - 1].b = Math.max(ranges[ranges.length - 1].b, b);\n                } else {\n                    ranges.push({ a, b });\n                }\n            }\n            return ranges;\n        }\n\n        function detectGeometricLoopRanges(N, knotCount, tangents) {\n            const ranges = [];\n            if (!trackCurve || !tangents || tangents.length < 8) return ranges;\n\n            const positions = [];\n            let minY = Infinity, maxY = -Infinity;\n            for (let i = 0; i <= N; i++) {\n                const p = trackCurve.getPointAt(i / N);\n                positions.push(p);\n                minY = Math.min(minY, p.y);\n                maxY = Math.max(maxY, p.y);\n            }\n\n            const ySpanAll = Math.max(1e-6, maxY - minY);\n\n            // IMPORTANT:\n            // Previous v5 used \"high Y\" as part of loop detection. The debug log showed\n            // loopWeight=0.5 at i=0 while tangent was still (0,0,1), so the detector was\n            // incorrectly pulling a straight section into LOOP_PLANE mode.\n            // This version detects only sections where the tangent is actually rotating.\n            const curveAng = new Array(N + 1).fill(0);\n            for (let i = 1; i < N; i++) {\n                const a = tangents[i - 1];\n                const b = tangents[i + 1];\n                const c = THREE.MathUtils.clamp(a.dot(b), -1, 1);\n                curveAng[i] = Math.acos(c);\n            }\n\n            const active = new Array(N + 1).fill(false);\n            const CURVE_EPS = 0.0012;      // about 0.07 degrees over two samples\n            const VERT_TAN_EPS = 0.10;     // loop sides have noticeable vertical tangent\n            for (let i = 1; i < N; i++) {\n                active[i] = curveAng[i] > CURVE_EPS || Math.abs(tangents[i].y) > VERT_TAN_EPS;\n            }\n\n            // Group active samples, allowing small gaps. This catches one continuous loop\n            // without spreading all the way back to a long straight station/approach.\n            const raw = [];\n            const GAP = Math.max(4, Math.round(N * 0.006));      // ~5 samples at N=800\n            const EXPAND = Math.max(6, Math.round(N * 0.010));   // ~8 samples at N=800\n            let i = 0;\n            while (i <= N) {\n                while (i <= N && !active[i]) i++;\n                if (i > N) break;\n\n                let s = i, e = i, lastActive = i;\n                i++;\n                while (i <= N) {\n                    if (active[i]) {\n                        lastActive = i;\n                        e = i;\n                    } else if (i - lastActive > GAP) {\n                        break;\n                    }\n                    i++;\n                }\n                e = lastActive;\n\n                s = Math.max(0, s - EXPAND);\n                e = Math.min(N, e + EXPAND);\n\n                if (raw.length && s <= raw[raw.length - 1].e + GAP) {\n                    raw[raw.length - 1].e = Math.max(raw[raw.length - 1].e, e);\n                } else {\n                    raw.push({ s, e });\n                }\n            }\n\n            const worldUp = new THREE.Vector3(0, 1, 0);\n            for (const r of raw) {\n                let turn = 0;\n                let normalSum = new THREE.Vector3();\n                let localMinY = Infinity, localMaxY = -Infinity, bottomIdx = r.s;\n                let maxAbsTanY = 0;\n                let strongVerticalCount = 0;\n                let straightishCount = 0;\n\n                for (let j = r.s; j <= r.e; j++) {\n                    const y = positions[j].y;\n                    if (y < localMinY) { localMinY = y; bottomIdx = j; }\n                    localMaxY = Math.max(localMaxY, y);\n                    const absTanY = Math.abs(tangents[j].y);\n                    maxAbsTanY = Math.max(maxAbsTanY, absTanY);\n                    if (absTanY > 0.25) strongVerticalCount++;\n                    if (curveAng[j] < CURVE_EPS * 0.5 && absTanY < VERT_TAN_EPS * 0.5) straightishCount++;\n                }\n\n                for (let j = r.s; j < r.e; j++) {\n                    const a = tangents[j];\n                    const b = tangents[j + 1];\n                    const c = new THREE.Vector3().crossVectors(a, b);\n                    const sin = c.length();\n                    const cos = THREE.MathUtils.clamp(a.dot(b), -1, 1);\n                    const ang = Math.atan2(sin, cos);\n                    turn += ang;\n                    if (sin > 1e-7) normalSum.add(c.normalize().multiplyScalar(ang));\n                }\n\n                const localYSpan = localMaxY - localMinY;\n                const sampleLen = r.e - r.s + 1;\n                const verticalRatio = strongVerticalCount / Math.max(1, sampleLen);\n\n                // Reject ranges that are too straight, too flat, or too tiny.\n                // The verticalRatio test is important: a long flat horizontal curve can accumulate\n                // a large tangent turn, but it is not a vertical loop and must not receive LOOP_PLANE roll.\n                if (sampleLen < Math.max(24, Math.round(N * 0.03))) continue;\n                if (localYSpan < Math.max(8, ySpanAll * 0.28)) continue;\n                if (maxAbsTanY < 0.35) continue;\n                if (verticalRatio < 0.12) continue;\n                if (turn < Math.PI * 1.45) continue;\n                if (normalSum.lengthSq() < 1e-8) continue;\n\n                // A vertical loop's plane normal is mostly horizontal.\n                let normal = normalSum.normalize();\n                if (Math.abs(normal.dot(worldUp)) > 0.65) continue;\n\n                // Trim straight tails again after validation. This prevents the blend from\n                // starting before the tangent has actually begun to rotate.\n                let ts = r.s, te = r.e;\n                while (ts < te && curveAng[ts] < CURVE_EPS && Math.abs(tangents[ts].y) < VERT_TAN_EPS) ts++;\n                while (te > ts && curveAng[te] < CURVE_EPS && Math.abs(tangents[te].y) < VERT_TAN_EPS) te--;\n                ts = Math.max(