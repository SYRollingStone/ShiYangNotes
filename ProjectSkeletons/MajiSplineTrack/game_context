i++) {\n                        const li = i - sA;\n                        const tan = trackFrameSamples[i].tan;\n\n                        // Weighted average of neighboring up vectors\n                        let smoothedUp = oldUp[li].clone().multiplyScalar(0.5);\n                        let prevU = oldUp[li - 1].clone();\n                        let nextU = oldUp[li + 1].clone();\n                        // Ensure neighbors point in same hemisphere as center\n                        if (prevU.dot(oldUp[li]) < 0) prevU.negate();\n                        if (nextU.dot(oldUp[li]) < 0) nextU.negate();\n                        smoothedUp.add(prevU.multiplyScalar(0.25));\n                        smoothedUp.add(nextU.multiplyScalar(0.25));\n\n                        // Re-project onto tangent plane and re-orthogonalize\n                        smoothedUp = safeNormalizeOrNull(projectOnPlane(smoothedUp, tan));\n                        if (!smoothedUp) continue;\n                        let smoothedRight = new THREE.Vector3().crossVectors(smoothedUp, tan);\n                        smoothedRight = safeNormalizeOrNull(smoothedRight);\n                        if (!smoothedRight) continue;\n                        smoothedUp = new THREE.Vector3().crossVectors(tan, smoothedRight).normalize();\n\n                        trackFrameSamples[i].up = smoothedUp;\n                        trackFrameSamples[i].right = smoothedRight;\n                        trackUpSamples[i] = smoothedUp.clone();\n                    }\n                }\n            }\n\n            summarizeTrackFrameDebug(loopRanges, loopFlags, knotCount);\n\n            // ── DIAG: Full loop region frame table ──\n            if (DIAG_ENABLED && trackDebugSamples.length > 0) {\n                const loopSamples = trackDebugSamples.filter(d => d.t >= diagLoopTMin && d.t <= diagLoopTMax);\n                diagLog('FRAME_TABLE', `Loop region samples: ${loopSamples.length} (t=${diagLoopTMin.toFixed(4)}..${diagLoopTMax.toFixed(4)})`);\n\n                // Check for tangent sign consistency across the loop region\n                let tanFlipCount = 0;\n                let upFlipCount = 0;\n                let rightFlipCount = 0;\n                for (let j = 1; j < loopSamples.length; j++) {\n                    if (loopSamples[j].upDotPrev < 0) upFlipCount++;\n                    if (loopSamples[j].rightDotPrev < 0) rightFlipCount++;\n                    // Check tangent continuity\n                    const tA = loopSamples[j-1].tan;\n                    const tB = loopSamples[j].tan;\n                    if (tA && tB) {\n                        const dot = tA.x*tB.x + tA.y*tB.y + tA.z*tB.z;\n                        if (dot < 0) tanFlipCount++;\n                    }\n                }\n                diagLog('FRAME_TABLE', `Loop region flip summary: tanFlips=${tanFlipCount} upFlips=${upFlipCount} rightFlips=${rightFlipCount}`);\n\n                // Dump the transition samples at loop entry/exit\n                const transitionSamples = loopSamples.filter(d =>\n                    d.loopWeight > 0.001 && d.loopWeight < 0.999\n                );\n                diagLog('FRAME_TABLE', `Transition samples (0<loopW<1): ${transitionSamples.length}`);\n                for (const ts of transitionSamples) {\n                    diagLog('FRAME_TABLE', `  i=${ts.i} t=${ts.t} knotF=${ts.knotF} loopW=${ts.loopWeight} mode=${ts.mode}` +\n                        ` worldDotLoop=${ts.worldDotLoop}`);\n                }\n            }\n        }\n\n        // ── getGameFrame() ───────────────────────────────────────────────────\n        // Mirrors PlayCoasterScript: EvaluatePosition + EvaluateTangent + EvaluateUpVector\n        function getGameFrame(t) {\n            const tc = Math.max(0, Math.min(0.9999, t));\n            const pt = trackCurve.getPointAt(tc);\n            let tan = trackCurve.getTangentAt(tc).normalize();\n            const rawCurveTan = tan.clone(); // save raw tangent for DIAG comparison\n\n            if (!trackFrameSamples || trackFrameSamples.length === 0) {\n                const fallbackRight = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), tan).normalize();\n                const fallbackUp = new THREE.Vector3().crossVectors(tan, fallbackRight).normalize();\n                return { pt, tan, right: fallbackRight, up: fallbackUp };\n            }\n\n            const idx = tc * (trackFrameSamples.length - 1);\n            const idxA = Math.floor(idx);\n            const idxB = Math.min(idxA + 1, trackFrameSamples.length - 1);\n            const f = idx - idxA;\n\n            // Use the pre-stabilized tangent from buildUpSamples instead of the raw\n            // CatmullRom derivative.  This prevents 1-frame tangent sign flips from\n            // twisting flat road sections and cross-ties near stations / cusps.\n            let tanNegated = false;\n            if (trackFrameSamples[idxA].tan && trackFrameSamples[idxB].tan) {\n                let tanA = trackFrameSamples[idxA].tan.clone();\n                let tanB = trackFrameSamples[idxB].tan.clone();\n                if (tanA.dot(tanB) < 0) { tanB.negate(); tanNegated = true; }\n                const stableTan = tanA.lerp(tanB, f);\n                if (stableTan.lengthSq() > 1e-8) tan = stableTan.normalize();\n            }\n\n            let rightA = trackFrameSamples[idxA].right.clone();\n            let rightB = trackFrameSamples[idxB].right.clone();\n            let rightNegated = false;\n            if (rightA.dot(rightB) < 0) { rightB.negate(); rightNegated = true; }\n\n            let right = rightA.lerp(rightB, f);\n            right.addScaledVector(tan, -right.dot(tan));\n\n            if (right.lengthSq() < 1e-8) {\n                right = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), tan);\n                if (right.lengthSq() < 1e-8) {\n                    right = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 0, 1), tan);\n                }\n            }\n\n            right.normalize();\n            const up = new THREE.Vector3().crossVectors(tan, right).normalize();\n\n            // ── DIAG: Runtime frame flip detection ──\n            if (DIAG_ENABLED && tc >= diagLoopTMin && tc <= diagLoopTMax) {\n                const now = performance.now() / 1000;\n                if (now - diagLastLogTime > DIAG_LOG_INTERVAL) {\n                    diagLastLogTime = now;\n                    const rawDotStable = rawCurveTan.dot(tan);\n                    diagLog('FRAME_RT', `t=${tc.toFixed(5)} idxA=${idxA} idxB=${idxB} f=${f.toFixed(3)}` +\n                        ` | tan=${diagVec(tan)} up=${diagVec(up)} right=${diagVec(right)}` +\n                        ` | rawTanDotStable=${rawDotStable.toFixed(4)}` +\n                        ` | tanNegated=${tanNegated} rightNegated=${rightNegated}` +\n                        ` | sampleA.tan=${diagVec(trackFrameSamples[idxA].tan)} sampleB.tan=${diagVec(trackFrameSamples[idxB].tan)}` +\n                        ` | sampleA.up=${diagVec(trackFrameSamples[idxA].up)} sampleB.up=${diagVec(trackFrameSamples[idxB].up)}`);\n                }\n            }\n\n            return { pt, tan, right, up };\n        }\n\n        // ── findClosestTOnTrack() ──────────────────────────────────────────\n        // Pre-cached sample points for fast nearest-t lookup.\n        let _trackSamplePts = null;  // [{pt, t}]\n        const _TRACK_SAMPLE_COUNT = 600;\n\n        function ensureTrackSamples() {\n            if (_trackSamplePts) return;\n            _trackSamplePts = [];\n            for (let j = 0; j <= _TRACK_SAMPLE_COUNT; j++) {\n                const t = j / _TRACK_SAMPLE_COUNT;\n                _trackSamplePts.push({ pt: trackCurve.getPointAt(t), t });\n            }\n        }\n\n        function findClosestTOnTrack(pos) {\n            if (!trackCurve) return 0;\n            ensureTrackSamples();\n            let bestT = 0, bestD = Infinity;\n            for (cons