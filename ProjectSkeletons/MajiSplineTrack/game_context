\n                const mat = getStarMaterial(col);\n                const mesh = new THREE.Mesh(geo, mat);\n                mesh.position.set(pos[0], pos[1], pos[2]);\n                mesh.scale.set(scl[0], scl[1], scl[2]);\n                mesh.rotation.order = 'YXZ';\n                mesh.rotation.set(rot[0]*degToRad, rot[1]*degToRad, rot[2]*degToRad);\n                parent.add(mesh);\n                registerSegmentMesh(dec, mesh);\n                cullJsonDecos.push({ obj: mesh, pos: mesh.position.clone() });\n            }\n        }\n\n        // ══════════════════════════════════════════════════════════════════\n        // PROCEDURAL DECORATION GENERATOR\n        // Automatically populates the world with decorations along the track.\n        // Skips the region between Stage 1 and Stage 2 (manually decorated).\n        // ══════════════════════════════════════════════════════════════════\n\n        function generateProceduralDecorations() {\n            if (!trackCurve || trackStages.length < 2) return;\n            const procEnabled = config.proceduralDecorations?.enabled !== false;\n            if (!procEnabled) return;\n\n            const density = config.proceduralDecorations?.density ?? 1.0;\n            const baseSeed = config.proceduralDecorations?.seed ?? 137;\n\n            // ── Seeded PRNG (mulberry32) ──────────────────────────────────\n            function mulberry32(a) {\n                return function() {\n                    a |= 0; a = a + 0x6D2B79F5 | 0;\n                    let t = Math.imul(a ^ a >>> 15, 1 | a);\n                    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;\n                    return ((t ^ t >>> 14) >>> 0) / 4294967296;\n                };\n            }\n            const rng = mulberry32(baseSeed);\n            const rand = () => rng();\n            const randRange = (a, b) => a + rand() * (b - a);\n            const randInt = (a, b) => Math.floor(randRange(a, b + 1));\n            const pick = arr => arr[Math.floor(rand() * arr.length)];\n\n            // ── Skip zone: Stage 1 → Stage 2 ─────────────────────────────\n            const skipTStart = trackStages[0].tStart ?? trackStages[0].t;\n            const skipTEnd   = trackStages[1].tEnd   ?? trackStages[1].t;\n\n            function isInSkipZone(t) {\n                return t >= skipTStart && t <= skipTEnd;\n            }\n\n            // ── Color palettes ────────────────────────────────────────────\n            const WARM    = ['#FF3E4D','#FF8C42','#FFD740','#FF6B9D','#FFAB40'];\n            const COOL    = ['#40C4FF','#69F0AE','#00E5FF','#76FF03','#E040FB'];\n            const PASTEL  = ['#FFB3BA','#FFDFBA','#FFFFBA','#BAFFC9','#BAE1FF'];\n            const RAINBOW = ['#FF0000','#FF8800','#FFEE00','#00CC44','#0066FF','#8833CC'];\n            const EARTH   = ['#8B5E3C','#A0622A','#6B8E23','#556B2F','#2E8B57'];\n\n            // ── Shared group for all procedural decorations ───────────────\n            const procGroup = new THREE.Group();\n            procGroup.name = 'proceduralDecorations';\n            scene.add(procGroup);\n\n            // ── Helper: place mesh relative to track frame ────────────────\n            function placeAtTrack(mesh, t, sideOffset, heightOffset, alignToTrack = true) {\n                const frame = getGameFrame(t);\n                const pos = frame.pt.clone()\n                    .addScaledVector(frame.right, sideOffset)\n                    .addScaledVector(frame.up, heightOffset);\n                mesh.position.copy(pos);\n                if (alignToTrack) {\n                    mesh.rotation.y = Math.atan2(frame.tan.x, frame.tan.z);\n                }\n            }\n\n            // ── Helper: create a single-color cube (1 DC, not 6) ─────────\n            function makeColorCube(hex, sx, sy, sz) {\n                const mat = getCubeMaterial(hex);\n                const m = new THREE.Mesh(_cubeGeo, mat);\n                m.scale.set(sx, sy, sz);\n                return m;\n            }\n\n            // ── Pixel Tree: brown trunk + green crown cubes ───────────────\n            function createPixelTree(t, side) {\n                const g = new THREE.Group();\n                const trunkH = randRange(2.5, 5);\n                const trunk = makeColorCube(pick(EARTH), 0.6, trunkH, 0.6);\n                trunk.position.y = trunkH / 2;\n                g.add(trunk);\n\n                const crownLayers = randInt(2, 4);\n                for (let i = 0; i < crownLayers; i++) {\n                    const s = randRange(1.5, 3.0) - i * 0.3;\n                    const crown = makeColorCube(pick(['#2E8B57','#228B22','#32CD32','#6B8E23','#3CB371']),\n                        s, randRange(0.8, 1.5), s);\n                    crown.position.y = trunkH + i * 1.0 + 0.5;\n                    crown.rotation.y = rand() * Math.PI;\n                    g.add(crown);\n                }\n\n                const offset = side * randRange(8, 18);\n                placeAtTrack(g, t, offset, -1, true);\n                g.rotation.y += randRange(-0.3, 0.3);\n                procGroup.add(g);\n            }\n\n            // ── Floating Cube Tower: stacked colored cubes ────────────────\n            function createCubeTower(t, side) {\n                const g = new THREE.Group();\n                const count = randInt(3, 6);\n                const palette = pick([WARM, COOL, PASTEL, RAINBOW]);\n                let y = 0;\n                for (let i = 0; i < count; i++) {\n                    const s = randRange(0.5, 1.8);\n                    const c = makeColorCube(pick(palette), s, s, s);\n                    c.position.y = y + s / 2;\n                    c.rotation.set(rand() * 0.4, rand() * Math.PI, rand() * 0.4);\n                    g.add(c);\n                    y += s * 0.85;\n                }\n                placeAtTrack(g, t, side * randRange(5, 12), randRange(0, 3), true);\n                procGroup.add(g);\n            }\n\n            // ── Pixel Arch: two pillars + rainbow crossbar ────────────────\n            function createPixelArch(t) {\n                const g = new THREE.Group();\n                const h = randRange(7, 10);\n                const w = randRange(4, 6);\n                // Pillars\n                const pillarL = makeColorCube('#CCCCCC', 0.8, h, 0.8);\n                pillarL.position.set(-w, h / 2, 0);\n                g.add(pillarL);\n                const pillarR = makeColorCube('#CCCCCC', 0.8, h, 0.8);\n                pillarR.position.set(w, h / 2, 0);\n                g.add(pillarR);\n                // Rainbow crossbar segments\n                const segW = (w * 2) / RAINBOW.length;\n                for (let i = 0; i < RAINBOW.length; i++) {\n                    const seg = makeColorCube(RAINBOW[i], segW + 0.1, 1.0, 1.0);\n                    seg.position.set(-w + segW * (i + 0.5), h + 0.5, 0);\n                    g.add(seg);\n                }\n                placeAtTrack(g, t, 0, 2, true);\n                procGroup.add(g);\n            }\n\n            // ── Pixel Diamond: two rotated cubes ──────────────────────────\n            function createPixelDiamond(t, side) {\n                const g = new THREE.Group();\n                const s = randRange(1.5, 3.0);\n                const palette = pick([['#E8F4FD','#B0D4F1'], ['#FFD700','#FFA500'], ['#FF69B4','#FF1493']]);\n                const c1 = makeColorCube(palette[0], s, s, s);\n                c1.rotation.set(Math.PI / 4, Math.PI / 4, 0);\n                g.add(c1);\n                const c2 = makeColorCube(palette[1], s * 0.6, s * 0.6, s * 0.6);\n                c2.rotation.set(Math.PI / 4, 0, Math.PI / 4);\n                g.add(c2);\n                placeAtTrack(g, t, side * randRange(4, 10), randRange(8, 25), false);\n                g.rotation.y = rand() * Math.PI * 2;\n                procGroup.add(g);\n            }\n\n            // ── Scattered Color Cubes (small debris) ──────────────────────\n            function createScatteredCubes(t, side) {\n                const palette = pick([WARM, COOL, PASTEL]);\n                const count = randInt(2, 5);\n                for (let i = 0; i < count; i++) {\n                    const s = randRange(0.3, 1.2);\n                    const c = makeColorCube(pick(palette), s, s, s);\n                    const offset = side * randRange(3, 10);\n                    const spread = randRange(-3, 3);\n                    placeAtTrack(c, t, offset + spread, randRange(-0.5, 1.5), false);\n                    c.rotation.set(rand() * Math.PI, rand() * Math.PI, rand() * Math.PI);\n                    procGroup.add(c);\n                }\n            }\n\n            // ── Paper Plane Formation ─────────────────────────────────────\n            function createPlaneFormation(t) {\n                const geo = getPaperPlaneGeometry();\n                const mat = getPaperPlaneMaterials('#FFFFFF');\n                const count = randInt(3, 7);\n                const baseH = randRange(15, 35);\n                const baseSide = randRange(-8, 8);\n                for (let i = 0; i < count; i++) {\n                    const m = new THREE.Mesh(geo, mat);\n                    const s = randRange(1.5, 3.0);\n                    m.scale.set(s, s, s);\n                    const ti = Math.min(0.9999, t + i * randRange(0.002, 0.006));\n                    placeAtTrack(m, ti, baseSide + randRange(-3, 3), baseH + randRange(-4, 4), true);\n                    m.rotation.x += randRange(-0.15, 0.15);\n                    m.rotation.z += randRange(-0.2, 0.2);\n                    procGroup.add(m);\n                }\n            }\n\n            // ── Floating Stars ────────────────────────────────────────────\n            function createFloatingStar(t, side) {\n                const geo = getStarGeometry();\n                const colors = ['#FFD700','#FF6B6B','#69F0AE','#40C4FF','#FF69B4','#FFA500'];\n                const mat = getStarMaterial(pick(colors));\n                const m = new THREE.Mesh(geo, mat);\n                const s = randRange(0.8, 2.5);\n                m.scale.set(s, s, s);\n                placeAtTrack(m, t, side * randRange(3, 15), randRange(12, 40), false);\n                m.rotation.set(rand() * Math.PI, rand() * Math.PI, rand() * Math.PI);\n                procGroup.add(m);\n            }\n\n            // ── Floating Crescent ─────────────────────────────────────────\n            function createFloatingCrescent(t, side) {\n                const geo = getCrescentGeometry();\n                const colors = ['#8C33D9','#6A0DAD','#9B59B6','#E040FB','#BA68C8'];\n                const mat = getCrescentMaterial(pick(colors));\n                const m = new THREE.Mesh(geo, mat);\n                const s = randRange(1.5, 4.0);\n                m.scale.set(s, s, s);\n                placeAtTrack(m, t, side * randRange(5, 18), randRange(20, 50), false);\n                m.rotation.set(rand() * 0.5, rand() * Math.PI * 2, rand() * 0.5);\n                procGroup.add(m);\n            }\n\n            // ── Red Barrels near speed limit zones ────────────────────────\n            let _procBarrelGeo = null;\n            function createWarningBarrels(t, side) {\n                if (!_procBarrelGeo) _procBarrelGeo = new THREE.CylinderGeometry(0.5, 0.5, 1, 8);\n                const mat = getBarrelMaterial('#8C1A1A');\n                const count = randInt(2, 4);\n                for (let i = 0; i < count; i++) {\n                    const m = new THREE.Mesh(_procBarrelGeo, mat);\n                    const s = randRange(0.8, 1.5);\n                    m.scale.set(s, s, s);\n                    const ti = Math.min(0.9999, t + i * randRange(0.003, 0.008));\n                    placeAtTrack(m, ti, side * randRange(3, 6), randRange(-0.5, 0.5), false);\n                    m.rotation.x = randRange(-0.2, 0.2);\n                    m.rotation.z = randRange(-0.2, 0.2);\n                    procGroup.add(m);\n                }\n            }\n\n            // ── Floating Rubik's Cube (reuse shared geometry + materials) ──\n            let _procRubiksGeo = null;\n            let _procRubiksMats = null;\n            function createFloatingRubiks(t, side) {\n                if (!_procRubiksGeo) _procRubiksGeo = new THREE.BoxGeometry(3, 3, 3);\n                if (!_procRubiksMats) {\n                    const rubikColors = ['#FFFFFF','#FFD900','#CC1919','#FF8000','#0044AA','#009F2A'];\n                    _procRubiksMats = rubikColors.map(hex =>\n                        new THREE.MeshStandardMaterial({ color: new THREE.Color(hex), roughness: 0.4, metalness: 0.05 }));\n                }\n                const m = new THREE.Mesh(_procRubiksGeo, _procRubiksMats);\n                const s = randRange(0.6, 1.5);\n                m.scale.set(s, s, s);\n                placeAtTrack(m, t, side * randRange(6, 14), randRange(5, 20), false);\n                m.rotation.set(rand() * Math.PI, rand() * Math.PI, rand() * Math.PI);\n                procGroup.add(m);\n            }\n\n            // ══════════════════════════════════════════════════════════════\n            // MAIN GENERATION LOOP\n            // ══════════════════════════════════════════════════════════════\n            const STEP = 0.008 / density;   // base sampling step\n            let t = 0;\n            let lastTreeT   = -1;\n            let lastTowerT  = -1;\n            let lastArchT   = -1;\n            let lastPlaneT  = -1;\n\n            // Identify speed limit zones for barrel placement\n            const speedZones = trackSegments.filter(s => s.derailSpeed > 0 && s.tStart != null);\n\n            while (t < 0.9999) {\n                t += STEP * randRange(0.7, 1.4);  // jitter the step\n                if (t > 0.9999) break;\n                if (isInSkipZone(t)) continue;\n\n                const frame = getGameFrame(t);\n                const slopeY = frame.tan.y;\n                const side = (rand() > 0.5) ? 1 : -1;\n\n                // ── Ground decorations ────────────────────────────────\n                const groundRoll = rand();\n\n                // Pixel trees (most common ground item)\n                if (groundRoll < 0.35 && t - lastTreeT > 0.012) {\n                    createPixelTree(t, side);\n                    // Sometimes add a second tree on the other side\n                    if (rand() < 0.3) createPixelTree(t + randRange(0.001, 0.003), -side);\n                    lastTreeT = t;\n                }\n                // Cube towers\n                else if (groundRoll < 0.50 && t - lastTowerT > 0.025) {\n                    createCubeTower(t, side);\n                    lastTowerT = t;\n                }\n                // Scattered cubes\n                else if (groundRoll < 0.65) {\n                    createScatteredCubes(t, side);\n                }\n\n                // ── Sky decorations ───────────────────────────────────\n                const skyRoll = rand();\n\n                // Stars (fairly common in sky)\n                if (skyRoll < 0.25) {\n                    createFloatingStar(t, side);\n                }\n                // Paper plane formations (on downhills)\n                else if (skyRoll < 0.35 && slopeY < -0.1 && t - lastPlaneT > 0.06) {\n                    createPlaneFormation(t);\n                    lastPlaneT = t;\n                }\n                // Diamonds\n                else if (skyRoll < 0.45) {\n                    createPixelDiamond(t, side);\n                }\n                // Crescents (rare)\n                else if (skyRoll < 0.48) {\n                    createFloatingCrescent(t, side);\n                }\n                // Rubik's cubes (rare)\n                else if (skyRoll < 0.51) {\n                    createFloatingRubiks(t, side);\n                }\n\n                // ── Pixel arches at stage entrances ───────────────────\n                for (const st of trackStages) {\n                    const stT = st.tStart ?? st.t;\n                    if (Math.abs(t - stT) < 0.003 && t - lastArchT > 0.05 && !isInSkipZone(stT)) {\n                        createPixelArch(stT - 0.005);\n                        lastArchT = t;\n                        break;\n                    }\n                }\n            }\n\n            // ── Red barrels at speed limit zone entrances ─────────────\n            for (const sz of speedZones) {\n                if (isInSkipZone(sz.tStart)) continue;\n                const side = rand() > 0.5 ? 1 : -1;\n                createWarningBarrels(sz.tStart, side);\n                if (rand() < 0.5) createWarningBarrels(sz.tStart, -side);\n            }\n\n            // ══════════════════════════════════════════════════════════════\n            // DENSE DECORATION ZONES (Stage 2→3 and Stage 3→4)\n            // Mimics the hand-placed feel of Stage 1→2 with extra rubiks,\n            // large paper plane flocks, and dense cube clusters.\n            // ══════════════════════════════════════════════════════════════\n            if (trackStages.length >= 4) {\n                const denseZones = [\n                    { from: trackStages[1], to: trackStages[2] },  // Stage 2 → 3\n                    { from: trackStages[2], to: trackStages[3] },  // Stage 3 → 4\n                ];\n\n                for (const zone of denseZones) {\n                    const zStart = zone.from.tEnd ?? zone.from.t;\n                    const zEnd   = zone.to.tStart ?? zone.to.t;\n                    const zLen   = zEnd - zStart;\n                    if (zLen <= 0) continue;\n\n                    // ── Large paper plane flocks (3-4 per zone) ───────\n                    for (let f = 0; f < 4; f++) {\n                        const fT = zStart + zLen * (0.1 + f * 0.25 + rand() * 0.1);\n                        if (fT >= zEnd) continue;\n                        const geo = getPaperPlaneGeometry();\n                        const colors = ['#FFFFFF','#E0F0FF','#FFF8E0'];\n                        const mat = getPaperPlaneMaterials(pick(colors));\n                        const count = randInt(5, 12);\n                        const baseH = randRange(12, 30);\n                        const baseSide = randRange(-12, 12);\n                        for (let i = 0; i < count; i++) {\n                            const m = new THREE.Mesh(geo, mat);\n                            const s = randRange(2.0, 5.0);\n                            m.scale.set(s, s, s);\n                            const ti = Math.min(0.9999, fT + i * randRange(0.002, 0.005));\n                            placeAtTrack(m, ti, baseSide + randRange(-5, 5), baseH + randRange(-5, 8), true);\n                            m.rotation.x += randRange(-0.2, 0.2);\n                            m.rotation.z += randRange(-0.25, 0.25);\n                            procGroup.add(m);\n                        }\n                    }\n\n                    // ── Rubik's cubes (4-6 per zone, floating) ────────\n                    for (let r = 0; r < randInt(4, 6); r++) {\n                        const rT = zStart + zLen * rand();\n                        const side = (rand() > 0.5) ? 1 : -1;\n                        createFloatingRubiks(rT, side);\n                    }\n\n                    // ── Dense scattered cube clusters (8-12 per zone) ─\n                    for (let c = 0; c < randInt(8, 12); c++) {\n                        const cT = zStart + zLen * rand();\n                        const side = (rand() > 0.5) ? 1 : -1;\n                        const palette = pick([WARM, COOL, PASTEL, RAINBOW]);\n                        const count = randInt(4, 8);\n                        for (let i = 0; i < count; i++) {\n                            const s = randRange(0.5, 2.0);\n                            const cube = makeColorCube(pick(palette), s, s, s);\n                            const spread = randRange(-4, 4);\n                            placeAtTrack(cube, cT + rand() * 0.005, side * randRange(4, 14) + spread, randRange(-1, 4), false);\n                            cube.rotation.set(rand() * Math.PI, rand() * Math.PI, rand() * Math.PI);\n                            procGroup.add(cube);\n                        }\n                    }\n\n                    // ── Cube towers (4-5 per zone) ────────────────────\n                    for (let tw = 0; tw < randInt(4, 5); tw++) {\n                        const twT = zStart + zLen * rand();\n                        const side = (rand() > 0.5) ? 1 : -1;\n                        createCubeTower(twT, side);\n                    }\n\n                    // ── Large floating diamonds (2-3 per zone) ────────\n                    for (let d = 0; d < randInt(2, 3); d++) {\n                        const dT = zStart + zLen * rand();\n                        const side = (rand() > 0.5) ? 1 : -1;\n                        createPixelDiamond(dT, side);\n                    }\n\n                    // ── Extra stars cluster (6-10 per zone) ───────────\n                    for (let s = 0; s < randInt(6, 10); s++) {\n                        const sT = zStart + zLen * rand();\n                        const side = (rand() > 0.5) ? 1 : -1;\n                        createFloatingStar(sT, side);\n                    }\n                }\n            }\n\n            console.log(`[ProceduralDecorations] Generated ${procGroup.children.length} objects (density=${density})`);\n        }\n\n        // ══════════════════════════════════════════════════════════════════\n        // PROCEDURAL PLANETS\n        // Giant decorative spheres placed in empty space around the track.\n        // Each planet uses a Canvas texture (1 DC per planet, +1 for rings).\n        // Positions are checked against the track to prevent intersections.\n        // ══════════════════════════════════════════════════════════════════\n\n        const proceduralPlanets = [];   // [{mesh, rotSpeed:{x,y}}] for animation\n\n        function generateProceduralPlanets() {\n            if (!trackCurve || !trackLength) return;\n            const cfg = config.proceduralDecorations || {};\n            if (cfg.enabled === false) return;\n\n            const seed = (cfg.seed ?? 137) + 9999;\n            function mulberry32(a) {\n                return function() {\n                    a |= 0; a = a + 0x6D2B79F5 | 0;\n                    let t = Math.imul(a ^ a >>> 15, 1 | a);\n                    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;\n                    return ((t ^ t >>> 14) >>> 0) / 4294967296;\n                };\n            }\n            const rng = mulberry32(seed);\n            const rand = () => rng();\n            const randRange = (a, b) => a + rand() * (b - a);\n            const pick = arr => arr[Math.floor(rand() * arr.length)];\n\n            // ── Sample track points for collision avoidance ───────────────\n            const TRACK_SAMPLES = 400;\n            const trackPts = [];\n            for (let i = 0; i <= TRACK_SAMPLES; i++) {\n                trackPts.push(trackCurve.getPointAt(i / TRACK_SAMPLES));\n            }\n\n            function distToTrack(center, radius) {\n                let minD = Infinity;\n                for (const p of trackPts) {\n                    const d = center.distanceTo(p);\n                    if (d < minD) minD = d;\n                }\n                return minD - radius;  // negative = intersecting\n            }\n\n            // ── Also check against already-placed planets ────────────────\n            const placedPlanets = [];  // [{center, radius}]\n\n            function overlapsExisting(center, radius) {\n                for (const pp of placedPlanets) {\n                    if (center.distanceTo(pp.center) < radius + pp.radius + 20) return true;\n                }\n                return false;\n            }\n\n            // ── Canvas texture generators ─────────────────────────────────\n            const TEX_SIZE = 512;\n\n            function makeCanvasTexture(drawFn) {\n                const c = document.createElement('canvas');\n                c.width = c.height = TEX_SIZE;\n                const ctx = c.getContext('2d');\n                drawFn(ctx, TEX_SIZE);\n                const tex = new THREE.CanvasTexture(c);\n                tex.wrapS = tex.wrapT = THREE.RepeatWrapping;\n                return tex;\n            }\n\n            // 1. Rocky planet — craters on brownish surface\n            function texRocky(ctx, S) {\n                const base = pick(['#8B7355','#9C8A6E','#7A6B5D','#A09080']);\n                ctx.fillStyle = base;\n                ctx.fillRect(0, 0, S, S);\n                // Noise spots\n                for (let i = 0; i < 800; i++) {\n                    const x = rand() * S, y = rand() * S;\n                    const r = rand() * 4 + 1;\n                    ctx.fillStyle = `rgba(${rand()>0.5?'0,0,0':'255,255,255'},${rand()*0.15})`;\n                    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI*2); ctx.fill();\n                }\n                // Craters\n                const craters = 5 + Math.floor(rand() * 10);\n                for (let i = 0; i < craters; i++) {\n                    const cx = rand() * S, cy = rand() * S, cr = rand() * 30 + 10;\n                    ctx.strokeStyle = `rgba(60,50,40,${0.3+rand()*0.4})`;\n                    ctx.lineWidth = 2 + rand() * 2;\n                    ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI*2); ctx.stroke();\n                    ctx.fillStyle = `rgba(50,40,30,${0.1+rand()*0.15})`;\n                    ctx.beginPath(); ctx.arc(cx, cy, cr*0.7, 0, Math.PI*2); ctx.fill();\n                }\n            }\n\n            // 2. Gas giant — horizontal bands\n            function texGasGiant(ctx, S) {\n                const palettes = [\n                    ['#D4A574','#C4956A','#E8C49A','#A07850','#F0D8B0','#8B6914'],\n                    ['#E8D0A0','#C8A060','#F0E0C0','#B89050','#D0B080','#A08040'],\n                ];\n                const pal = pick(palettes);\n                const bands = 8 + Math.floor(rand() * 8);\n                const bandH = S / bands;\n                for (let i = 0; i < bands; i++) {\n                    ctx.fillStyle = pal[i % pal.length];\n                    ctx.fillRect(0, i * bandH, S, bandH + 1);\n                }\n                // Swirl spots\n                for (let i = 0; i < 3; i++) {\n                    const cx = rand() * S, cy = rand() * S;\n                    const rx = 20 + rand() * 40, ry = 8 + rand() * 15;\n                    ctx.fillStyle = `rgba(180,100,50,${0.2+rand()*0.3})`;\n                    ctx.beginPath(); ctx.ellipse(cx, cy, rx, ry, rand()*0.3, 0, Math.PI*2); ctx.fill();\n                }\n            }\n\n            // 3. Ice planet — white poles, blue middle\n            function texIce(ctx, S) {\n                const grad = ctx.createLinearGradient(0, 0, 0, S);\n                grad.addColorStop(0, '#F0F8FF');\n                grad.addColorStop(0.25, '#B0D4F1');\n                grad.addColorStop(0.5, '#4A90C4');\n                grad.addColorStop(0.75, '#B0D4F1');\n                grad.addColorStop(1, '#F0F8FF');\n                ctx.fillStyle = grad;\n                ctx.fillRect(0, 0, S, S);\n                // Ice cracks\n                for (let i = 0; i < 30; i++) {\n                    ctx.strokeStyle = `rgba(200,230,255,${0.2+rand()*0.3})`;\n                    ctx.lineWidth = 1;\n                    ctx.beginPath();\n                    let x = rand() * S, y = rand() * S;\n                    ctx.moveTo(x, y);\n                    for (let j = 0; j < 4; j++) {\n                        x += randRange(-20, 20); y += randRange(-20, 20);\n                        ctx.lineTo(x, y);\n                    }\n                    ctx.stroke();\n                }\n            }\n\n            // 4. Lava planet — dark with glowing cracks\n            function texLava(ctx, S) {\n                ctx.fillStyle = '#1A0A0A';\n                ctx.fillRect(0, 0, S, S);\n                // Dark rock patches\n                for (let i = 0; i < 500; i++) {\n                    ctx.fillStyle = `rgba(${30+rand()*40},${10+rand()*20},${5+rand()*10},0.4)`;\n                    const x = rand()*S, y = rand()*S, r = rand()*6+1;\n                    ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2); ctx.fill();\n                }\n                // Glowing lava cracks\n                for (let i = 0; i < 25; i++) {\n                    ctx.strokeStyle = pick(['#FF4500','#FF6600','#FF8C00','#FFD700']);\n                    ctx.lineWidth = 1.5 + rand() * 2.5;\n                    ctx.shadowColor = '#FF4500'; ctx.shadowBlur = 8;\n                    ctx.beginPath();\n                    let x = rand()*S, y = rand()*S;\n                    ctx.moveTo(x,y);\n                    for (let j = 0; j < 6; j++) {\n                        x += randRange(-30,30); y += randRange(-30,30);\n                        ctx.lineTo(x,y);\n                    }\n                    ctx.stroke();\n                }\n                ctx.shadowBlur = 0;\n            }\n\n            // 5. Candy planet — colorful spirals\n            function texCandy(ctx, S) {\n                const bg = pick(['#FFB3BA','#BAFFC9','#BAE1FF','#FFFFBA']);\n                ctx.fillStyle = bg;\n                ctx.fillRect(0, 0, S, S);\n                const stripeColors = ['#FF6B9D','#C084FC','#67E8F9','#86EFAC','#FDE68A','#FCA5A5'];\n                const stripes = 10 + Math.floor(rand()*6);\n                for (let i = 0; i < stripes; i++) {\n                    const y = (i / stripes) * S;\n                    const h = S / stripes;\n                    const skew = Math.sin(i * 0.8) * 40;\n                    ctx.fillStyle = stripeColors[i % stripeColors.length];\n                    ctx.beginPath();\n                    ctx.moveTo(skew, y); ctx.lineTo(S + skew, y);\n                    ctx.lineTo(S + skew + 20, y + h); ctx.lineTo(skew + 20, y + h);\n                    ctx.closePath(); ctx.fill();\n                }\n            }\n\n            // 6. Ocean planet — blue-green with cloud swirls\n            function texOcean(ctx, S) {\n                const grad = ctx.createRadialGradient(S*0.4, S*0.4, S*0.1, S*0.5, S*0.5, S*0.7);\n                grad.addColorStop(0, '#0077B6');\n                grad.addColorStop(0.5, '#00B4D8');\n                grad.addColorStop(1, '#023E8A');\n                ctx.fillStyle = grad;\n                ctx.fillRect(0, 0, S, S);\n                // Continents\n                for (let i = 0; i < 5; i++) {\n                    ctx.fillStyle = `rgba(${34+rand()*40},${139+rand()*40},${34+rand()*40},${0.4+rand()*0.3})`;\n                    ctx.beginPath();\n                    const cx = rand()*S, cy = rand()*S;\n                    ctx.arc(cx, cy, 20+rand()*50, 0, Math.PI*2); ctx.fill();\n                }\n                // Cloud wisps\n                for (let i = 0; i < 12; i++) {\n                    ctx.fillStyle = `rgba(255,255,255,${0.15+rand()*0.2})`;\n                    ctx.beginPath();\n                    ctx.ellipse(rand()*S, rand()*S, 30+rand()*60, 5+rand()*10, rand()*Math.PI, 0, Math.PI*2);\n                    ctx.fill();\n                }\n            }\n\n            // 7. Desert planet — sandy with dark features\n            function texDesert(ctx, S) {\n                const grad = ctx.createLinearGradient(0,0,S,S);\n                grad.addColorStop(0, '#E8B86D');\n                grad.addColorStop(0.5, '#D4956B');\n                grad.addColorStop(1, '#C4784A');\n                ctx.fillStyle = grad;\n                ctx.fillRect(0, 0, S, S);\n                // Dark terrain patches\n                for (let i = 0; i < 15; i++) {\n                    ctx.fillStyle = `rgba(120,60,30,${0.15+rand()*0.25})`;\n                    ctx.beginPath();\n                    ctx.ellipse(rand()*S, rand()*S, 15+rand()*50, 10+rand()*30, rand()*Math.PI, 0, Math.PI*2);\n                    ctx.fill();\n                }\n                // Polar ice cap\n                ctx.fillStyle = 'rgba(240,240,255,0.5)';\n                ctx.beginPath(); ctx.ellipse(S*0.5, S*0.05, S*0.35, S*0.05, 0, 0, Math.PI*2); ctx.fill();\n            }\n\n            const texGenerators = [texRocky, texGasGiant, texIce, texLava, texCandy, texOcean, texDesert];\n\n            // ── Create planet mesh ────────────────────────────────────────\n            function createPlanet(center, radius, typeIdx, hasRing) {\n                const geo = new THREE.SphereGeometry(radius, 28, 20);\n                const tex = makeCanvasTexture(texGenerators[typeIdx]);\n                const mat = new THREE.MeshStandardMaterial({\n                    map: tex, roughness: 0.7, metalness: 0.05, fog: false,\n                });\n\n                // Lava planets get slight emissive glow\n                if (typeIdx === 3) {\n                    mat.emissive = new THREE.Color('#331100');\n                    mat.emissiveIntensity = 0.5;\n                }\n\n                const planet = new THREE.Mesh(geo, mat);\n                planet.position.copy(center);\n\n                // Slight axis tilt\n                planet.rotation.x = randRange(-0.3, 0.3);\n                planet.rotation.z = randRange(-0.2, 0.2);\n\n                scene.add(planet);\n\n                const rotSpeed = {\n                    x: randRange(-0.003, 0.003),\n                    y: randRange(0.005, 0.02) * (rand() > 0.5 ? 1 : -1),\n                };\n                proceduralPlanets.push({ mesh: planet, rotSpeed });\n\n                // Optional ring\n                if (hasRing) {\n                    const innerR = radius * 1.3;\n                    const outerR = radius * 1.8 + rand() * radius * 0.5;\n                    const ringGeo = new THREE.RingGeometry(innerR, outerR, 48);\n                    // Simple ring texture\n                    const ringTex = makeCanvasTexture((ctx, S) => {\n                        const grad = ctx.createLinearGradient(0, 0, S, 0);\n                        const c1 = pick(['#D4A574','#A08060','#C0A080','#B0C0D0']);\n                        const c2 = pick(['#E8D0A0','#C8B090','#D0C0B0','#90A0B0']);\n                        grad.addColorStop(0, c1);\n                        grad.addColorStop(0.3, c2);\n                        grad.addColorStop(0.6, c1);\n                        grad.addColorStop(1, c2);\n                        ctx.fillStyle = grad;\n                        ctx.fillRect(0, 0, S, S);\n                        // Ring gaps\n                        for (let i = 0; i < 5; i++) {\n                            const y = rand() * S;\n                            ctx.fillStyle = `rgba(0,0,0,${0.1+rand()*0.2})`;\n                            ctx.fillRect(0, y, S, 2+rand()*4);\n                        }\n                    });\n                    const ringMat = new THREE.MeshStandardMaterial({\n                        map: ringTex, side: THREE.DoubleSide,\n                        transparent: true, opacity: 0.75,\n                        roughness: 0.6, metalness: 0.1, fog: false,\n                    });\n                    const ring = new THREE.Mesh(ringGeo, ringMat);\n                    ring.rotation.x = Math.PI / 2 + randRange(-0.25, 0.25);\n                    planet.add(ring);\n                }\n            }\n\n            // ── Placement: one planet every ~3 stages (4-5 total) ─────────\n            const STAGE_INTERVAL = 3;\n            const MAX_ATTEMPTS = 80;\n            const MIN_TRACK_CLEARANCE = 25;\n\n            // Pick stage anchors: stage 1, 4, 7, 10, 13 ...\n            const anchorStages = [];\n            for (let i = 0; i < trackStages.length; i += STAGE_INTERVAL) {\n                anchorStages.push(trackStages[i]);\n            }\n\n            let placed = 0;\n            for (const st of anchorStages) {\n                const anchorT = st.t;\n                const anchor = trackCurve.getPointAt(Math.min(anchorT, 0.9999));\n                const radius = randRange(50, 80);\n\n                let success = false;\n                for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {\n                    const angle = rand() * Math.PI * 2;\n                    const dist = radius + MIN_TRACK_CLEARANCE + randRange(40, 150);\n                    // Bias upward so planets are visible from the track\n                    const heightOffset = randRange(30, 200);\n\n                    const center = new THREE.Vector3(\n                        anchor.x + Math.cos(angle) * dist,\n                        anchor.y + heightOffset,\n                        anchor.z + Math.sin(angle) * dist\n                    );\n\n                    const clearance = distToTrack(center, radius);\n                    if (clearance < MIN_TRACK_CLEARANCE) continue;\n                    if (overlapsExisting(center, radius)) continue;\n\n                    const typeIdx = Math.floor(rand() * texGenerators.length);\n                    const hasRing = rand() < 0.25;\n\n                    createPlanet(center, radius, typeIdx, hasRing);\n                    placedPlanets.push({ center: center.clone(), radius });\n                    placed++;\n                    success = true;\n                    break;\n                }\n                if (!success) console.warn(`[ProceduralPlanets] Could not place planet near stage ${st.stageId}`);\n            }\n\n            console.log(`[ProceduralPlanets] Placed ${placed} planets near ${anchorStages.length} anchor stages`);\n            for (const pp of placedPlanets) {\n                console.log(`  planet r=${pp.radius.toFixed(0)} pos=(${pp.center.x.toFixed(0)}, ${pp.center.y.toFixed(0)}, ${pp.center.z.toFixed(0)})`);\n            }\n        }\n\n        // ── Planet rotation update (called from animate loop) ─────────\n        function updatePlanetRotations(dt) {\n            for (const p of proceduralPlanets) {\n                p.mesh.rotation.x += p.rotSpeed.x * dt * 60;\n                p.mesh.rotation.y += p.rotSpeed.y * dt * 60;\n            }\n        }\n\n        // ── STAGE PLATFORMS (merged geometry for performance) ────────────\n        function createStagePlatforms() {\n            if (trackStages.length === 0) return;\n\n            // Shared materials across all stages\n            const poleMat   = new THREE.MeshStandardMaterial({color:0xaaaaaa, metalness:0.4, roughness:0.5});\n            const boardMat  = new THREE.MeshStandardMaterial({color:0x1a1a2e, roughness:0.85});\n            const textMat   = new THREE.MeshStandardMaterial({color:0xFFD740, roughness:0.6});\n            const trackMat  = new THREE.MeshStandardMaterial({color:0x2a333d, roughness:0.9});\n            const frameMat  = new THREE.MeshStandardMaterial({color:0x111111, roughness:0.6, metalness:0.4});\n            const yellowMat = new THREE.MeshStandardMaterial({color:0xFFCC00, roughness:0.7});\n            const concreteMat = new THREE.MeshStandardMaterial({color:0xd0d0d0, roughness:0.92});\n            const roofMat   = new THREE.MeshStandardMaterial({color:0xc8c8c8, roughness:0.5, metalness:0.1});\n\n            const COL_H = 10.0, COL_W = 1.0;\n            const BEAM_W = 5 * COL_W, BEAM_H = COL_W;\n            const RISE = 4.0, THICK = 0.15;\n            const POLE_H = config.signPoleHeight || 5.5, LETTER_SIZE = 0.18;\n\n            // Helper: bake a mesh's geometry into world space of its parent group\n            const _m4 = new THREE.Matrix4();\n            function bakeGeometry(geo, position, rotation) {\n                const g = geo.clone();\n                _m4.makeRotationFromEuler(new THREE.Euler(rotation?.x||0, rotation?.y||0, rotation?.z||0));\n                _m4.setPosition(position.x||0, position.y||0, position.z||0);\n                g.applyMatrix4(_m4);\n                return g;\n            }\n\n            for (const st of trackStages) {\n                const t = st.t;\n                const pos = trackCurve.getPointAt(t);\n                const tan = trackCurve.getTangentAt(t).normalize();\n                const up  = new THREE.Vector3(0,1,0);\n                const right = new THREE.Vector3().crossVectors(tan,up).normalize();\n\n                const pf = st;\n                const W = pf.platformWidth  || 18;\n                const WR = W / 2;\n                const H = pf.platformHeight || 0.5;\n                const L = pf.platformLength || 50;\n                const TW = pf.trackBedWidth  || 2.8;\n                const SI = pf.stripeInset    || 0.15;\n                const canopy = pf.canopyType || 'full';\n                const stageId = pf.stageId || 1;\n                const walkwayY = -(H/2 + 0.30);\n                const walkwayTopY = walkwayY + H/2;\n                const leftX  = -(TW/2 + W/2);\n                const rightX = TW/2 + WR/2;\n                const showLeft  = canopy==='full' || canopy==='left';\n                const showRight = canopy==='full' || canopy==='right';\n\n                const group = new THREE.Group();\n                const m = new THREE.Matrix4().makeBasis(right, up, tan.clone().negate());\n                m.setPosition(pos);\n                group.applyMatrix4(m);\n                scene.add(group);\n                cullStageGroups.push({ obj: group, pos: pos.clone() });\n\n                // Collect geometries by material for merging\n                const concreteGeos = [];\n                const poleGeos = [];\n                const trackGeos = [];\n                const yellowGeos = [];\n                const frameGeos = [];\n                const boardGeos = [];\n                const roofGeos = [];\n\n                // Walkways\n                concreteGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(W, H, L), {x:leftX, y:walkwayY, z:0}, {}));\n                concreteGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(WR, H, L), {x:rightX, y:walkwayY, z:0}, {}));\n\n                // Edge barriers\n                poleGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(0.15, 0.4, L), {x:leftX-W/2-0.075, y:-0.25, z:0}, {}));\n                poleGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(0.15, 0.4, L), {x:rightX+WR/2+0.075, y:-0.25, z:0}, {}));\n\n                // Track bed\n                trackGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(TW, 0.12, L), {x:0, y:-0.71, z:0}, {}));\n\n                // Yellow warning stripes\n                const STRIPE_W = 1.4, STRIPE_H = 0.015;\n                yellowGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(STRIPE_W, STRIPE_H, L),\n                    {x:-(TW/2+SI+STRIPE_W/2), y:walkwayTopY+STRIPE_H/2+0.001, z:0}, {}));\n                yellowGeos.push(bakeGeometry(\n                    new THREE.BoxGeometry(STRIPE_W, STRIPE_H, L),\n                    {x:TW/2+SI+STRIPE_W/2, y:walkwayTopY+STRIPE_H/2+0.001, z:0}, {}));\n\n                // T-frame canopy supports (buildTFrame returns a merged mesh, extract its geometry)\n                const leftOuterX  = -(TW/2 + W);\n                const rightOuterX = TW/2 + WR;\n                const N_FRAMES = 4;\n                const zStart = -L/2 + 5, zEnd = L/2 - 5;\n                const frameZs = Array.from({length:N_FRAMES}, (_, i) => zStart + i*(zEnd-zStart)/(N_FRAMES-1));\n                const addFrameGeos = (frameX) => {\n                    frameZs.forEach(fz => {\n                        const f = buildTFrame(COL_H, COL_W, BEAM_W, BEAM_H, frameMat);\n                        // buildTFrame returns a Mesh with merged geometry — bake its position+rotation\n                        const g = f.geometry.clone();\n                        _m4.makeRotationY(Math.PI / 2);\n                        _m4.setPosition(frameX, walkwayTopY, fz);\n                        g.applyMatrix4(_m4);\n                        frameGeos.push(g);\n                    });\n                };\n                if (showLeft)  addFrameGeos(leftOuterX + 2.0);\n                if (showRight) addFrameGeos(rightOuterX - 2.0);\n\n                // Canopy roof panels\n                const Y_base = walkwayTopY + COL_H + BEAM_H + 2.0;\n                const addRoofGeo = (xLow, xHigh, panelW, rise, rotSign) => {\n                    const slopeLen = Math.sqrt(panelW*panelW + rise*rise);\n                    const alpha = Math.atan2(rise, panelW);\n                    const g = new THREE.BoxGeometry(slopeLen, THICK, L);\n                    _m4.makeRotationZ(rotSign * alpha);\n                    _m4.setPosition((xLow+xHigh)/2, Y_base, 0);\n                    g.applyMatrix4(_m4);\n                    roofGeos.push(g);\n                };\n                if (showLeft)  addRoofGeo(leftOuterX, -TW/2, W, RISE, 1);\n                if (showRight) addRoofGeo(TW/2, rightOuterX, WR, WR*(RISE/W), -1);\n\n                // Sign arch poles + bars + boards\n                const POLE_SPREAD = Math.max(3.0, TW/2 + W + 0.3) / 3;\n                const BOARD_W = POLE_SPREAD*2 - 0.3, BOARD_H = 1.5;\n                const addArchGeos = (signZ) => {\n                    [-POLE_SPREAD, POLE_SPREAD].forEach(x => {\n                        poleGeos.push(bakeGeometry(\n                            new THREE.CylinderGeometry(0.1, 0.12, POLE_H, 6),\n                            {x:x, y:POLE_H/2-0.3, z:signZ}, {}));\n                    });\n                    poleGeos.push(bakeGeometry(\n                        new THREE.BoxGeometry(POLE_SPREAD*2+0.2, 0.22, 0.22),\n                        {x:0, y:POLE_H-0.3, z:signZ}, {}));\n                    boardGeos.push(bakeGeometry(\n                        new THREE.BoxGeometry(BOARD_W, BOARD_H, 0.12),\n                        {x:0, y:POLE_H-0.3-BOARD_H/2-0.12, z:signZ+0.06}, {}));\n                };\n                addArchGeos(L/2);\n                addArchGeos(-L/2);\n\n                // Stage text (already merged by createBlockText)\n                const addText = (signZ) => {\n                    const label = `STAGE ${stageId}`;\n                    const tg = createBlockText(label, textMat, LETTER_SIZE);\n                    const tw = textWidth(label, LETTER_SIZE);\n                    const th = 5 * (LETTER_SIZE + LETTER_SIZE*0.18);\n                    tg.position.set(-tw/2, POLE_H - 0.3 - BOARD_H + (BOARD_H - th)/2 - 0.05, signZ + 0.13);\n                    group.add(tg);  // text stays as individual mesh (unique per stage)\n                };\n                addText(L/2);\n                addText(-L/2);\n\n                // ── Merge and add to group ─────────────────────────────\n                const mergeAndAdd = (geos, mat) => {\n                    if (geos.length === 0) return;\n                    const merged = mergeBufferGeometries(geos);\n                    group.add(new THREE.Mesh(merged, mat));\n                };\n                mergeAndAdd(concreteGeos, concreteMat);\n                mergeAndAdd(poleGeos, poleMat);\n                mergeAndAdd(trackGeos, trackMat);\n                mergeAndAdd(yellowGeos, yellowMat);\n                mergeAndAdd(frameGeos, frameMat);\n                mergeAndAdd(boardGeos, boardMat);\n                mergeAndAdd(roofGeos, roofMat);\n            }\n        }\n\n        // ── createFinishLine() ───────────────────────────────────────────────\n\n        // ── GAME CONSTANTS (mirrors PlayCoasterScript.cs) ────────────────────\n        const RCT2_SPEED_SCALE = 0.65;\n        const MAX_SPEED = config.maxSpeed || 41.7;          // absolute max (~150 km/h)\n        const ACCEL_MAX_SPEED = config.accelMaxSpeed || 36.1; // accel-only max (~130 km/h)\n        const MIN_SPEED = 0;\n        const ACCEL = config.accelForce || 15;\n        const BRAKE_F = config.brakeForce || 22;\n        const GRAVITY_SC = config.gravitySC || 20;\n        const FRICTION = config.frictionCoefficient || 0.006; // proportional drag per frame\n        const IDLE_DRAG = config.idleDrag || 4;               // constant decel (m/s²) when not accelerating\n\n        // ── FINISH LINE BARRIER ──────────────────────────────────────────\n        // A checkered arch gate placed at the last stage's t position,\n        // so the player can clearly see where the finish line is.\n        function createFinishBarrier() {\n            if (trackStages.length === 0 || !trackCurve) return;\n\n            const lastStage = trackStages[trackStages.length - 1];\n            const t = Math.max(0, Math.min(0.9999, lastStage.t));\n            const { pt, tan, right, up } = getGameFrame(t);\n\n            const group = new THREE.Group();\n            group.position.copy(pt);\n\n            // Orient: forward = tangent, up = up\n            const lookM = new THREE.Matrix4().makeBasis(right, up, tan);\n            group.quaternion.setFromRotationMatrix(lookM);\n\n            // ── Two vertical poles ──\n            const POLE_H = 6.5;\n            const POLE_R = 0.15;\n            const GATE_W = 3.5; // half-width from center\n            const poleMat = new THREE.MeshStandardMaterial({ color: 0xeeeeee, roughness: 0.4, metalness: 0.3 });\n            const poleGeo = new THREE.CylinderGeometry(POLE_R, POLE_R, POLE_H, 8);\n\n            const poleL = new THREE.Mesh(poleGeo, poleMat);\n            poleL.position.set(-GATE_W, POLE_H / 2, 0);\n            group.add(poleL);\n\n            const poleR = new THREE.Mesh(poleGeo, poleMat);\n            poleR.position.set(GATE_W, POLE_H / 2, 0);\n            group.add(poleR);\n\n            // ── Top crossbar ──\n            const BAR_H = 1.2;\n            const BAR_W = GATE_W * 2;\n            const BAR_D = 0.3;\n\n            // Checkered texture for crossbar\n            const SIZE = 256;\n            const GRID = 8;\n            const CELL = SIZE / GRID;\n            const c = document.createElement('canvas');\n            c.width = SIZE; c.height = SIZE;\n            const ctx = c.getContext('2d');\n            for (let row = 0; row < GRID; row++) {\n                for (let col = 0; col < GRID; col++) {\n                    ctx.fillStyle = (row + col) % 2 === 0 ? '#111111' : '#ffffff';\n                    ctx.fillRect(col * CELL, row * CELL, CELL, CELL);\n                }\n            }\n            const checkerTex = new THREE.CanvasTexture(c);\n            checkerTex.wrapS = checkerTex.wrapT = THREE.RepeatWrapping;\n            checkerTex.repeat.set(4, 1);\n\n            const barMat = new THREE.MeshStandardMaterial({ map: checkerTex, roughness: 0.5, metalness: 0.1 });\n            const barGeo = new THREE.BoxGeometry(BAR_W, BAR_H, BAR_D);\n            const bar = new THREE.Mesh(barGeo, barMat);\n            bar.position.set(0, POLE_H - BAR_H / 2, 0);\n            group.add(bar);\n\n            // ── \"FINISH\" text banner (simple colored strip below crossbar) ──\n            const bannerMat = new THREE.MeshStandardMaterial({ color: 0xff2222, roughness: 0.6, metalness: 0.1 });\n            const bannerGeo = new THREE.BoxGeometry(BAR_W * 0.8, 0.5, BAR_D + 0.05);\n            const banner = new THREE.Mesh(bannerGeo, bannerMat);\n            banner.position.set(0, POLE_H - BAR_H - 0.35, 0);\n            group.add(banner);\n\n            // ── Small base blocks for poles ──\n            const baseMat = new THREE.MeshStandardMaterial({ color: 0x888888, roughness: 0.7, metalness: 0.2 });\n            const baseGeo = new THREE.BoxGeometry(0.6, 0.3, 0.6);\n            const baseL = new THREE.Mesh(baseGeo, baseMat);\n            baseL.position.set(-GATE_W, 0.15, 0);\n            group.add(baseL);\n            const baseR = new THREE.Mesh(baseGeo, baseMat);\n            baseR.position.set(GATE_W, 0.15, 0);\n            group.add(baseR);\n\n            scene.add(group);\n        }\n\n        // ── CART & CHARACTER ─────────────────────────────────────────────\n        let cartGroup, charArmL, charArmR, charHead, charRoot;\n        let crownContainer = null;\n        const crownMeshes = [];       // [{mesh, smoothTiltZ, smoothTiltX}]\n        const CROWN_HEIGHT = 0.14;    // height of each crown\n        const CROWN_STACK_GAP = 0.02; // gap between stacked crowns\n\n        function createCartAndCharacter() {\n            cartGroup = new THREE.Group();\n            const cartColor=new THREE.Color(config.cartColor||'#e53935');\n            const bodyMat =new THREE.MeshStandardMaterial({color:cartColor,metalness:0.5,roughness:0.4});\n            const darkMat =new THREE.MeshStandardMaterial({color:0x222222,metalness:0.3,roughness:0.6});\n            const metalMat=new THREE.MeshStandardMaterial({color:0x888888,metalness:0.9,roughness:0.2});\n            const yMat    =new THREE.MeshStandardMaterial({color:0xffd740,metalness:0.6,roughness:0.3});\n            const shell=new THREE.Mesh(new THREE.BoxGeometry(1.6,0.65,2.4),bodyMat); shell.position.y=0.5; cartGroup.add(shell);\n            const nose=new THREE.Mesh(new THREE.BoxGeometry(1.4,0.5,0.6),bodyMat); nose.position.set(0,0.42,1.5); cartGroup.add(nose);\n            const rim=new THREE.Mesh(new THREE.BoxGeometry(1.5,0.12,2.2),metalMat); rim.position.set(0,0.86,0.1); cartGroup.add(rim);\n            const seat=new THREE.Mesh(new THREE.BoxGeometry(1.1,0.15,1.2),darkMat); seat.position.set(0,0.87,-0.1); cartGroup.add(seat);\n            const bar=new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.04,1.2,8),yMat); bar.rotation.z=Math.PI/2; bar.position.set(0,1.05,0.45); cartGroup.add(bar);\n            [[-0.85,0.25,0.8],[0.85,0.25,0.8],[-0.85,0.25,-0.8],[0.85,0.25,-0.8]].forEach(([x,y,z])=>{\n                const w=new THREE.Mesh(new THREE.CylinderGeometry(0.28,0.28,0.12,14),darkMat); w.rotation.z=Math.PI/2; w.position.set(x,y,z); cartGroup.add(w);\n                const h2=new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.09,0.14,8),metalMat); h2.rotation.z=Math.PI/2; h2.position.set(x,y,z); cartGroup.add(h2);\n            });\n            [-0.82,0.82].forEach(x=>{ const p=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.4,1.9),darkMat); p.position.set(x,0.42,-0.05); cartGroup.add(p); });\n            // Character\n            const skinMat=new THREE.MeshStandardMaterial({color:0xffcc99,roughness:0.8});\n            const shirtMat=new THREE.MeshStandardMaterial({color:0x1565c0,roughness:0.8});\n            const pantsMat=new THREE.MeshStandardMaterial({color:0x37474f,roughness:0.8});\n            const hairMat=new THREE.MeshStandardMaterial({color:0x4a2500,roughness:0.9});\n            const root=new THREE.Group(); root.position.set(0,0.92,-0.2); cartGroup.add(root);\n            charRoot = root;\n            const bodyMesh=new THREE.Mesh(new THREE.BoxGeometry(0.52,0.55,0.3),shirtMat); root.add(bodyMesh);\n            charHead=new THREE.Mesh(new THREE.BoxGeometry(0.38,0.38,0.36),skinMat); charHead.position.y=0.5; root.add(charHead);\n            const hair=new THREE.Mesh(new THREE.BoxGeometry(0.4,0.1,0.38),hairMat); hair.position.set(0,0.7,0); root.add(hair);\n            [-0.16,0.16].forEach(x=>{ const l=new THREE.Mesh(new THREE.BoxGeometry(0.18,0.1,0.38),pantsMat); l.position.set(x,-0.28,0.18); root.add(l); });\n            const armGeo=new THREE.BoxGeometry(0.16,0.46,0.16);\n            const pL=new THREE.Group(); pL.position.set(-0.36,0.12,0); root.add(pL);\n            const armLm=new THREE.Mesh(armGeo,shirtMat); armLm.position.y=-0.23; pL.add(armLm);\n            charArmL=pL;\n            const pR=new THREE.Group(); pR.position.set(0.36,0.12,0); root.add(pR);\n            const armRm=new THREE.Mesh(armGeo,shirtMat); armRm.position.y=-0.23; pR.add(armRm);\n            charArmR=pR;\n            const eyeMat=new THREE.MeshStandardMaterial({color:0x111111});\n            [-0.08,0.08].forEach(x=>{ const e=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.06,0.06),eyeMat); e.position.set(x,0.5,0.19); root.add(e); });\n\n            // Crown container — attached to head, crowns stack here\n            crownContainer = new THREE.Group();\n            crownContainer.position.set(0, 0.22, 0); // just above top of head\n            charHead.add(crownContainer);\n\n            scene.add(cartGroup);\n        }\n\n        // ── CROWN SYSTEM ─────────────────────────────────────────────────\n        // Each crown is a small golden geometry stacked on the character's head.\n        // Crowns tilt with a spring-like lag behind the body lean for natural feel.\n\n        let _crownGeo = null;\n        const _crownMat = new THREE.MeshStandardMaterial({\n            color: 0xFFD700, metalness: 0.7, roughness: 0.25,\n            emissive: 0x332800, emissiveIntensity: 0.3,\n        });\n\n        function getCrownGeometry() {\n            if (_crownGeo) return _crownGeo;\n\n            // Simple crown: a band with 5 pointed tips\n            // Built from a cylinder base + 5 small pyramid tips on top\n            const geos = [];\n\n            // Band (short wide cylinder)\n            const band = new THREE.CylinderGeometry(0.15, 0.16, CROWN_HEIGHT * 0.5, 8);\n            band.translate(0, CROWN_HEIGHT * 0.25, 0);\n            geos.push(band);\n\n            // 5 pointed tips around the top edge\n            const tipGeo = new THREE.ConeGeometry(0.04, CROWN_HEIGHT * 0.6, 4);\n            for (let i = 0; i < 5; i++) {\n                const angle = (i / 5) * Math.PI * 2;\n                const g = tipGeo.clone();\n                g.translate(\n                    Math.cos(angle) * 0.12,\n                    CROWN_HEIGHT * 0.5 + CROWN_HEIGHT * 0.3,\n                    Math.sin(angle) * 0.12\n                );\n                geos.push(g);\n            }\n\n            // Gem on top center\n            const gem = new THREE.OctahedronGeometry(0.04);\n            gem.translate(0, CROWN_HEIGHT * 0.5 + CROWN_HEIGHT * 0.15, 0);\n            geos.push(gem);\n\n            _crownGeo = mergeBufferGeometries(geos);\n            return _crownGeo;\n        }\n\n        function addCrown(animated = true) {\n            if (!crownContainer) return;\n            const geo = getCrownGeometry();\n            const mesh = new THREE.Mesh(geo, _crownMat);\n\n            // Target stack position\n            const stackY = crownMeshes.length * (CROWN_HEIGHT + CROWN_STACK_GAP);\n\n            if (animated) {\n                // Start high above and fall down with bounce\n                const dropHeight = 3.0;\n                mesh.position.y = stackY + dropHeight;\n                mesh.rotation.y = Math.PI * 2; // spin during fall\n                crownContainer.add(mesh);\n\n                const entry = { mesh, smoothTiltZ: 0, smoothTiltX: 0, dropping: true };\n                crownMeshes.push(entry);\n\n                const duration = 600;\n                const startTime = performance.now();\n                const startY = stackY + dropHeight;\n\n                function animDrop(now) {\n                    const elapsed = now - startTime;\n                    const p = Math.min(1, elapsed / duration);\n\n                    // Ease: bounce out\n                    let ease;\n                    if (p < 0.6) {\n                        // Fast fall\n                        ease = 1 - Math.pow(1 - p / 0.6, 2);\n                    } else if (p < 0.8) {\n                        // First bounce up\n                        const bp = (p - 0.6) / 0.2;\n                        ease = 1 - Math.sin(bp * Math.PI) * 0.15;\n                    } else {\n                        // Settle\n                        const bp = (p - 0.8) / 0.2;\n                        ease = 1 - Math.sin(bp * Math.PI) * 0.05;\n                    }\n\n                    mesh.position.y = startY + (stackY - startY) * ease;\n                    // Spin slows down as it lands\n                    mesh.rotation.y = Math.PI * 2 * (1 - p);\n                    // Scale: slight squash on landing\n                    if (p > 0.55 && p < 0.7) {\n                        const squash = 1 + Math.sin((p - 0.55) / 0.15 * Math.PI) * 0.2;\n                        mesh.scale.set(squash, 1 / squash, squash);\n                    } else {\n                        mesh.scale.set(1, 1, 1);\n                    }\n\n                    if (p < 1) {\n                        requestAnimationFrame(animDrop);\n                    } else {\n                        mesh.position.y = stackY;\n                        mesh.rotation.y = 0;\n                        mesh.scale.set(1, 1, 1);\n                        entry.dropping = false;\n                    }\n                }\n                requestAnimationFrame(animDrop);\n            } else {\n                // Instant placement (for Continue restore)\n                mesh.position.y = stackY;\n                crownContainer.add(mesh);\n                crownMeshes.push({ mesh, smoothTiltZ: 0, smoothTiltX: 0, dropping: false });\n            }\n        }\n\n        function updateCrowns(dt) {\n            if (crownMeshes.length === 0) return;\n\n            const bodyLeanZ = charRoot ? charRoot.rotation.z : 0;\n            const bodyPitchX = charRoot ? charRoot.rotation.x : 0;\n\n            for (let i = 0; i < crownMeshes.length; i++) {\n                const c = crownMeshes[i];\n                if (c.dropping) continue; // don't tilt while falling\n                // Higher crowns have more lag (softer spring) — feels like a wobbly stack\n                const springRate = Math.max(0.8, 2.5 - i * 0.3);\n                const overshoot = 1.3 + i * 0.15; // higher crowns overshoot more\n\n                const targetZ = bodyLeanZ * overshoot;\n                const targetX = bodyPitchX * overshoot;\n\n                c.smoothTiltZ += (targetZ - c.smoothTiltZ) * Math.min(1, springRate * dt);\n                c.smoothTiltX += (targetX - c.smoothTiltX) * Math.min(1, springRate * dt);\n\n                c.mesh.rotation.z = c.smoothTiltZ;\n                c.mesh.rotation.x = c.smoothTiltX;\n            }\n        }\n\n        function clearCrowns() {\n            for (const c of crownMeshes) {\n                if (c.mesh.parent) c.mesh.parent.remove(c.mesh);\n            }\n            crownMeshes.length = 0;\n        }\n\n        // ── SPEED LINES ──────────────────────────────────────────────────\n        let slCtx, slW=0, slH=0;\n        // Speed lines — reduced count, no per-frame gradient creation\n        const LINE_DATA=Array.from({length:20},(_,i)=>({\n            angle:(i/20)*Math.PI*2+(Math.random()-0.5)*0.25,\n            phase:Math.random()*Math.PI*2,\n            lenFac:0.12+Math.random()*0.18,\n            widthFac:0.6+Math.random()*0.8,\n            bright:0.7+Math.random()*0.3\n        }));\n        function resizeSpeedCanvas() { slW=slCanvas.width=canvas.clientWidth; slH=slCanvas.height=canvas.clientHeight; }\n        let _slFrameSkip = 0;\n        function drawSpeedLines(ratio,time) {\n            if (!slCtx||slW===0) return;\n            slCtx.clearRect(0,0,slW,slH);\n            // Draw every other frame on mobile\n            _slFrameSkip++;\n            if (_slFrameSkip % 2 !== 0) return;\n            const op=Math.max(0,(ratio-0.35)*1.2); if (op<=0) return;\n            const cx=slW/2,cy=slH/2,mx=Math.sqrt(cx*cx+cy*cy);\n            for (const ld of LINE_DATA) {\n                const t=((time*ratio*4.5+ld.phase)%(Math.PI*2))/(Math.PI*2);\n                const startR = 0.35 + (1-ratio)*0.2;\n                const iR=mx*(startR+t*0.45);\n                const oR=Math.min(iR+mx*ld.lenFac*(0.6+ratio*0.8),mx*0.98);\n                if (iR>=mx*0.98) continue;\n                const x1=cx+Math.cos(ld.angle)*iR,y1=cy+Math.sin(ld.angle)*iR;\n                const x2=cx+Math.cos(ld.angle)*oR,y2=cy+Math.sin(ld.angle)*oR;\n                const a = op * ld.bright;\n                // Simple rgba instead of per-frame gradient creation\n                slCtx.strokeStyle=`rgba(240,248,255,${Math.min(a*0.5,0.6)})`;\n                slCtx.lineWidth=1.0+ratio*1.8*ld.widthFac;\n                slCtx.beginPath(); slCtx.moveTo(x1,y1); slCtx.lineTo(x2,y2); slCtx.stroke();\n            }\n        }\n\n        // ── GAME STATE ───────────────────────────────────────────────────\n        let gameState='start', trackProgress=0, speed=0, elapsedTime=0;\n        let cameraMode='third', isAccel=false, isBrake=false, gameTime=0, camFov=65;\n\n        // ── DERAIL SYSTEM (per-segment overspeed only) ───────────────────────\n        let isDerailed     = false;\n        let derailVelocity = new THREE.Vector3();\n        let derailTimer    = 0;\n        let segmentOverspeedTime = 0;\n        let prevSegmentIdx = -1;\n        let smoothCamLoopWeight = 0;  // smoothed loop weight for camera (0=3D follow, 1=horizontal)\n        let smoothCamDir = null;      // smoothed camera offset direction (unit vector from cart to camera)\n        let derailLookTarget = new THREE.Vector3();  // smoothed look-at target for derail camera\n        let cameraLookTarget = new THREE.Vector3();  // smoothed look-at target for normal camera\n        const DERAIL_RESPAWN_TIME = 3.0;\n        let stationBrakedFlags = [];  // per-stage: true = already braked once, don't brake again\n        let stationBrakeTimer = 0;    // seconds elapsed since station braking started\n\n        // ── STAGE CHECKPOINT ──────────────────────────────────────────────\n        function checkStageCheckpoints() {\n            if (trackStages.length === 0) return;\n            const curT = Math.max(0, Math.min(trackProgress, 0.9999));\n            for (let i = 0; i < trackStages.length; i++) {\n                // Trigger at stage entrance (tStart) instead of center (t)\n                const triggerT = trackStages[i].tStart ?? trackStages[i].t;\n                if (!stageReachedFlags[i] && curT >= triggerT) {\n                    stageReachedFlags[i] = true;\n                    completedStages = Math.max(completedStages, trackStages[i].stageId);\n                    saveProgress();\n                    // Stage 1 is the starting point — no celebration\n                    if (trackStages[i].stageId > 1) {\n                        showStageToast(trackStages[i].stageId);\n                        addCrown();\n                    }\n                }\n            }\n        }\n\n        // Respawn at the last reached stage, or track start if none\n        function respawnAtCheckpoint() {\n            let bestT = 0;\n            for (let i = 0; i < trackStages.length; i++) {\n                if (stageReachedFlags[i]) {\n                    bestT = trackStages[i].t;\n                }\n            }\n            trackProgress = Math.max(0, Math.min(0.9999, bestT));\n            speed = 0;\n            segmentOverspeedTime = 0;\n            prevSegmentIdx = -1;\n            prevTangent = null; smoothTurnRate = 0; smoothSlopePitch = 0;\n            placeCart(); snapCamera();\n        }\n\n        // ── PERSISTENT STATE ─────────────────────────────────────────────\n        let completedStages = 0;       // 0 = not reached stage 1 yet\n        let accumulatedTime = 0;       // cumulative play time across sessions (seconds)\n        let savedBestTime   = null;    // best finish time ever (seconds), null = never finished\n        let stageReachedFlags = [];    // per-stage reached boolean\n        let stageTPositions = [];      // t-value for each stage's respawn point\n\n        async function loadProgress() {\n            try {\n                const res = await lib.getUserGameState();\n                if (res?.state) {\n                    if (res.state.completedStages != null) completedStages = res.state.completedStages;\n                    if (res.state.accumulatedTime != null) accumulatedTime = res.state.accumulatedTime;\n                    if (res.state.bestTime != null)        savedBestTime   = res.state.bestTime;\n                }\n            } catch(e) {}\n        }\n        async function saveProgress() {\n            try {\n                await lib.saveUserGameState({\n                    completedStages,\n                    accumulatedTime: elapsedTime,\n                    bestTime: savedBestTime\n                });\n            } catch(e) {}\n        }\n        async function clearProgress() {\n            completedStages = 0;\n            accumulatedTime = 0;\n            savedBestTime   = null;\n            stageReachedFlags = trackStages.map(() => false);\n            stationBrakedFlags = trackStages.map(() => false);\n            try { await lib.deleteUserGameState(); } catch(e) {}\n        }\n\n        // ── UI ───────────────────────────────────────────────────────────\n        let timerEl, speedEl, stageEl, progressFillEl;\n        let startScreenEl, finishScreenEl, checkpointDisplayEl, stageToastEl;\n        let finishTimeEl, newBestEl, lbEl;\n\n        function formatTime(s) {\n            const m=Math.floor(s/60),sc=Math.floor(s%60),cs=Math.floor((s%1)*100);\n            return `${m}:${String(sc).padStart(2,'0')}.${String(cs).padStart(2,'0')}`;\n        }\n\n        function createUI() {\n            uiOverlay.innerHTML='';\n            timerEl=document.createElement('div'); timerEl.className='timer'; timerEl.textContent='0:00.00'; uiOverlay.appendChild(timerEl);\n            const sb=document.createElement('div'); sb.className='speed-display';\n            sb.innerHTML='<span class=\"speed-value\" id=\"spd\">0</span><span class=\"speed-unit\">km/h</span>';\n            uiOverlay.appendChild(sb); speedEl=sb.querySelector('#spd');\n            const camBtn=document.createElement('div'); camBtn.className='btn-camera';\n            camBtn.innerHTML='<div class=\"cam-label\" id=\"cam-label\">🎥<br>3rd</div>';\n            camBtn.addEventListener('pointerdown',e=>{e.stopPropagation();ensureAudio();toggleCamera();}); uiOverlay.appendChild(camBtn);\n            if (config.showProgressBar!==false) {\n                const pw=document.createElement('div'); pw.className='stage-progress'; pw.id='stage-progress';\n                pw.innerHTML=`<div class=\"stage-progress-label\" id=\"sp-label\">1 / 