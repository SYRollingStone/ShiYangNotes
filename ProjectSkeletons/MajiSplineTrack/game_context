< 0) n.negate();\n                    m.normal.add(n).normalize();\n                }\n            }\n\n            return merged;\n        }\n\n\n        function vector3FromConfigValue(v) {\n            if (!v) return null;\n            if (Array.isArray(v) && v.length >= 3) {\n                const out = new THREE.Vector3(Number(v[0]), Number(v[1]), Number(v[2]));\n                return safeNormalizeOrNull(out);\n            }\n            if (typeof v === 'object' && v.x !== undefined && v.y !== undefined && v.z !== undefined) {\n                const out = new THREE.Vector3(Number(v.x), Number(v.y), Number(v.z));\n                return safeNormalizeOrNull(out);\n            }\n            return null;\n        }\n\n        function computeCurveAnglesForTangents(tangents) {\n            const out = new Array(tangents.length).fill(0);\n            for (let i = 1; i < tangents.length - 1; i++) {\n                const c = THREE.MathUtils.clamp(tangents[i - 1].dot(tangents[i + 1]), -1, 1);\n                out[i] = Math.acos(c);\n            }\n            return out;\n        }\n\n        function estimateLoopPlaneNormalForSamples(s, e, N, tangents, explicitNormal = null) {\n            s = THREE.MathUtils.clamp(Math.round(s), 0, N);\n            e = THREE.MathUtils.clamp(Math.round(e), 0, N);\n            if (e < s) { const tmp = s; s = e; e = tmp; }\n\n            let normal = explicitNormal ? explicitNormal.clone() : new THREE.Vector3();\n\n            if (!explicitNormal) {\n                const curveAng = computeCurveAnglesForTangents(tangents);\n                for (let j = s; j < e; j++) {\n                    const a = tangents[j];\n                    const b = tangents[j + 1];\n                    const c = new THREE.Vector3().crossVectors(a, b);\n                    const sin = c.length();\n                    const localCurve = Math.max(curveAng[j] || 0, curveAng[j + 1] || 0);\n\n                    // Use only samples that are actually turning. Thi