\n                if (sm.merged) continue;  // merged meshes are always visible\n                for (const m of sm.meshes) m.visible = true;\n            }\n\n            // Find which segment the cart is currently in\n            const curT = trackProgress;\n            let curSegIdx = -1;\n            for (let i = 0; i < trackSegMeshes.length; i++) {\n                if (trackSegMeshes[i].merged) continue;\n                if (curT >= trackSegMeshes[i].tStart && curT <= trackSegMeshes[i].tEnd) {\n                    curSegIdx = i; break;\n                }\n            }\n            if (curSegIdx < 0) return;\n\n            // For each conflict pair that involves the current segment, hide the other\n            for (const cp of trackConflicts) {\n                if (cp.segA === curSegIdx) {\n                    for (const m of trackSegMeshes[cp.segB].meshes) m.visible = false;\n                } else if (cp.segB === curSegIdx) {\n                    for (const m of trackSegMeshes[cp.segA].meshes) m.visible = false;\n                }\n            }\n        }\n\n        // ══════════════════════════════════════════════════════════════════\n        // DISTANCE CULLING SYSTEM\n        // Hides distant objects to reduce draw calls while keeping\n        // the track rails always visible for the \"long track\" visual appeal.\n        // ══════════════════════════════════════════════════════════════════\n        const CULL_STAGE_DIST    = 500;   // stage platforms\n        const CULL_SIGN_DIST     = 300;   // speed limit signs\n        const CULL_PROCDECO_DIST = 350;   // procedural decorations\n        const CULL_JSONDECO_DIST = 350;   // JSON decorations (cubes, planes, rubiks)\n        const CULL_UPDATE_INTERVAL = 6;   // update every N frames (not every frame)\n\n        // Collected references: { obj: Object3D, pos: Vector3 }\n        const cullStageGroups  = [];\n        const cullSignGroups   = [];\n        const cullJsonDecos    = [];\n        let _cachedProc