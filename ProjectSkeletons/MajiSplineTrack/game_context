s() {\n            if (!config.prefabs) config.prefabs = {};\n            if (!config.prefabs.Stage) config.prefabs.Stage = {\n                stageId: 2, platformWidth: 18, platformHeight: 0.5,\n                platformLength: 50, trackBedWidth: 2.8, stripeInset: 0.15, canopyType: 'full'\n            };\n            if (!config.worldStages) {\n                const plats = config.platforms || [];\n                config.worldStages = plats.sort((a,b)=>a.stageId-b.stageId).map(p => {\n                    const pos = p.transform?.position || { x: 0, y: 0, z: 0 };\n                    const rot = p.transform?.rotation || { x: 0, y: 0, z: 0 };\n                    return {\n                        position: [pos.x, pos.y, pos.z],\n                        rotation: [rot.x, rot.y, rot.z],\n                        stageId: p.stageId || 1\n                    };\n                });\n            }\n            if (!config.editorPage) config.editorPage = 'ObjectPage';\n            if (!config.editorObjType) config.editorObjType = 'Stage';\n            if (!config.editorPlaceMode) config.editorPlaceMode = false;\n            if (!config.editorSelectedStage) config.editorSelectedStage = -1;\n\n            function renderPanel() {\n                const page = config.editorPage;\n                const pageOpts = [{value:'ObjectPage',label:'ObjectPage'},{value:'ScenePage',label:'ScenePage'}];\n                const pageParam = { key:'editorPage', type:'dropdown', options:pageOpts,\n                    onChange: v => { config.editorPage = v; renderPanel(); } };\n\n                if (page === 'ObjectPage') {\n                    lib.showGameParameters({ name: 'Object Page', params: {\n                        'Page': pageParam,\n                        'Object Type':  { key:'editorObjType', type:'dropdown', options:[{value:'Stage',label:'Stage'}] },\n                        'Stage ID':        { key:'gameConfig.prefabs.Stage.stageId',        type:'number' },\n                        'Platform Width':  { key:'gameConfig.prefabs.Stage.platformWidth',  type:'number' },\n                        'Platform Height': { key:'gameConfig.prefabs.Stage.platformHeight', type:'number' },\n                        'Platform Length': { key:'gameConfig.prefabs.Stage.platformLength', type:'number' },\n                        'Track Bed Width': { key:'gameConfig.prefabs.Stage.trackBedWidth', type:'number' },\n                        'Stripe Inset':    { key:'gameConfig.prefabs.Stage.stripeInset',    type:'number' },\n                        'Canopy Type':     { key:'gameConfig.prefabs.Stage.canopyType', type:'dropdown',\n                            options:[{value:'full',label:'full'},{value:'left',label:'left'},{value:'right',label:'right'},{value:'none',label:'none'}] },\n                    }});\n                } else {\n                    const selStageId = config.editorSelectedStage ?? -1;\n                    const stages     = config.worldStages || [];\n                    const splines    = Array.isArray(config.splines) ? config.splines : [];\n\n                    // Build Stages list HTML\n                    let stagesHtml = '<div style=\"margin-bottom:6px;font-size:11px;color:#a080c0;text-transform:uppercase;letter-spacing:1px;\">Stages</div>';\n                    if (stages.length === 0) {\n                        stagesHtml += '<div style=\"color:rgba(255,255,255,0.35);font-size:12px;padding:4px 0;\">No stages</div>';\n                    } else {\n                        stages.forEach(ws => {\n                            const isSel = ws.stageId === selStageId && selectedType === 'stage';\n                            stagesHtml += `<div data-action=\"stage\" data-value=\"${ws.stageId}\" style=\"\n                                padding:5px 8px;border-radius:5px;cursor:pointer;font-size:13px;\n                                background:${isSel ? 'rgba(255,215,64,0.25)' : 'rgba(255,255,255,0.06)'};\n                                border:1px solid ${isSel ? '#ffd740' : 'transparent'};\n                                color:${isSel ? '#ffd740' : '#e0d0f0'};margin-bottom:3px;\n                                user-select:none;\">\n                                Stage ${ws.stageId}\n                            </div>`;\n                        });\n                    }\n\n                    // Build Points list HTML\n                    let pointsHtml = '<div style=\"margin-top:12px;margin-bottom:6px;font-size:11px;color:#a080c0;text-transform:uppercase;letter-spacing:1px;\">Spline Points</div>';\n                    if (splines.length === 0) {\n                        pointsHtml += '<div style=\"color:rgba(255,255,255,0.35);font-size:12px;padding:4px 0;\">No splines</div>';\n                    } else {\n                        splines.forEach((sp, si) => {\n                            pointsHtml += `<div style=\"margin-bottom:6px;\">`;\n                            pointsHtml += `<div style=\"font-size:12px;color:#80a0e0;margin-bottom:2px;\">Spline ${si}</div>`;\n                            (sp.points || []).forEach((p, pi) => {\n                                const isSel = selectedType === 'point' && selectedPoint &&\n                                    selectedPoint.splineIdx === si && selectedPoint.ptIdx === pi;\n                                pointsHtml += `<div data-action=\"point\" data-value=\"${si},${pi}\" style=\"\n                                    padding:4px 8px 4px 16px;border-radius:5px;cursor:pointer;font-size:12px;\n                                    background:${isSel ? 'rgba(0,207,255,0.2)' : 'rgba(255,255,255,0.04)'};\n                                    border:1px solid ${isSel ? '#00cfff' : 'transparent'};\n                                    color:${isSel ? '#00cfff' : '#c0c8d8'};margin-bottom:2px;\n                                    user-select:none;\">\n                                    P${pi} &nbsp;<span style=\"opacity:0.5;font-size:11px;\">(${p.x.toFixed(1)}, ${p.y.toFixed(1)}, ${p.z.toFixed(1)})</span>\n                                </div>`;\n                            });\n                            pointsHtml += '</div>';\n                        });\n                    }\n\n                    lib.showGameParameters({ name: 'Scene Page', params: {\n                        'Page': pageParam,\n                        'Place Mode': { key:'gameConfig.editorPlaceMode', type:'toggle',\n                            onChange: (v) => { if (v) config.editorSelectedStage = -1; renderPanel(); } },\n                        '_stages': {\n                            key: '_sceneList',\n                            type: 'html',\n                            html: stagesHtml + pointsHtml,\n                            onClick: (action, value) => {\n                                if (action === 'stage') {\n                                    selectStage(parseInt(value));\n                                } else if (action === 'point') {\n                                    const [si, pi] = value.split(',').map(Number);\n                                    selectPoint(si, pi);\n                                }\n                            },\n                            onDblClick: (action, value) => {\n                                if (action === 'stage') {\n                                    const sid = parseInt(value);\n                                    const ws = stages.find(s => s.stageId === sid);\n                                    if (ws) flyToPosition(new THREE.Vector3(...ws.position));\n                                } else if (action === 'point') {\n                                    const [si, pi] = value.split(',').map(Number);\n                                    const sphere = pointSpheres.find(s => s.splineIdx === si && s.ptIdx === pi);\n                                    if (sphere) flyToPosition(sphere.worldPos);\n                                }\n                            },\n                        },\n                    }});\n                }\n            }\n            config._renderPanel = renderPanel;\n            renderPanel();\n        }\n\n        function updateStartScreen() {\n            if (!checkpointDisplayEl) return;\n            checkpointDisplayEl.textContent = '';\n            const startBtn = startScreenEl?.querySelector('#btn-start');\n            if (startBtn) startBtn.textContent = 'START RIDE';\n            // Hide NEW GAME when player has no saved progress (first time)\n            const newGameBtn = startScreenEl?.querySelector('#btn-new-game');\n            if (newGameBtn) newGameBtn.style.display = completedStages > 0 ? '' : 'none';\n        }\n\n        let _prevProgressStageIdx = -1;\n\n        function updateUI() {\n            if (timerEl) timerEl.textContent=formatTime(elapsedTime);\n            if (speedEl) speedEl.textContent=Math.round(speed*3.6);\n\n            // Vertical stage progress bar\n            if (progressFillEl && trackStages.length > 0) {\n                const totalStages = trackStages.length;\n                let curStageIdx = 0;\n                for (let i = 0; i < totalStages; i++) {\n                    if (trackProgress >= (trackStages[i].tStart ?? trackStages[i].t)) curStageIdx = i;\n                }\n                const segStart = trackStages[curStageIdx].tStart ?? trackStages[curStageIdx].t;\n                const segEnd = (curStageIdx + 1 < totalStages)\n                    ? (trackStages[curStageIdx + 1].tStart ?? trackStages[curStageIdx + 1].t)\n                    : 1.0;\n                const segLen = Math.max(0.001, segEnd - segStart);\n                const segProgress = Math.max(0, Math.min(1, (trackProgress - segStart) / segLen));\n\n                progressFillEl.style.height = (segProgress * 100).toFixed(1) + '%';\n\n                const carEl = document.getElementById('sp-car');\n                if (carEl) carEl.style.bottom = (segProgress * 100).toFixed(1) + '%';\n\n                const labelEl = document.getElementById('sp-label');\n                if (labelEl) {\n                    labelEl.textContent = `${curStageIdx + 1} / ${totalStages}`;\n                    // Trigger level-up animation on stage change\n                    if (curStageIdx !== _prevProgressStageIdx && _prevProgressStageIdx >= 0) {\n                        labelEl.classList.remove('level-up');\n                        void labelEl.offsetWidth; // force reflow to restart animation\n                        labelEl.classList.add('level-up');\n                        labelEl.addEventListener('animationend', () => {\n                            labelEl.classList.remove('level-up');\n                        }, { once: true });\n                    }\n                    _prevProgressStageIdx = curStageIdx;\n                }\n            }\n\n            if (stageEl) {\n                const totalStages = trackStages.length;\n                const currentStage = totalStages > 0\n                    ? Math.min(totalStages, completedStages + 1) : 1;\n                stageEl.textContent = totalStages > 0\n                    ? `STAGE ${currentStage} / ${totalStages}`\n                    : `${activeTrackName}`;\n            }\n        }\n\n        // ── CONFETTI BURST ────────────────────────────────────────────────\n        // Ribbon-style confetti that shoots from screen center outward.\n        // Each particle is a small rotating rectangle with a bright color.\n        const CONFETTI_COLORS = [\n            '#FF3E4D','#FF8C42','#FFD740','#69F0AE','#40C4FF',\n            '#E040FB','#FF4081','#00E5FF','#76FF03','#FFAB40',\n        ];\n        let confettiParticles = [];\n        let confettiAnimId = null;\n\n        function spawnConfetti(count = 40) {\n            const cvs = document.getElementById('confetti-canvas');\n            if (!cvs) return;\n            const dpr = Math.min(window.devicePixelRatio || 1, 1);\n            const W = cvs.width = cvs.clientWidth * dpr;\n            const H = cvs.height = cvs.clientHeight * dpr;\n            const ctx = cvs.getContext('2d');\n            const cx = W / 2, cy = H * 0.5;\n\n            for (let i = 0; i < count; i++) {\n                // Shoot left or right from center, with slight vertical spread\n                const side = (i % 2 === 0) ? -1 : 1;\n                const hSpeed = (6 + Math.random() * 10) * side * (W / 800);\n                const vSpeed = (Math.random() - 0.5) * 6 * (H / 800);\n                confettiParticles.push({\n                    x: cx, y: cy,\n                    vx: hSpeed,\n                    vy: vSpeed - (1 + Math.random() * 2),\n                    w: 12 + Math.random() * 14,\n                    h: 6 + Math.random() * 8,\n                    rot: Math.random() * Math.PI * 2,\n                    rotV: (Math.random() - 0.5) * 0.3,\n                    color: CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)],\n                    gravity: 0.14 + Math.random() * 0.08,\n                    drag: 0.98 + Math.random() * 0.01,\n                    alpha: 1,\n                    life: 50 + Math.floor(Math.random() * 30),\n                    age: 0,\n                });\n            }\n\n            if (!confettiAnimId) {\n                let lastT = performance.now();\n                function animateConfetti(now) {\n                    const dt60 = Math.min((now - lastT) / 16.67, 3); // normalize to ~60fps\n                    lastT = now;\n                    ctx.clearRect(0, 0, W, H);\n\n                    for (let i = confettiParticles.length - 1; i >= 0; i--) {\n                        const p = confettiParticles[i];\n                        p.age += dt60;\n                        if (p.age > p.life) { confettiParticles.splice(i, 1); continue; }\n\n                        p.vy += p.gravity * dt60;\n                        p.vx *= Math.pow(p.drag, dt60);\n                        p.vy *= Math.pow(p.drag, dt60);\n                        p.x += p.vx * dt60;\n                        p.y += p.vy * dt60;\n                        p.rot += p.rotV * dt60;\n\n                        // Fade out in last 30%\n                        const lifeRatio = p.age / p.life;\n                        p.alpha = lifeRatio > 0.7 ? 1 - (lifeRatio - 0.7) / 0.3 : 1;\n\n                        ctx.save();\n                        ctx.translate(p.x, p.y);\n                        ctx.rotate(p.rot);\n                        ctx.globalAlpha = p.alpha;\n                        ctx.fillStyle = p.color;\n                        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);\n                        ctx.restore();\n                    }\n\n                    if (confettiParticles.length > 0) {\n                        confettiAnimId = requestAnimationFrame(animateConfetti);\n                    } else {\n                        confettiAnimId = null;\n                        ctx.clearRect(0, 0, W, H);\n                    }\n                }\n                confettiAnimId = requestAnimationFrame(animateConfetti);\n            }\n        }\n\n        function showStageToast(stageNum) {\n            if (!stageToastEl) return;\n            const totalStages = trackStages.length;\n            const isFinal = (stageNum === totalStages);\n            const timeStr = formatTime(elapsedTime);\n\n            if (isFinal) {\n                stageToastEl.className = 'stage-toast final-stage';\n                stageToastEl.innerHTML =\n                    `<span class=\"toast-stage\">🏁 FINAL STAGE! 🏁</span>` +\n                    `<span class=\"toast-progress\">STAGE <span id=\"toast-num\">${stageNum}</span> / ${totalStages}</span>` +\n                    `<span class=\"toast-time\">⏱ ${timeStr}</span>`;\n            } else {\n                stageToastEl.className = 'stage-toast';\n                stageToastEl.innerHTML =\n                    `<span class=\"toast-stage\">STAGE <span id=\"toast-num\">${stageNum}</span> ✓</span>` +\n                    `<span class=\"toast-progress\">${stageNum} / ${totalStages} COMPLETE</span>` +\n                    `<span class=\"toast-time\">⏱ ${timeStr}</span>`;\n            }\n\n            stageToastEl.classList.add('show');\n            setTimeout(() => {\n                stageToastEl.classList.remove('show');\n                stageToastEl.className = 'stage-toast';\n            }, 2500);\n\n            // More confetti for later stages, huge burst for final\n            const confettiCount = isFinal ? 40 : Math.min(15 + stageNum * 2, 30);\n            spawnConfetti(confettiCount);\n\n            // ── Flying number animation: stage number flies to progress bar ──\n            flyNumberToProgress(stageNum);\n        }\n\n        function flyNumberToProgress(stageNum) {\n            const labelEl = document.getElementById('sp-label');\n            const numEl = document.getElementById('toast-num');\n            if (!labelEl || !numEl) return;\n\n            const overlayRect = uiOverlay.getBoundingClientRect();\n\n            // Get the number's current screen position from the toast\n            const numRect = numEl.getBoundingClientRect();\n            const startX = numRect.left - overlayRect.left + numRect.width / 2;\n            const startY = numRect.top - overlayRect.top + numRect.height / 2;\n            const startFontSize = parseFloat(window.getComputedStyle(numEl).fontSize);\n\n            // Get target position (the progress label)\n            const labelRect = labelEl.getBoundingClientRect();\n            const targetX = labelRect.left - overlayRect.left + labelRect.width / 2;\n            const targetY = labelRect.top - overlayRect.top + labelRect.height / 2;\n            const targetFontSize = parseFloat(window.getComputedStyle(labelEl).fontSize);\n\n            // Create a clone that flies — the original stays in the toast\n            const flyer = document.createElement('div');\n            flyer.textContent = stageNum;\n            flyer.style.cssText = `\n  