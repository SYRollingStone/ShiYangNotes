       // ── STARS (FIVE-POINTED) ────────────────────────────────────────\n        // Flat 5-pointed star, default ~3×3×0.5. Extruded from 10-vertex\n        // polygon (outer/inner radius alternating).\n        const STAR_OUTER_R = 1.5;\n        const STAR_INNER_R = 0.6;\n        const STAR_DEPTH   = 0.5;\n        const STAR_POINTS  = 5;\n\n        let _starGeo = null;\n        function getStarGeometry() {\n            if (_starGeo) return _starGeo;\n\n            const N = STAR_POINTS * 2; // 10 vertices\n            const verts = [];\n            for (let i = 0; i < N; i++) {\n                const a = -Math.PI/2 + (2*Math.PI*i)/N;\n                const r = (i % 2 === 0) ? STAR_OUTER_R : STAR_INNER_R;\n                verts.push([Math.cos(a)*r, Math.sin(a)*r]);\n            }\n\n            const halfD = STAR_DEPTH * 0.5;\n            // front fan + back fan + side quads\n            const triCount = N + N + N * 2;\n            const vCount = triCount * 3;\n            const pos = new Float32Array(vCount * 3);\n            const norm = new Float32Array(vCount * 3);\n            let vi = 0;\n\n            function pushV(px,py,pz, nx,ny,nz) {\n                const i3 = vi*3;\n                pos[i3]=px; pos[i3+1]=py; pos[i3+2]=pz;\n                norm[i3]=nx; norm[i3+1]=ny; norm[i3+2]=nz;\n                vi++;\n            }\n            function pushTri(a,b,c, nx,ny,nz) {\n                pushV(a[0],a[1],a[2],nx,ny,nz);\n                pushV(b[0],b[1],b[2],nx,ny,nz);\n                pushV(c[0],c[1],c[2],nx,ny,nz);\n            }\n\n            // Front (+Z)\n            for (let i = 0; i < N; i++) {\n                const j = (i+1) % N;\n                pushTri([0,0,halfD], [verts[i][0],verts[i][1],halfD],\n                        [verts[j][0],verts[j][1],halfD], 0,0,1);\n            }\n            // Back (-Z)\n            for (let i = 0; i < N; i++) {\n                const j = (i+1) % N;\n                pushTri([0,0,-halfD], [verts[j][0],verts[j][1],-ha